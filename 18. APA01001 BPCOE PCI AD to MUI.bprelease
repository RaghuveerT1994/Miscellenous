r" name="FieldToBeFiltered" expr="[FieldToBeFiltered]" /><input type="text" name="CriteriaToFilter" expr="[CriteriaToFilter]" /></inputs><onsuccess>8ddb30d8-2608-4f8f-b0ab-dc9b1e643ef3</onsuccess><code><![CDATA[Dim worksheet as Object
Worksheet = GetWorkbook(handle, Nothing). ActiveSheet
worksheet.UsedRange.AutoFilter (Field:= FieldToBeFiltered, Criteria1 := CriteriaToFilter)]]></code></stage><stage stageid="2a6b80c3-fa9d-4ee4-803f-18c804af6397" name="handle" type="Data"><subsheetid>a0d8b304-9137-4cda-89cf-fcedbaaeef4a</subsheetid><loginhibit /><display x="150" y="-90" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ad4bd724-8c26-4ba7-9f21-0b5026e0dc02" name="FieldToBeFiltered" type="Data"><subsheetid>a0d8b304-9137-4cda-89cf-fcedbaaeef4a</subsheetid><loginhibit /><display x="150" y="-45" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b3110af5-15fc-439e-be7b-982fe9b66b69" name="CriteriaToFilter" type="Data"><subsheetid>a0d8b304-9137-4cda-89cf-fcedbaaeef4a</subsheetid><loginhibit /><display x="150" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f84eb474-70a3-48f5-a39f-0c7ab6b6d632" name="Find" type="SubSheetInfo"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="bb115d01-cf56-471c-9266-970a60351633" name="Start" type="Start"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><loginhibit /><display x="0" y="-135" /><inputs><input type="number" name="handle" stage="handle" /><input type="text" name="workbookname" stage="workbookname" /><input type="text" name="worksheetname" stage="worksheetname" /><input type="text" name="range" stage="range" /><input type="text" name="TextToFind" stage="TextToFind" /></inputs><onsuccess>8f161152-8e76-4b3c-aa1f-8e6da360172c</onsuccess></stage><stage stageid="7766a766-c404-4838-93aa-d03f95c3d34a" name="End" type="End"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><loginhibit /><display x="0" y="45" /><outputs><output type="text" name="ExMessage" stage="ExMessage" /><output type="text" name="CellRef" stage="CellRef" /></outputs></stage><stage stageid="8f161152-8e76-4b3c-aa1f-8e6da360172c" name="Find" type="Code"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><loginhibit /><display x="0" y="-60" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="range" expr="[range]" /><input type="text" name="TextFind" expr="[TextToFind]" /></inputs><outputs><output type="text" name="CellRef" stage="CellRef" /><output type="text" name="ExMessage" stage="ExMessage" /></outputs><onsuccess>7766a766-c404-4838-93aa-d03f95c3d34a</onsuccess><code><![CDATA[
' enum - Excel.X1SearchDirection.x1Previous=2
Dim Ws as Object = Nothing
Dim rng as Object = Nothing
Dim CellReff As Object = Nothing
Try
Ws= GetWorksheet(handle,workbookname,worksheetname)
rng=Ws.Range(range)
CellReff=rng.Find(What:=TextFind, LookIn:=-4123,LookAt:= 1, SearchOrder:=1, SearchDirection:=1,MatchCase:=False,SearchFormat:=False)
CellRef=CellReff.Address.Replace("$","")
Catch Ex as Exception
ExMessage=Ex.Message
End Try]]></code></stage><stage stageid="0e9bc33c-3b44-47e1-b31f-48a04d18285b" name="CellRef" type="Data"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><display x="150" y="-90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cc9a0004-7fe7-4911-a920-509b98d1cdab" name="ExMessage" type="Data"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><display x="150" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e82a0b1b-70c8-45b4-bb9a-8fa70bab5889" name="handle" type="Data"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><display x="-165" y="15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c6fd2eaf-eafb-4fd6-b8e8-13738704a3f0" name="workbookname" type="Data"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><display x="-240" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="458b9793-2713-469e-9c10-f58dbddc2c6f" name="worksheetname" type="Data"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><display x="-240" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e2a5ae06-0911-446e-a8ab-b6cf824e47f8" name="range" type="Data"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><display x="-165" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3ed4aa60-f817-4bce-b628-fe85ea5914a9" name="TextToFind" type="Data"><subsheetid>7c4c630f-474c-4e91-a245-813c368a320f</subsheetid><display x="-240" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b219080b-61ff-4d6a-bd21-137b0f7eae1b" name="Write Collection" type="SubSheetInfo"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><narrative>Writes the given collection into the specified sheet.</narrative><display x="-195" y="-105" w="180" h="90" /></stage><stage stageid="868d7bfb-21c1-4324-ac8d-26da29efbe0a" name="Start" type="Start"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><loginhibit /><display x="45" y="-135" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the specified collection should be written. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook within which the data should be written. The default empty value indicates the current workbook within the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet on which the given data should be written. The default empty value indicates the current sheet within the specified workbook." stage="worksheetname" /><input type="text" name="Cell Reference" narrative="The reference at which the collection should be written." stage="cellref" /></inputs><onsuccess>60d4094d-4eeb-4975-8f0e-44551421be82</onsuccess></stage><stage stageid="5bc726ef-966d-46f4-bfbc-3a43f2614a4d" name="End" type="End"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><loginhibit /><display x="45" y="60" /></stage><stage stageid="37b45e4c-8d34-4ed8-b4a3-6e07054a7727" name="handle" type="Data"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><display x="-255" y="-30" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="31b962f2-4bd8-41a1-95b6-8a5a8d9904c1" name="worksheetname" type="Data"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><display x="-255" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c3b5d127-8779-48c2-94ff-1b12ffd4ef16" name="workbookname" type="Data"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><display x="-255" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="60d4094d-4eeb-4975-8f0e-44551421be82" name="Activate Worksheet" type="SubSheet"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><loginhibit /><display x="45" y="-75" w="120" h="30" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the worksheet which should be activated resides. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The name of the workbook in which the sheet exists - The default empty value indicates the currently active workbook on the specified instance." expr="[workbookname]" /><input type="text" name="Worksheet Name" narrative="The name of the sheet which should be activated. The default empty text value indicates that the currently active sheet should be, er, activated, making this a no-op." expr="[worksheetname]" /><input type="flag" name="Create If Missing?" narrative="True to create the sheet if it isn't present on the specified workbook; False to not do so." expr="False" /></inputs><onsuccess>55a84404-6cc0-4b22-b658-6fe33874432a</onsuccess><processid>733c2840-8162-465a-a8f2-7d023087c369</processid></stage><stage stageid="55a84404-6cc0-4b22-b658-6fe33874432a" name="Code23" type="Code"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><loginhibit /><display x="45" y="-15" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="cellref" expr="[cellref]" /></inputs><onsuccess>5bc726ef-966d-46f4-bfbc-3a43f2614a4d</onsuccess><code><![CDATA[' Get to the cell
Dim ws As Object = GetWorksheet(handle, workbookname, worksheetname)
Dim origin As Object = ws.Range(cellref, cellref)
origin.EntireColumn.Hidden = False

]]></code></stage><stage stageid="9384c2f0-18ab-4f9b-a6fb-c268566dba56" name="cellref" type="Data"><subsheetid>639ac1ad-b5c0-49b6-a9e8-17533360eb27</subsheetid><display x="-135" y="-30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6b1e3875-15a2-4fc2-97ee-f2eb022f3256" name="Save Workbook As CSV" type="SubSheetInfo"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><narrative>Save the given workbook using the given file name.

Params :
- handle : Number : The integer identifying the instance on which the workbook resides. Default (0) indicates the current instance
- Workbook Name : Text : The name of the workbook which should be saved. Default ("") indicates the active workbook.
- File name : Text : The path and name of the file to which the workbook should be saved.

Output :
- New Workbook Name : Text : The new name with which the workbook is identified within the excel instance.

Exceptions: 
- Bad Handle : If the given handle did not correspond to an instance.
- Workbook Not Found : If the given workbook did not exist on the specified instance.</narrative><display x="-285" y="-180" w="420" h="210" /></stage><stage stageid="1e2360d3-0c62-4088-bc84-6b4538465de1" name="End" type="End"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><loginhibit /><display x="15" y="60" /><outputs><output type="text" name="New Workbook Name" narrative="The new workbook name which Excel will use to identify the workbook within the instance." stage="newworkbookname" /></outputs></stage><stage stageid="1b6180fc-2ee8-420d-b7c2-f15ac7de6e6d" name="filename" type="Data"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><display x="-255" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3016c98c-e1b6-471a-9739-66214013ecab" name="handle" type="Data"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><display x="-255" y="-30" w="120" h="30" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="1983dfd8-a6ee-47ad-ae9b-a1b87f6dbd18" name="Start" type="Start"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><loginhibit /><display x="15" y="-135" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook which should be saved resides. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook which should be saved" stage="workbookname" /><input type="text" name="Filename" narrative="The full path and filename to which the workbook should be saved." stage="filename" /></inputs><onsuccess>f401e077-8a5c-4d37-89d1-4a272c0f6092</onsuccess></stage><stage stageid="1c2d81f6-75ba-40a6-a5f0-b081ae4ae716" name="workbookname" type="Data"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><display x="-255" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a07731be-cd20-42a3-bd49-01a35257d54f" name="SaveWorkbookAsCSV" type="Code"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="filename" expr="[filename]" /><input type="number" name="Timeout" expr="[Timeout]" /></inputs><outputs><output type="text" name="newworkbookname" stage="newworkbookname" /></outputs><onsuccess>1e2360d3-0c62-4088-bc84-6b4538465de1</onsuccess><code><![CDATA[newworkbookname = ExecWithTimeout(Timeout, "Save Workbook As",
Function()
    Dim wb as Object  = GetWorkbook(handle,workbookname)
    Dim excel as Object = wb.Application

    excel.DisplayAlerts = False
    wb.SaveAs(filename, 6)
    excel.DisplayAlerts = True

    Return wb.Name
End Function)]]></code></stage><stage stageid="f401e077-8a5c-4d37-89d1-4a272c0f6092" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><loginhibit /><display x="15" y="-75" w="150" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>a07731be-cd20-42a3-bd49-01a35257d54f</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="1df65147-a248-45c6-a7b1-8dacd1326413" name="newworkbookname" type="Data"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><narrative>The new workbook name assigned by Excel after saving the book</narrative><display x="-135" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8846267c-5617-4008-adc5-3b83cb34ae33" name="Timeout" type="Data"><subsheetid>3ac9c8ca-417a-4ec6-958a-d9c0eff2f153</subsheetid><display x="-255" y="105" w="120" h="30" /><datatype>number</datatype><initialvalue>30</initialvalue><private /><alwaysinit /></stage><stage stageid="1f5265cb-83da-4983-97ff-b473c9bfb2f3" name="Unhide Worksheet" type="SubSheetInfo"><subsheetid>baac7d33-bb6b-4062-b76a-e786136eae95</subsheetid><display x="-120" y="-135" w="150" h="90" /></stage><stage stageid="6f40236a-2c38-4c68-8ae2-57d165535462" name="Handle" type="Data"><subsheetid>baac7d33-bb6b-4062-b76a-e786136eae95</subsheetid><display x="105" y="-105" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6b93f761-c975-4832-82b8-83a68439e78a" name="Workbook" type="Data"><subsheetid>baac7d33-bb6b-4062-b76a-e786136eae95</subsheetid><display x="165" y="-105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bed401bb-a4b4-4dae-a906-dd36315d65eb" name="Worksheet" type="Data"><subsheetid>baac7d33-bb6b-4062-b76a-e786136eae95</subsheetid><display x="225" y="-105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="413ffcb9-b25a-4e74-ab86-40ff362921e7" name="Start" type="Start"><subsheetid>baac7d33-bb6b-4062-b76a-e786136eae95</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" stage="Handle" /><input type="text" name="Workbook" stage="Workbook" /><input type="text" name="Worksheet" stage="Worksheet" /></inputs><onsuccess>2af31162-b790-4445-acc6-f7b92e8a440b</onsuccess></stage><stage stageid="2af31162-b790-4445-acc6-f7b92e8a440b" name="Unhide Worksheet" type="Code"><subsheetid>baac7d33-bb6b-4062-b76a-e786136eae95</subsheetid><loginhibit /><display x="15" y="-45" w="90" h="30" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>5a77bd0c-7716-4946-8af6-cc4ddc09ee88</onsuccess><code><![CDATA[Dim ws As Object

Try

ws = GetWorkSheet(Handle, Workbook, Worksheet)
ws.Visible = True

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	ws = Nothing
