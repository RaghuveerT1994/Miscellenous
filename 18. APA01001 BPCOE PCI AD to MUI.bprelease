3-a328-4bca-b429-0dcfb71bc2ac</subsheetid><display x="60" y="-32730" w="90" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="fbb900fa-2a6e-47fe-8a7e-1039147b9324" name="Get Parent ID?" type="Decision"><subsheetid>50d0bfe3-a328-4bca-b429-0dcfb71bc2ac</subsheetid><loginhibit /><display x="-45" y="-31725" /><decision expression="[flg_GetParentFolderId]" /><ontrue>6cd9fd8c-9a0b-48ad-a4da-f8ef5f99fabe</ontrue><onfalse>7adc1ac0-e198-4ef6-b347-9bd0d2777755</onfalse></stage><stage stageid="7adc1ac0-e198-4ef6-b347-9bd0d2777755" name="Delete Field Parent ID" type="Action"><subsheetid>50d0bfe3-a328-4bca-b429-0dcfb71bc2ac</subsheetid><loginhibit onsuccess="true" /><display x="-135" y="-31725" /><inputs><input type="text" name="Field Name" friendlyname="Field Name" narrative="The field to delete." expr="&quot;Parent ID&quot;" /><input type="collection" name="Collection In" friendlyname="Collection In" narrative="The collection to delete the field from." expr="[col_FoldersOutput]" /></inputs><outputs><output type="collection" name="Collection Out" friendlyname="Collection Out" narrative="The collection with the field removed." stage="col_FoldersOutput" /></outputs><onsuccess>a2f7852a-628b-4964-b357-fd17ab509cf3</onsuccess><resource object="[R] Utility - Collection Manipulation" action="Delete Field" /></stage><stage stageid="a2f7852a-628b-4964-b357-fd17ab509cf3" name="Anchor24" type="Anchor"><subsheetid>50d0bfe3-a328-4bca-b429-0dcfb71bc2ac</subsheetid><loginhibit /><display x="-135" y="-31665" w="10" h="10" /><onsuccess>6cd9fd8c-9a0b-48ad-a4da-f8ef5f99fabe</onsuccess></stage><stage stageid="53ec0494-bbd4-44b9-b7a6-5591ce6cd622" name="Valid Mailbox Enterd" type="Decision"><subsheetid>4f0eb689-d4a7-4e7b-8ff9-e4d6a740925b</subsheetid><loginhibit /><display x="15" y="30" w="90" h="30" /><decision expression="[Contains Search Term]" /><ontrue>42f5867b-f96a-4a4f-98dd-3bfc1bc3ed16</ontrue><onfalse>9259d4f7-ac62-4f14-9095-26b8e1fbc51c</onfalse></stage><stage stageid="774459c6-9605-491c-9355-b8d95df0f4d3" name="Get List of Mailbox's" type="Action"><subsheetid>4f0eb689-d4a7-4e7b-8ff9-e4d6a740925b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-60" /><inputs><input type="text" name="CSV" friendlyname="CSV" narrative="The CSV to be converted into a collection" expr="[_R_Microsoft Graph API - Outlook Mailbox's]" /><input type="flag" name="First Row Is Header" friendlyname="First Row Is Header" narrative="Indicates whether the first row of the CSV file should be treated as headers" expr="True" /><input type="collection" name="Schema" friendlyname="Schema" narrative="Optional. A collection of column names. If left blank the column names will be taken from the first row. " expr="" /></inputs><outputs><output type="collection" name="Output Collection" friendlyname="Output Collection" narrative="The collection converted from CSV" stage="Mailboxs" /></outputs><onsuccess>ea4be802-ff66-4e33-822d-212a6de07b64</onsuccess><resource object="[R] Utility - Strings" action="Get CSV As Collection" /></stage><stage stageid="5420b4db-707e-49fa-b58a-b72e377cc3b0" name="Mailboxs" type="Collection"><subsheetid>4f0eb689-d4a7-4e7b-8ff9-e4d6a740925b</subsheetid><display x="-135" y="180" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="89d28b02-5814-4cbd-b477-6ccc8a23a279" name="_R_Microsoft Graph API - Outlook Mailbox's" type="Data"><subsheetid>4f0eb689-d4a7-4e7b-8ff9-e4d6a740925b</subsheetid><loginhibit /><display x="-135" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><exposure>Environment</exposure><private /><alwaysinit /></stage><stage stageid="ea4be802-ff66-4e33-822d-212a6de07b64" name="Input in Collection?" type="Action"><subsheetid>4f0eb689-d4a7-4e7b-8ff9-e4d6a740925b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-15" /><inputs><input type="collection" name="Collection" friendlyname="Collection" narrative="Required : The collection to search" expr="[Mailboxs]" /><input type="text" name="Column Name" friendlyname="Column Name" narrative="Required : The name of the column to search" expr="&quot;Mailbox Name&quot;" /><input type="text" name="Exact Value" friendlyname="Exact Value" narrative="Optional : The exact value to search for - this is case insensitive" expr="[txt_Mailbox]" /><input type="text" name="Regex" friendlyname="Regex" narrative="Optional : The regular expression to search for - this is case sensitive unless specified otherwise in the regular expression using &quot;(?i)&quot;" expr="" /></inputs><outputs><output type="flag" name="Contains Search Term" friendlyname="Contains Search Term" narrative="Flag indicating if the collection found the given search term or not" stage="Contains Search Term" /><output type="collection" name="Groups" friendlyname="Groups" narrative="The groups defined in the regular expression when it is applied to the found term" stage="" /></outputs><onsuccess>53ec0494-bbd4-44b9-b7a6-5591ce6cd622</onsuccess><resource object="[R] Utility - Collection Manipulation" action="Collection Contains Value" /></stage><stage stageid="a46c1994-544d-4198-8d79-7706b8ad1817" name="Contains Search Term" type="Data"><subsheetid>4f0eb689-d4a7-4e7b-8ff9-e4d6a740925b</subsheetid><display x="-135" y="225" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9259d4f7-ac62-4f14-9095-26b8e1fbc51c" name="Not valid Mailbox" type="Exception"><subsheetid>4f0eb689-d4a7-4e7b-8ff9-e4d6a740925b</subsheetid><display x="150" y="30" w="120" h="30" /><exception localized="yes" type="Invalid Input Parameter" detail="&quot;An invalid Mailbax was entered&quot;" /></stage><stage stageid="7b1a6404-a99e-4f78-806c-2d2fc67d91e0" name="LowerCase ShowOnlyUnreadMessages" type="Calculation"><subsheetid>d59b7bb4-e4c3-43a3-bfed-f3e7d08d6165</subsheetid><loginhibit /><display x="-45" y="-32550" /><onsuccess>b8e0a523-5464-4093-9ec2-