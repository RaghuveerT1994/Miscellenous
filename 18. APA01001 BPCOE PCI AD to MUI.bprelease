&lt;/html&gt;</initialvalue><private /><alwaysinit /></stage><stage stageid="a0b34c2e-b4e1-44d3-ae43-c27995ff592f" name="asddsa" type="Data"><subsheetid>adb15a93-9d77-4cb6-b8a9-93790c022bda</subsheetid><display x="-60" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a0b201f3-c0da-4583-9e87-04b2e482d408" name="Mail GUID" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-150" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e4b2f859-ed67-4319-afbb-5f89bc30af3d" name="Get Mail using GUID" type="SubSheetInfo"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="e0325269-888a-4a0a-9c71-fb19fdd7f287" name="Start" type="Start"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="GUID" stage="GUID" /><input type="text" name="Attachment Directory" stage="Attachment Directory" /></inputs><onsuccess>c459b20b-f449-440c-91ad-470dea5dd39d</onsuccess></stage><stage stageid="c4449962-6d12-474f-bd47-e451181cd606" name="GUID" type="Data"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-195" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fdbee311-d36b-4a85-9abe-f4f93199b22b" name="Subject" type="Data"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-210" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c7a2b664-a402-4ecc-ba7f-89f31d4b682d" name="Message Body" type="Data"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-135" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f36c586d-1ed0-4c6c-a998-e6a918284db0" name="Attachment Names" type="Data"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-210" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f23221e1-b55d-484b-9450-d2481c1a4aa3" name="ID" type="Data"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-135" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="83ee4c9e-db43-47ee-a797-44c40ec55075" name="Success" type="Data"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-210" y="225" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1fd78724-84db-4a86-a6c8-ff0ae84b1960" name="Error Message" type="Data"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-135" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b39438eb-8736-4394-93f0-5fdd977f1ea5" name="Output Data Item" type="Block"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-255" y="75" w="165" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c459b20b-f449-440c-91ad-470dea5dd39d" name="isConfigured" type="Decision"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>a6970ea3-d46d-4c5f-86cf-467ae6e4d94a</ontrue><onfalse>00e943b8-c605-45d8-a905-2b6fb95cc70d</onfalse></stage><stage stageid="00e943b8-c605-45d8-a905-2b6fb95cc70d" name="Not configured" type="Exception"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="135" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="a6970ea3-d46d-4c5f-86cf-467ae6e4d94a" name="GetMail Code1" type="Code"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><loginhibit /><display x="15" y="60" /><inputs><input type="text" name="Attachment Directory" expr="[Attachment Directory]" /><input type="text" name="[GUID]" expr="[GUID]" /></inputs><outputs><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs><onsuccess>51a7cff2-5314-4a2a-893c-4de922cbba82</onsuccess><code><![CDATA[
ID="";
Subject="";
Message_Body="";
Attachment_Names="";
Error_Message="";
bool mail_exists=false;

try{
	
const int ONE_EMAIL = 1;

InitExchangeService(); 

Success=false;

Guid myPropertySetId = new Guid("{20B5C09F-7CAD-44c6-BDBF-8FCBEEA08544}"); 
ExtendedPropertyDefinition myExtendedPropertyDefinition = new ExtendedPropertyDefinition(myPropertySetId, "MyExtendedPropertyName", MapiPropertyType.String); 

ItemView view = new ItemView(ONE_EMAIL);
SearchFilter searchFilter = new SearchFilter.IsEqualTo(myExtendedPropertyDefinition, __GUID_); 
view.PropertySet = new PropertySet(BasePropertySet.IdOnly, ItemSchema.Subject, myExtendedPropertyDefinition); 

//view.OrderBy.Add(ItemSchema.DateTimeReceived, SortDirection.Descending);

FindItemsResults<Item> findResults = service.FindItems(WellKnownFolderName.SentItems, searchFilter, view); 

PropertySet itempropertyset = new PropertySet(BasePropertySet.FirstClassProperties);
itempropertyset.RequestedBodyType = BodyType.Text;
ItemView itemview = new ItemView(1000);
itemview.PropertySet = itempropertyset;
	
	
 if (findResults.Items.Count.Equals(ONE_EMAIL))
  {	 
	
	
	  foreach(Item i in findResults){

	
		  mail_exists=true;
      EmailMessage mes = (EmailMessage)i;


	 // foreach (NameResolution nameRes in resolvedNames)
	//	{
	//		Sender_Email_Address=nameRes.Mailbox.Address;
	//		break;
	//	}

	  //Sender_Email_Address=mes.From.Address;
	  Subject=i.Subject;
	  i.Load(itempropertyset);
	  Message_Body=i.Body;
	  Attachment_Names="";
	  ID=i.Id.ToString();
	
	  EmailMessage attach_mes = EmailMessage.Bind(service, ID, new PropertySet(ItemSchema.Attachments));

	  int index=0;
		foreach (Attachment attachment in attach_mes.Attachments)
		{
			
			if (attachment is FileAttachment)
			{
				FileAttachment fileAttachment = attachment as FileAttachment;

				if(index==0)
				{
					Attachment_Names=fileAttachment.Name;
				}else{
					Attachment_Names=Attachment_Names+";"+fileAttachment.Name;
				}
			
				
				  fileAttachment.Load(Attachment_Directory+"\\" + fileAttachment.Name);
                index=index+1;
			  
			}
			else // Attachment is an item attachment.
			{
				ItemAttachment itemAttachment = attachment as ItemAttachment;

				// Load attachment into memory and write out the subject.
				// This does not save the file like it does with a file attachment.
				// This call results in a GetAttachment call to EWS.
				itemAttachment.Load();
			}
		}


	  }
	  
	  
	  if(mail_exists){
		Success=true;
		Error_Message="";
	  }
	  else
	  {
		  Success=false;
		Error_Message="Unable to get Mail. Mail folder is empty";
	  }
 
  }else{
	  Error_Message =" no mail found";
  }
}catch(Exception ex)
{
	Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="f2032da0-ee73-417b-9867-09811549ce39" name="Input Data Item" type="Block"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-255" y="-30" w="165" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="606d2ef0-3feb-4032-a842-06bc67459017" name="Attachment Directory" type="Data"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><display x="-135" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="51a7cff2-5314-4a2a-893c-4de922cbba82" name="End" type="End"><subsheetid>0db4bff1-2f0e-4244-aa12-165b91844eff</subsheetid><loginhibit /><display x="15" y="135" /><outputs><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="388fda92-ec85-43da-8cba-2534b8e976e4" name="Configure" type="SubSheet"><subsheetid>adb15a93-9d77-4cb6-b8a9-93790c022bda</subsheetid><loginhibit /><display x="-60" y="-45" /><inputs><input type="flag" name="UseWindowsCredentials" narrative="Use Windows credentials of currently logged on user instead of providing separate credentials" expr="[UseWindowsCredentials]" /><input type="text" name="Username" narrative="The username to authenticate with Exchange " expr="[Username]" /><input type="password" name="Password" narrative="The password to authenticate with Exchange " expr="[Password]" /></inputs><onsuccess>a0288c90-5b18-467f-a17e-a5f2eb36441c</onsuccess><processid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</processid></stage><stage stageid="1e91836c-6d38-4734-a6c3-9c1f8d7c0732" name="Username" type="Data"><subsheetid>adb15a93-9d77-4cb6-b8a9-93790c022bda</subsheetid><display x="375" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">611585224</initialvalue><private /><alwaysinit /></stage><stage stageid="cf7dd47b-cafc-4c5c-8acb-4335f063a049" name="Password" type="Data"><subsheetid>adb15a93-9d77-4cb6-b8a9-93790c022bda</subsheetid><display x="375" y="165" w="120" h="30" /><datatype>password</datatype><initialvalueenc>17,20,7,67,26,91,6,1,30,29,21,67,50,86,17,0,47,42,23,88,12,90,19,0,37,42,70,1</initialvalueenc><private /><alwaysinit /></stage><stage stageid="08fe5076-43d7-4f9d-ab61-792e4373d71b" name="UseWindowsCredentials" type="Data"><subsheetid>adb15a93-9d77-4cb6-b8a9-93790c022bda</subsheetid><display x="375" y="60" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="178794c7-84d2-4e6c-bc04-f40d4602c572" name="Get Mail" type="SubSheetInfo"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f1a11023-f554-4f44-b7b0-30260ec15631" name="Start" type="Start"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Attachment Directory" stage="Attachment Directory" /><input type="text" name="Mail ID" stage="Mail ID" /></inputs><onsuccess>d92d5d54-4ccc-4a12-b749-0f7f3e232e9c</onsuccess></stage><stage stageid="bf8aa376-4755-4ff7-85fe-1e0dfea20aba" name="End" type="End"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><loginhibit /><display x="15" y="150" /><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="d92d5d54-4ccc-4a12-b749-0f7f3e232e9c" name="isConfigured" type="Decision"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>20609883-54b2-4423-89f4-6a6352f3590c</ontrue><onfalse>e0351188-a376-4608-9bad-a8e3bf64e123</onfalse></stage><stage stageid="e0351188-a376-4608-9bad-a8e3bf64e123" name="Not configured" type="Exception"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="135" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="20609883-54b2-4423-89f4-6a6352f3590c" name="GetMail using ID" type="Code"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><loginhibit /><display x="15" y="60" /><inputs><input type="text" name="Attachment Directory" expr="[Attachment Directory]" /><input type="text" name="Mail ID" expr="[Mail ID]" /></inputs><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs><onsuccess>bf8aa376-4755-4ff7-85fe-1e0dfea20aba</onsuccess><code><![CDATA[
ID="";
Sender_Name="";
Sender_Email_Address="";
Subject="";
Message_Body="";
Attachment_Names="";
Error_Message="";
bool mail_exists=false;

try{
 InitExchangeService(); 
 Success=false;

const int ONE_EMAIL = 1;

PropertySet propSet = new PropertySet(BasePropertySet.FirstClassProperties, ItemSchema.Subject,ItemSchema.Body, ItemSchema.DateTimeReceived, EmailMessageSchema.From, EmailMessageSchema.ToRecipients);
propSet.RequestedBodyType = BodyType.Text;
 
EmailMessage mes = EmailMessage.Bind(service, new ItemId(Mail_ID),propSet);

mail_exists=true;
 //Sender_Name=mes.From.Name;
 Sender_Name=mes.From.Name;
 NameResolutionCollection resolvedNames=service.ResolveName(mes.Sender.Address);

 foreach (NameResolution nameRes in resolvedNames)
 {
   Sender_Email_Address=nameRes.Mailbox.Address;
   break;
 }
		  
 //Sender_Email_Address=mes.From.Address;
 Subject=mes.Subject;
 Message_Body=mes.Body;
 Attachment_Names="";
 ID=mes.Id.ToString();
	  	
 EmailMessage attach_mes = EmailMessage.Bind(service, ID, new PropertySet(ItemSchema.Attachments));
 int index=0;

 foreach (Attachment attachment in attach_mes.Attachments)
 {		
  if (attachment is FileAttachment)
  {
	FileAttachment fileAttachment = attachment as FileAttachment;
	
    if(index==0)
	{
		Attachment_Names=fileAttachment.Name;
	}else{
		Attachment_Names=Attachment_Names+";"+fileAttachment.Name;
	}
			
	fileAttachment.Load(Attachment_Directory+"\\" + fileAttachment.Name);
	index=index+1;
  }
  else // Attachment is an item attachment.
  {
	ItemAttachment itemAttachment = attachment as ItemAttachment;

	// Load attachment into memory and write out the subject.
	// This does not save the file like it does with a file attachment.
	// This call results in a GetAttachment call to EWS.
	itemAttachment.Load();
  }
 }    
 if(mail_exists){
  Success=true;
  Error_Message="";
 }
 else
 {
  Success=false;
  Error_Message="Unable to get Mail. Mail folder is empty";
 } 
}catch(Exception ex)
{
  Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="583f8cdb-e629-4df1-bb52-3ece75414324" name="Sub-Folder" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="83db0e49-fcb9-45f8-aa84-f9374d6529aa" name="Attachment Directory" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="399eda3f-ad6e-41b2-ab66-9084bacc88a8" name="Sender Name" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-225" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f5f9c66a-03a7-4f07-a28f-8aa02d394d28" name="Sender Email Address" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-150" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5047c3d7-e792-44f6-9fe9-31372e0d1d66" name="Subject" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-225" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5503b893-dd45-42a2-8d0d-e16da163edb8" name="Message Body" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-150" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="82edcaac-aefe-4495-bda0-b56b8a886f09" name="Attachment Names" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-225" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8b00b8ec-c356-405b-b228-aabfaa7d5832" name="ID" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-150" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e3acbee-7c00-4271-9571-96913a30a6dc" name="Success" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-225" y="315" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7630b5a0-18c2-45e9-a0a5-7eaecbd3167a" name="Error Message" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-150" y="315" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4525c646-dc82-488d-96eb-53a4dc6174c7" name="Input Data Item" type="Block"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-270" y="-30" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e2d7ca5a-a562-478b-94b8-ed5724f9145e" name="Output Data Item" type="Block"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><display x="-270" y="105" w="165" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7ebc4738-23fb-4b65-8cde-b524cdff6658" name="Mail ID" type="Data"><subsheetid>a7b1d66d-9d38-4f5d-a4f7-e3e5815a6039</subsheetid><loginhibit /><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="32594d95-46a1-4793-84e4-9f3116db97a7" name="Get Mail from Shared Folder" type="SubSheetInfo"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="503b419c-5ef0-4d5b-bf56-a7be04a79f22" name="Start" type="Start"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Sub-Folder" stage="Sub-Folder" /><input type="text" name="Attachment Directory" stage="Attachment Directory" /><input type="text" name="Shared Folder Email ID" stage="Shared Folder Email ID" /></inputs><onsuccess>14dcea07-244c-4ee4-a7aa-fd898efe2a78</onsuccess></stage><stage stageid="14dcea07-244c-4ee4-a7aa-fd898efe2a78" name="isConfigured" type="Decision"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>e8eee248-24ac-4edd-8578-2412f3c73f9b</ontrue><onfalse>b1701e50-2a16-4df4-a8af-cfb43e15f5c5</onfalse></stage><stage stageid="b1701e50-2a16-4df4-a8af-cfb43e15f5c5" name="Not configured" type="Exception"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="135" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="e8eee248-24ac-4edd-8578-2412f3c73f9b" name="Get Mail from Shared Folder" type="Code"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><loginhibit /><display x="15" y="60" /><inputs><input type="text" name="Sub-Folder" expr="[Sub-Folder]" /><input type="text" name="Attachment Directory" expr="[Attachment Directory]" /><input type="text" name="Shared Folder Email ID" expr="[Shared Folder Email ID]" /></inputs><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs><onsuccess>8263a7b7-4940-45a8-8b2d-344c022e9cb2</onsuccess><code><![CDATA[
ID="";
Sender_Name="";
Sender_Email_Address="";
Subject="";
Message_Body="";
Attachment_Names="";
Error_Message="";
bool mail_exists=false;

try{
	
const int ONE_EMAIL = 1;

InitExchangeService(); 

Success=false;

ItemView view = new ItemView(ONE_EMAIL);
view.OrderBy.Add(ItemSchema.DateTimeReceived, SortDirection.Descending);





FolderView view1 = new FolderView(100);
view1.PropertySet = new PropertySet(BasePropertySet.IdOnly);
view1.PropertySet.Add(FolderSchema.DisplayName);
view1.Traversal = FolderTraversal.Deep;
			
Mailbox mailbox = new Mailbox(Shared_Folder_Email_ID);
FindFoldersResults findFolderResults = service.FindFolders(new FolderId(WellKnownFolderName.MsgFolderRoot, mailbox), view1);

Folder Folder_to_Search=null;

foreach (Folder f in findFolderResults)
{
	
	if (String.IsNullOrWhiteSpace(Sub_Folder))
	{
		if(f.DisplayName.Equals("inbox", StringComparison.OrdinalIgnoreCase))
		{
			Folder_to_Search=f;
		}
	}
	else {
		if(f.DisplayName.Equals(Sub_Folder, StringComparison.OrdinalIgnoreCase))
		{
			Folder_to_Search=f;
		}
	}
}		       

if (Folder_to_Search.Id == null) {
		throw new Exception("Foldername invalid. Please provide a valid mail folder to search in.");
}

var findResults= service.FindItems(Folder_to_Search.Id,view);

PropertySet itempropertyset = new PropertySet(BasePropertySet.FirstClassProperties);
itempropertyset.RequestedBodyType = BodyType.Text;
ItemView itemview = new ItemView(1000);
itemview.PropertySet = itempropertyset;

 if (findResults.Items.Count.Equals(ONE_EMAIL))
  {	 
	  foreach(Item i in findResults){
		  mail_exists=true;
      EmailMessage mes = (EmailMessage)i;
	  
	  //Sender_Name=mes.From.Name;
	  Sender_Name=mes.From.Name;
	  
	  NameResolutionCollection resolvedNames=service.ResolveName(mes.Sender.Address);

	  foreach (NameResolution nameRes in resolvedNames)
		{
			Sender_Email_Address=nameRes.Mailbox.Address;
			break;
		}
	
	  
	  //Sender_Email_Address=mes.From.Address;
	  Subject=i.Subject;
	  i.Load(itempropertyset);
	  Message_Body=i.Body;
	  Attachment_Names="";
	  ID=i.Id.ToString();
	  
	
	  EmailMessage attach_mes = EmailMessage.Bind(service, ID, new PropertySet(ItemSchema.Attachments));

	  int index=0;
		foreach (Attachment attachment in attach_mes.Attachments)
		{
			
			if (attachment is FileAttachment)
			{
				FileAttachment fileAttachment = attachment as FileAttachment;

				if(index==0)
				{
					Attachment_Names=fileAttachment.Name;
				}else{
					Attachment_Names=Attachment_Names+";"+fileAttachment.Name;
				}
			
				
				  fileAttachment.Load(Attachment_Directory+"\\" + fileAttachment.Name);

			  
			}
			else // Attachment is an item attachment.
			{
				ItemAttachment itemAttachment = attachment as ItemAttachment;

				// Load attachment into memory and write out the subject.
				// This does not save the file like it does with a file attachment.
				// This call results in a GetAttachment call to EWS.
				itemAttachment.Load();
			}
		}


	  }
	  
	  
	  if(mail_exists){
		Success=true;
		Error_Message="";
	  }
	  else
	  {
		  Success=false;
		Error_Message="Unable to get Mail. Mail folder is empty";
	  }
 
  }
}catch(Exception ex)
{
	Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="34d5c8fd-74f1-4e64-88c2-4d0fa2a764e7" name="Sub-Folder" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3985a917-15ec-4a81-8a9e-6a743c3577cf" name="Attachment Directory" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2e405979-d10f-4da7-9828-75a8ea45cbf2" name="Input Data Item" type="Block"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-270" y="-30" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="aded5fb4-da6c-4d7b-b3a8-43fdcfb0555d" name="Sender Name" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-225" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e7cfcb07-8a87-46da-85b9-b3834d03d9b8" name="Sender Email Address" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-150" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3cbc3de0-a3ed-4035-8950-d4e973c5e24f" name="Subject" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-225" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4515bc65-3633-4917-980d-327fa8b743c5" name="Message Body" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-150" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="051336b7-0d4f-407d-bc15-ec0ff5fd9566" name="Attachment Names" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-225" y="285" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3ca25f1e-1b2b-4ab6-a845-45c7dc9d4506" name="ID" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-150" y="285" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="284d3a3f-05e9-4584-a026-861d873894a0" name="Success" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-225" y="330" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="16cbdc79-ac84-45eb-b88a-c6beb364da6a" name="Error Message" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-150" y="330" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="00aa6098-3ca0-4ba5-90e4-d7d23881b10a" name="Output Data Item" type="Block"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-270" y="120" w="165" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4270c45d-0ca2-46d1-b582-1908426123b1" name="List Mails from Within DateTimes (Shared Folder)" type="SubSheetInfo"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8ed1d27a-e925-4bab-8f31-46c0984ce8ba" name="Start" type="Start"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Unread Only?" stage="Unread Only?" /><input type="text" name="Sub-Folder" stage="Sub-Folder" /><input type="text" name="Shared Folder Email ID" stage="Shared Folder Email ID" /></inputs><onsuccess>2ad5631a-8013-4819-816f-e37d1f3ced39</onsuccess></stage><stage stageid="76598506-a577-4310-afc8-e0c87cc9d39c" name="Shared Folder Email ID" type="Data"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2ad5631a-8013-4819-816f-e37d1f3ced39" name="List Mail from Within DateTimes (Shared Folder)" type="Code"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><inputs><input type="flag" name="Unread Only?" expr="[Unread Only?]" /><input type="text" name="Sub-Folder" expr="[Sub-Folder]" /><input type="text" name="Shared_Folder_Email_ID" expr="[Shared Folder Email ID]" /></inputs><outputs><output type="text" name="Error Message" stage="Error Message" /><output type="collection" name="IDs" stage="IDs" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>1085ab0e-f02e-41f2-b658-7c0f4e0e155b</onsuccess><code><![CDATA[InitExchangeService();
IDs = new DataTable();
int IDs_count;

try{
	
const int ONE_EMAIL = 1;

InitExchangeService(); 

Success=false;
ItemView view = new ItemView(int.MaxValue);
view.OrderBy.Add(ItemSchema.DateTimeReceived, SortDirection.Descending);
view.PropertySet = new PropertySet(BasePropertySet.IdOnly, EmailMessageSchema.Subject, EmailMessageSchema.From, EmailMessageSchema.DateTimeSent);
// Fire the query for the unread items.
// This method call results in a FindItem call to EWS.


SearchFilter unreadsf = new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false);
FolderView view1 = new FolderView(100);
view1.PropertySet = new PropertySet(BasePropertySet.IdOnly);
view1.PropertySet.Add(FolderSchema.DisplayName);
view1.Traversal = FolderTraversal.Deep;	
Mailbox mailbox = new Mailbox(Shared_Folder_Email_ID);
FolderId fID = new FolderId(WellKnownFolderName.Inbox, mailbox);
FindFoldersResults findFolderResults = service.FindFolders(fID, view1);
Folder Folder_to_Search=null;
FolderId Folder_to_Search_id = null;
if(String.IsNullOrWhiteSpace(Sub_Folder)){
	Folder_to_Search_id = fID;
}else{
	
	foreach (Folder f in findFolderResults)
	{
		
		
		
			if(f.DisplayName.Equals(Sub_Folder, StringComparison.OrdinalIgnoreCase))
			{
				
				Folder_to_Search_id=f.Id;
			}
		
	}	
}
FindItemsResults<Item> findResults;

if (Unread_Only_)
{
	findResults = service.FindItems(Folder_to_Search_id, unreadsf, view);
}
else { 
	findResults = service.FindItems(Folder_to_Search_id,view);
}

IDs.Columns.Add("ID", typeof(string));
IDs.Columns.Add("From", typeof(string));
IDs.Columns.Add("Subject", typeof(string));
IDs.Columns.Add("DateTimeSent", typeof(DateTime));


IDs_count=0;
foreach(Item i in findResults){
	IDs.Rows.Add(i.Id, ((EmailMessage)i).From.Name, i.Subject, i.DateTimeSent);
    IDs_count++;
}


if(IDs_count>0)
{
 Success=true;
 Error_Message=""; 
}else
{
  Success=false;
  Error_Message="No mails found in the folder."; 
} 

}catch(Exception ex)
{
	Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="86d31520-222e-4e42-a68c-2200cd34cdb8" name="Sub-Folder" type="Data"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="317c1ba6-e761-4263-aa79-b8bce92ba721" name="IDs" type="Collection"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-225" y="180" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="4f8a64f8-39ef-41f0-916a-ab6efc801cf5" name="Success" type="Data"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-150" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bc897c9c-4b42-4f72-9cae-a8bb0e4ae73d" name="Error Message" type="Data"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-225" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="945e7781-8a2d-45ab-ac86-57355a832633" name="Unread Only?" type="Data"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-225" y="15" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="9a73dc36-f758-4e49-80d7-836a5db632fb" name="Output Data Item" type="Block"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-270" y="135" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3e514648-34bf-48e9-99e4-d86d33909f23" name="Input Data Item" type="Block"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-270" y="-30" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5598a27b-c4c4-4eed-9d50-c670b13764ac" name="Shared Folder Email ID" type="Data"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><display x="-225" y="60" /><datatype>text</datatype><initialvalue xml:space="preserve">aia.change@bt.com</initialvalue><private /><alwaysinit /></stage><stage stageid="1085ab0e-f02e-41f2-b658-7c0f4e0e155b" name="End" type="End"><subsheetid>ec6167e0-2abe-4bc9-8a10-128c78cbd234</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="IDs" stage="IDs" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="8263a7b7-4940-45a8-8b2d-344c022e9cb2" name="End" type="End"><subsheetid>23c5be77-6497-411e-9bae-eab9a976cb3d</subsheetid><loginhibit /><display x="15" y="180" /><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="635ac474-442f-43f0-8b8b-40fa2771cac2" name="List Mails from Shared Draft Folder" type="SubSheetInfo"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="0703163e-1087-4d87-aa40-81815666e32a" name="End" type="End"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="ID's" stage="IDs" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="da916025-ead4-49c8-bce1-f2f1c2109c57" name="Start" type="Start"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Unread Only?" stage="Unread Only?" /><input type="text" name="Sub-Folder" stage="Sub-Folder" /><input type="text" name="Shared Folder Email ID" stage="Shared Folder Email ID" /></inputs><onsuccess>81723856-aacf-4a73-b278-6d0f3ad5d10f</onsuccess></stage><stage stageid="81723856-aacf-4a73-b278-6d0f3ad5d10f" name="List Mail from Within DateTimes (Shared Folder)1" type="Code"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><inputs><input type="flag" name="Unread Only?" expr="[Unread Only?]" /><input type="text" name="Sub-Folder" expr="[Sub-Folder]" /><input type="text" name="Shared_Folder_Email_ID" expr="[Shared Folder Email ID]" /></inputs><outputs><output type="text" name="Error Message" stage="Error Message" /><output type="collection" name="IDs" stage="IDs" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Message_Body" stage="Message_Body" /></outputs><onsuccess>83ce4172-760a-4174-94ce-d073ccbd64c5</onsuccess><code><![CDATA[InitExchangeService();
IDs = new DataTable();
int IDs_count;
Message_Body="";
try{
	
const int ONE_EMAIL = 1;

InitExchangeService(); 

Success=false;
ItemView view = new ItemView(int.MaxValue);
view.OrderBy.Add(ItemSchema.DateTimeReceived, SortDirection.Descending);
view.PropertySet = new PropertySet(BasePropertySet.IdOnly, EmailMessageSchema.Subject, EmailMessageSchema.From, EmailMessageSchema.DateTimeSent);
// Fire the query for the unread items.
// This method call results in a FindItem call to EWS.


PropertySet itempropertyset = new PropertySet(BasePropertySet.FirstClassProperties);
itempropertyset.RequestedBodyType = BodyType.Text;
ItemView itemview = new ItemView(1000);
itemview.PropertySet = itempropertyset;


SearchFilter unreadsf = new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false);
FolderView view1 = new FolderView(int.MaxValue);
view1.PropertySet = new PropertySet(BasePropertySet.IdOnly);
view1.PropertySet.Add(FolderSchema.DisplayName);
view1.Traversal = FolderTraversal.Deep;
			
Mailbox mailbox = new Mailbox(Shared_Folder_Email_ID);
FindFoldersResults findFolderResults = service.FindFolders(new FolderId(WellKnownFolderName.MsgFolderRoot, mailbox), view1);
Folder Folder_to_Search=null;

foreach (Folder f in findFolderResults)
{
	if (String.IsNullOrWhiteSpace(Sub_Folder))
	{
		if(f.DisplayName.Equals("inbox", StringComparison.OrdinalIgnoreCase))
		{
			Folder_to_Search=f;
		}
	}
	else {
		if(f.DisplayName.Equals(Sub_Folder, StringComparison.OrdinalIgnoreCase))
		{
			Folder_to_Search=f;
		}
	}
}	

FindItemsResults<Item> findResults;

if (Unread_Only_)
{
	findResults = service.FindItems(Folder_to_Search.Id, unreadsf, view);
}
else { 
	findResults = service.FindItems(Folder_to_Search.Id,view);
}

IDs.Columns.Add("ID", typeof(string));
//IDs.Columns.Add("From", typeof(string));
IDs.Columns.Add("Subject", typeof(string));
IDs.Columns.Add("Body", typeof(string));
//IDs.Columns.Add("DateTimeSent", typeof(DateTime));


IDs_count=0;

foreach(Item i in findResults){
	i.Load(itempropertyset);
	IDs.Rows.Add(i.Id,i.Subject,i.Body);
	
	//Message_Body=i.Body;
    IDs_count++;
}


if(IDs_count>0)
{
 Success=true;
 Error_Message=""; 
}else
{
  Success=false;
  Error_Message="No mails found in the folder."; 
} 

}catch(Exception ex)
{
	Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="4966c509-f87c-46d5-b59c-6e66df06f429" name="Sub-Folder" type="Data"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="362418ae-e360-491c-a5b6-5cd567615078" name="IDs" type="Collection"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><display x="-225" y="180" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="e7ce82be-f3b4-4a5d-91fb-76029eae674d" name="Success" type="Data"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><display x="-150" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b3be185-d141-4ce2-8dd3-b8cb38333ecf" name="Error Message" type="Data"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><display x="-225" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c3489d18-ffb5-4b78-9530-636f3a5c94fd" name="Unread Only?" type="Data"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><display x="-225" y="15" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="e0a3311f-cda7-4492-a9b7-bd7eb9a11825" name="Shared Folder Email ID" type="Data"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="83ce4172-760a-4174-94ce-d073ccbd64c5" name="End" type="End"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="ID's" stage="IDs" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="6ebf4c63-6e80-4e72-8ca9-5c91e20a5ed1" name="input" type="Block"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><loginhibit /><display x="-300" y="-15" w="225" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="539919c0-e7b5-44a3-a6d2-6a8abd4d20ed" name="output" type="Block"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><loginhibit /><display x="-285" y="150" w="270" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5844c84a-abaa-46a7-947e-f4fb681c992d" name="Send Mails from Drafts" type="SubSheetInfo"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b4944a1a-b90b-43b7-961d-cbc2763ee016" name="Start" type="Start"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><loginhibit /><display x="15" y="-165" /><inputs><input type="text" name="ItemId" narrative="Give the ItemId of the Mails that needs to be sent" stage="ItemID" /><input type="text" name="To" narrative="Give the Recepient List to send as To" stage="To" /><input type="text" name="CC" narrative="Give the Recepient List to send as CC" stage="CC" /><input type="text" name="BCC" narrative="Give the Recepient List to send as BCC" stage="BCC" /></inputs><onsuccess>1cfb11f1-7c34-484c-8d76-6021a44b0c5f</onsuccess></stage><stage stageid="4e745eb0-a531-4bd7-8e83-aef9c70a7e35" name="End" type="End"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="1cfb11f1-7c34-484c-8d76-6021a44b0c5f" name="isConfigured" type="Decision"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><loginhibit /><display x="15" y="-45" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>ef31d546-f8f9-4982-b33a-0f6c9a68da39</ontrue><onfalse>82bbd79d-dc57-4c25-8d61-8a6f10a130d3</onfalse></stage><stage stageid="82bbd79d-dc57-4c25-8d61-8a6f10a130d3" name="Not configured" type="Exception"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="135" y="-45" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="ef31d546-f8f9-4982-b33a-0f6c9a68da39" name="List Messages1" type="Code"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><loginhibit /><display x="15" y="30" w="90" h="30" /><inputs><input type="text" name="ItemId" expr="[ItemID]" /><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /></inputs><outputs><output type="text" name="Error_Message" stage="Error Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>4e745eb0-a531-4bd7-8e83-aef9c70a7e35</onsuccess><code><![CDATA[InitExchangeService();

try{

Success=true;
Error_Message="";

// As a best practice, create a property set that limits the properties returned by the Bind method to only those that are required.
PropertySet propSet = new PropertySet(BasePropertySet.IdOnly, EmailMessageSchema.Subject, EmailMessageSchema.ToRecipients,EmailMessageSchema.CcRecipients,EmailMessageSchema.BccRecipients);

// This method call results in a GetItem call to EWS.

EmailMessage message = EmailMessage.Bind(service, ItemId, propSet);

// Send the email message.
// This method call results in a SendItem call to EWS.

	foreach(String ToEmail in To.Split(';')){
		if(!String.IsNullOrWhiteSpace(ToEmail))
		
		message.ToRecipients.Add(ToEmail.Trim());
		
	}
	
	foreach(String CCEmail in CC.Split(';')){
		if(!String.IsNullOrWhiteSpace(CCEmail))
			message.CcRecipients.Add(CCEmail.Trim());
	}
	
	foreach(String BCCEmail in BCC.Split(';')){
		if(!String.IsNullOrWhiteSpace(BCCEmail))
			message.BccRecipients.Add(BCCEmail.Trim());
	}

//message.Send();
message.SendAndSaveCopy();


}catch (ServiceResponseException ex) 
{ 
	Success=false;
	Error_Message=ex.Message; 
} 
]]></code></stage><stage stageid="05dce49c-0468-4962-a4c6-76cd229c3004" name="IDs" type="Collection"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-240" y="150" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="f8f1f320-1fb1-45aa-b273-057d0a96a93d" name="Success" type="Data"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-165" y="150" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0c6e6dd-4678-4258-8483-5b88586f95fc" name="Error Message" type="Data"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-210" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="700ea7e9-e678-4071-b6df-4d3a82ff056d" name="Unread Only?" type="Data"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-225" y="15" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="de23417c-8583-40d3-ac75-d270ce5445d8" name="Output Data Item" type="Block"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-285" y="105" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9ad02a74-e852-42b7-88d5-044c5fc21ef5" name="Input Data Item" type="Block"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-270" y="-30" w="195" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="68cbccb8-0388-411e-a6bc-fa17138c5e3e" name="ItemID" type="Data"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><loginhibit /><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f086e25a-b00a-45e1-8a5e-34b3b41c323f" name="List Mail from Draft Folder" type="SubSheetInfo"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="fc6409d9-2407-46c1-b31e-96e10cded3d4" name="Start" type="Start"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="flag" name="Unread Only?" narrative="If True than only get unread emails, otherwise get any" stage="Unread Only?" /><input type="text" name="Sub-Folder" narrative="Optional. The name of a sub-folder below the Inbox from which to get emails.  If not set the Inbox will be used." stage="Sub-Folder" /></inputs><onsuccess>3501ee2e-604d-4b79-a80e-35ec301e8d15</onsuccess></stage><stage stageid="8281d10d-54c5-4e98-9cb7-9d1b78478ae1" name="End" type="End"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><loginhibit /><display x="15" y="135" /><outputs><output type="collection" name="IDs" stage="IDs" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="3501ee2e-604d-4b79-a80e-35ec301e8d15" name="isConfigured" type="Decision"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><loginhibit /><display x="15" y="-45" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>645ab996-2d19-4211-8a73-847f22c10274</ontrue><onfalse>6d702293-f5a0-4185-8275-30940108e508</onfalse></stage><stage stageid="6d702293-f5a0-4185-8275-30940108e508" name="Not configured" type="Exception"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="135" y="-45" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="645ab996-2d19-4211-8a73-847f22c10274" name="List Messages2" type="Code"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><loginhibit /><narrative>,mes.ToRecipients,mes.CcRecipients,mes.BccRecipients
EmailMessageSchema.ToRecipients,EmailMessageSchema.CcRecipients,EmailMessageSchema.BccRecipients</narrative><display x="15" y="30" w="90" h="30" /><inputs><input type="flag" name="Unread Only?" expr="[Unread Only?]" /><input type="text" name="Sub-Folder" expr="[Sub-Folder]" /><input type="text" name="From" expr="[From]" /><input type="collection" name="Recipients" expr="[Recipients]" /><input type="text" name="Subject" expr="[Subject]" /><input type="text" name="Body" expr="[Body]" /></inputs><outputs><output type="collection" name="IDs" stage="IDs" /><output type="text" name="Error Message" stage="Error Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>8281d10d-54c5-4e98-9cb7-9d1b78478ae1</onsuccess><code><![CDATA[

InitExchangeService();
IDs = new DataTable();
int IDs_count;
try
{
// Bind the folder to the service object.
Folder TargetFolder;
if (String.IsNullOrWhiteSpace(Sub_Folder))
{
	TargetFolder = Folder.Bind(service, WellKnownFolderName.Inbox);
}
else {
	FolderId FID = getFolderIDByName(Sub_Folder, service);
	if (FID == null) {
		throw new Exception("Foldername invalid. Please provide a valid mail folder to search in.");
	}
	TargetFolder = Folder.Bind(service, FID);
}



// The search filter to get unread email.
//SearchFilter unreadsf = new SearchFilter.SearchFilterCollection(LogicalOperator.And, new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false));
SearchFilter unreadsf = new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false);

// The view to return
ItemView view;
view = new ItemView(int.MaxValue);

/*
if (MaxNumberOfResults == 0)
{
	view = new ItemView(int.MaxValue);
}
else {
	view = new ItemView(Convert.ToInt32(MaxNumberOfResults));
}
*/

view.PropertySet = new PropertySet(BasePropertySet.IdOnly, EmailMessageSchema.Subject, EmailMessageSchema.From, EmailMessageSchema.DateTimeSent,EmailMessageSchema.DisplayTo);
PropertySet itempropertyset = new PropertySet(BasePropertySet.FirstClassProperties);
itempropertyset.RequestedBodyType = BodyType.Text;
ItemView itemview = new ItemView(1000);
itemview.PropertySet = itempropertyset;



// Fire the query for the unread items.
// This method call results in a FindItem call to EWS.
FindItemsResults<Item> findResults;

if (Unread_Only_)
{
	findResults = service.FindItems(TargetFolder.Id, unreadsf, view);
}
else { 
	findResults = service.FindItems(TargetFolder.Id, view);
}

//IDs.Columns.Add("From", typeof(string));
//IDs.Columns.Add("DateTimeSent", typeof(DateTime));
IDs.Columns.Add("ID", typeof(string));
IDs.Columns.Add("Subject", typeof(string));
IDs.Columns.Add("Body", typeof(string));
IDs.Columns.Add("To", typeof(string));
IDs.Columns.Add("CC", typeof(string));

IDs_count=0;

foreach(Item i in findResults){
	i.Load(itempropertyset);
	EmailMessage mes = (EmailMessage)i;
	
	string To_Address="";
	string Cc_Address="";
	
	//EmailMessage email_msg = EmailMessage.Bind(service,i.Id , new PropertySet(ItemSchema.DisplayTo)); 
	foreach(EmailAddress recipient in mes.ToRecipients)
	{
		//MessageBox.Show(recipient.Address);
		
		if(To_Address=="")
		{
			To_Address=recipient.Address;
		}else
		{
		 To_Address=To_Address+";"+recipient.Address;
		}
		
	}
	
	foreach(EmailAddress recipient in mes.CcRecipients)
	{
		//MessageBox.Show(recipient.Address);
		
		if(Cc_Address=="")
		{
			Cc_Address=recipient.Address;
		}else
		{
		 Cc_Address=Cc_Address+";"+recipient.Address;
		}
		
	}
	IDs.Rows.Add(i.Id, i.Subject,i.Body,To_Address,Cc_Address);
	//EmailMessage email_msg1 = EmailMessage.Bind(service,i.Id , new PropertySet(ItemSchema.DisplayCc)); 
//	foreach(EmailAddress recipient in email_msg1.CcRecipients)
	//{
	//	MessageBox.Show(recipient.Address);
	//}
	
	//MessageBox.Show(email_msg.ToRecipients.ToString());
    IDs_count++;
	
	  

}


if(IDs_count>0)
{
 Success=true;
 Error_Message=""; 
}else
{
  Success=false;
  Error_Message="No mails found in the folder."; 
} 


}catch (ServiceResponseException ex) 
{ 
	Success=false;
	Error_Message=ex.Message; 
} 
]]></code></stage><stage stageid="088d28a2-9df0-4393-b2cb-534fa655ef31" name="Sub-Folder" type="Data"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">Drafts</initialvalue><private /><alwaysinit /></stage><stage stageid="c932258c-8691-4e95-8146-62a9a262538f" name="IDs" type="Collection"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-225" y="135" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="148cd004-4272-41aa-87fb-5a7e514075ec" name="Success" type="Data"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-150" y="135" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0ecb54ab-094e-4f41-98af-b9394996e4d6" name="Error Message" type="Data"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-225" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1bc33da1-17f1-4391-9d57-f29be77f964e" name="Unread Only?" type="Data"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-225" y="15" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="7b425952-63f5-40fa-a029-44148151adb3" name="Output Data Item" type="Block"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-270" y="90" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2904b382-fb72-4717-935f-3fedcc9a79e3" name="Input Data Item" type="Block"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-270" y="-30" w="165" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="196b7d43-2909-45e2-8d90-fbbf1beb905e" name="To" type="Data"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-105" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="155e615b-05c0-441e-9420-06a01c9252c3" name="CC" type="Data"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="171ae49c-c39a-4e81-8e41-a5cbb66fbc8e" name="BCC" type="Data"><subsheetid>610531b7-ee7f-4319-807d-8e57b3852369</subsheetid><loginhibit /><display x="-150" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06da98a5-4144-443f-b00d-0581a11eeffa" name="Message_Body" type="Data"><subsheetid>08bd7af7-de0c-4876-9674-f7cf3e288d1c</subsheetid><display x="105" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="992486e7-2f3c-469b-9a18-e16ed62fbf78" name="Send Mails from Shared Drafts" type="SubSheetInfo"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="399e4d02-af1b-4323-8732-a2169c311452" name="Start" type="Start"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><loginhibit /><display x="30" y="-105" /><inputs><input type="text" name="Unread Only?" stage="Unread Only?" /><input type="text" name="Sub-Folder" stage="Sub-Folder" /><input type="date" name="Shared Folder Email ID" stage="Shared Folder Email ID" /><input type="text" name="ID" stage="ID" /><input type="text" name="To" stage="To" /><input type="text" name="CC" stage="CC" /><input type="text" name="BCC" stage="BCC" /></inputs><onsuccess>54daf541-5a85-435d-9efe-e5c144a42150</onsuccess></stage><stage stageid="54daf541-5a85-435d-9efe-e5c144a42150" name="List Mail from Within DateTimes (Shared Folder)2" type="Code"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><loginhibit /><display x="30" y="-15" w="90" h="30" /><inputs><input type="flag" name="Unread Only?" expr="[Unread Only?]" /><input type="text" name="Sub-Folder" expr="[Sub-Folder]" /><input type="text" name="Shared_Folder_Email_ID" expr="[Shared Folder Email ID]" /><input type="text" name="ID" expr="[ID]" /><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /></inputs><outputs><output type="text" name="Error Message" stage="Error Message" /><output type="collection" name="IDs" stage="IDs" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Message_Body" stage="Message_Body" /></outputs><onsuccess>c91b7efa-3028-4786-bd00-9458189ef4cd</onsuccess><code><![CDATA[InitExchangeService();
IDs = new DataTable();
//int IDs_count;
Message_Body="";
Success=false;
Error_Message="";
try{
	
//const int ONE_EMAIL = 1;

InitExchangeService(); 


ItemView view = new ItemView(int.MaxValue);
view.OrderBy.Add(ItemSchema.DateTimeReceived, SortDirection.Descending);
view.PropertySet = new PropertySet(BasePropertySet.IdOnly, EmailMessageSchema.Subject, EmailMessageSchema.From, EmailMessageSchema.DateTimeSent);
// Fire the query for the unread items.
// This method call results in a FindItem call to EWS.


PropertySet itempropertyset = new PropertySet(BasePropertySet.FirstClassProperties);
itempropertyset.RequestedBodyType = BodyType.Text;
ItemView itemview = new ItemView(1000);
itemview.PropertySet = itempropertyset;


SearchFilter unreadsf = new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false);
FolderView view1 = new FolderView(int.MaxValue);
view1.PropertySet = new PropertySet(BasePropertySet.IdOnly);
view1.PropertySet.Add(FolderSchema.DisplayName);
view1.Traversal = FolderTraversal.Deep;
			
Mailbox mailbox = new Mailbox(Shared_Folder_Email_ID);
FindFoldersResults findFolderResults = service.FindFolders(new FolderId(WellKnownFolderName.MsgFolderRoot, mailbox), view1);
Folder Folder_to_Search=null;

foreach (Folder f in findFolderResults)
{
	if (String.IsNullOrWhiteSpace(Sub_Folder))
	{
		if(f.DisplayName.Equals("inbox", StringComparison.OrdinalIgnoreCase))
		{
			Folder_to_Search=f;
		}
	}
	else {
		if(f.DisplayName.Equals(Sub_Folder, StringComparison.OrdinalIgnoreCase))
		{
			Folder_to_Search=f;
		}
	}
}	

FindItemsResults<Item> findResults;

if (Unread_Only_)
{
	findResults = service.FindItems(Folder_to_Search.Id, unreadsf, view);
}
else { 
	findResults = service.FindItems(Folder_to_Search.Id,view);
}

foreach(Item i in findResults){
	
	if(i.Id.ToString()==ID)
	{
			MessageBox.Show("1");
	EmailMessage mes = (EmailMessage)i;	
	
	foreach(String ToEmail in To.Split(';')){
		if(!String.IsNullOrWhiteSpace(ToEmail))
		
		mes.ToRecipients.Add(ToEmail.Trim());
		
	}
		MessageBox.Show("2");
	foreach(String CCEmail in CC.Split(';')){
		if(!String.IsNullOrWhiteSpace(CCEmail))
			mes.CcRecipients.Add(CCEmail.Trim());
	}
		MessageBox.Show("3");
	foreach(String BCCEmail in BCC.Split(';')){
		if(!String.IsNullOrWhiteSpace(BCCEmail))
			mes.BccRecipients.Add(BCCEmail.Trim());
	}	
	MessageBox.Show("4");
	mes.SendAndSaveCopy();
}
		MessageBox.Show("5");
}

}catch(Exception ex)
{
	Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="4ad1b39b-1185-4aba-8d1b-4b1820ae562c" name="Sub-Folder" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">Drafts</initialvalue><private /><alwaysinit /></stage><stage stageid="be567e63-015a-4256-8e5e-f1161ae762d1" name="IDs" type="Collection"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-225" y="180" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="e61d6108-345e-4c0f-824c-dcd5652c65d7" name="Success" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-150" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="22869570-71eb-4c9d-a015-342362d52371" name="Error Message" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-225" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cc15401e-6627-4b9f-a218-0ce7982cfa91" name="Unread Only?" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-225" y="15" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="1a657e52-51d9-47db-8e08-b538559bc772" name="Shared Folder Email ID" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-225" y="60" /><datatype>text</datatype><initialvalue xml:space="preserve">pew@bt.com</initialvalue><private /><alwaysinit /></stage><stage stageid="c91b7efa-3028-4786-bd00-9458189ef4cd" name="End" type="End"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><loginhibit /><display x="30" y="90" /><outputs><output type="collection" name="ID's" stage="IDs" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="1a31448b-1b35-4d68-9177-1f90591337fa" name="input" type="Block"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><loginhibit /><display x="-300" y="-15" w="270" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="324fc12f-8d18-435d-bb81-35de893d7d56" name="output" type="Block"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><loginhibit /><display x="-285" y="150" w="270" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a74cfed1-5225-455a-9a19-a7445fe009f9" name="Message_Body" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="165" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="51c2d6f2-8465-4163-a868-eaad35f68298" name="ID" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-150" y="60" /><datatype>text</datatype><initialvalue xml:space="preserve">AAMkADFlYTRiNjYzLTBkYzktNGI0NC05MmNlLTJlNTU2NjJmOGEyOQBGAAAAAADWj3rxuh/CSKhMzxZnQGwuBwCPC2y7yvwBQ5EpNY3ZKrvwAAABWuIYAAC0jmGu04EYTa9/9On0WQR7AAG1hkURAAA=</initialvalue><private /><alwaysinit /></stage><stage stageid="b34182b1-ffad-4727-a0b4-3d82c2259eb4" name="To" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-75" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">vadrevulakshmi.charan@bt,com;sachin.nair@bt.com</initialvalue><private /><alwaysinit /></stage><stage stageid="63cd451f-0214-400e-ad68-625b8b0d84c4" name="CC" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><display x="-255" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="adf87a91-eb26-404b-8db3-afe3ec97af37" name="BCC" type="Data"><subsheetid>3257eb2f-ad1b-463b-a22b-2de6e68cd15f</subsheetid><loginhibit /><display x="-195" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8409fafb-d346-4009-9d5b-9020b371a29e" name="Recipients" type="Collection"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><display x="-375" y="135" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="b66462b3-84e5-4f2f-ba20-b155978fd835" name="From" type="Data"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><loginhibit /><display x="-450" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="25c49f33-905b-4e99-9d99-fa859f887775" name="Subject" type="Data"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><loginhibit /><display x="-405" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b8b240ca-6415-4449-84b9-6c4f5ed6fcd4" name="Body" type="Data"><subsheetid>1bf6b382-291c-4f70-9c76-484af0bf01eb</subsheetid><loginhibit /><display x="-330" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1560b6d7-c1d5-4bed-b62d-f873b659be26" name="Send Mail" type="SubSheetInfo"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="26cf1c6d-553f-402e-904d-8d323db2de9b" name="Start" type="Start"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><loginhibit /><display x="15" y="-180" /><inputs><input type="text" name="To" narrative="The email address of the recipient. To address multiple recipients use the format &quot;john.smith@example.com;henry.jones@example.com&quot;." stage="To" /><input type="text" name="BCC" stage="BCC" /><input type="text" name="CC" narrative="The email address of the CC recipient. To address multiple recipients use the format &quot;john.smith@example.com; henry.jones@example.com&quot;." stage="CC" /><input type="text" name="Subject" narrative="The subject of the email." stage="Subject" /><input type="text" name="Message" narrative="The body of the email." stage="Message" /><input type="text" name="Attachments" narrative="Text containing a list of files to add to the email as attachments, Seperated by Semicolon." stage="Attachments" /><input type="flag" name="BodyIsHTML" narrative="Indicates if the body should be sent as HTML" stage="BodyIsHTML" /><input type="text" name="From" narrative="The Delegate Email Address" stage="From" /></inputs><onsuccess>74fa9058-21a5-48e7-ad2f-ba23bdabd8ee</onsuccess></stage><stage stageid="7e306adc-32a3-4211-a77f-c01f331588c9" name="End" type="End"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><loginhibit /><display x="15" y="30" /><outputs><output type="text" name="Error Message" stage="Error Message" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Mail GUID" stage="Mail GUID" /></outputs></stage><stage stageid="02ec92a3-1f4e-40fe-b99d-cccc8bb44b7d" name="To" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a3672a3f-4cff-4d9c-9e49-e35e5bb49079" name="Subject" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-225" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7ef4de09-5e05-42d8-afb7-f338dd48de4a" name="Send Message (Delegate)" type="Code"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="Subject" expr="[Subject]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Attachments" expr="[Attachments]" /><input type="text" name="BCC" expr="[BCC]" /><input type="flag" name="BodyIsHTML" expr="[BodyIsHTML]" /><input type="text" name="From" expr="[From]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /><output type="text" name="Mail GUID" stage="Mail GUID" /></outputs><onsuccess>7e306adc-32a3-4211-a77f-c01f331588c9</onsuccess><code><![CDATA[InitExchangeService();

Success=false;
Error_Message="Unable to Send Mail";
	
try{
// Create an email message and provide it with connection configuration information by using an ExchangeService object named service.
EmailMessage message = new EmailMessage(service);

// Set properties on the email message.
	//if(!String.IsNullOrWhiteSpace(From))
	//	message.From = From;

	message.From = new EmailAddress(From);
	message.Subject = Subject;

	message.Body = Message;

	foreach(String ToEmail in To.Split(';')){
		if(!String.IsNullOrWhiteSpace(ToEmail))
			message.ToRecipients.Add(ToEmail.Trim());
	}

	foreach(String CCEmail in CC.Split(';')){
		if(!String.IsNullOrWhiteSpace(CCEmail))
			message.CcRecipients.Add(CCEmail.Trim());
	}
	
	foreach(String BCCEmail in BCC.Split(';')){
		if(!String.IsNullOrWhiteSpace(BCCEmail))
			message.BccRecipients.Add(BCCEmail.Trim());
	}

	if (BodyIsHTML)
	{
		message.Body.BodyType = BodyType.HTML;
	}
	else {
		message.Body.BodyType = BodyType.Text;
	}
    //foreach (DataRow dr in Attachments.Rows)
	//string file = dr[Attachment].ToString();
	
	
	if(Attachments!=""){
		foreach(String Attachment in Attachments.Split(';'))
		{
			message.Attachments.AddFileAttachment(Attachment);
		}
	}
// End set properties on the email message.


// Send the email message and save a copy.
// This method call results in a CreateItem call to EWS.

Random RNG = new Random();
var builder = new System.Text.StringBuilder();
while (builder.Length < 16) 
{
  builder.Append(RNG.Next(10).ToString());
}

Mail_GUID=builder.ToString();

Guid myPropertySetId = new Guid("{20B5C09F-7CAD-44c6-BDBF-8FCBEEA08544}"); 
ExtendedPropertyDefinition myExtendedPropertyDefinition = new ExtendedPropertyDefinition(myPropertySetId, "MyExtendedPropertyName", MapiPropertyType.String); 
message.SetExtendedProperty(myExtendedPropertyDefinition, Mail_GUID); 
message.SendAndSaveCopy();
Success=true;
Error_Message="";
}
catch(Exception ex)
{
	Success=false;
	Error_Message=ex.Message;
	Mail_GUID="";
}]]></code></stage><stage stageid="74fa9058-21a5-48e7-ad2f-ba23bdabd8ee" name="isConfigured" type="Decision"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><loginhibit /><display x="15" y="-105" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>7ef4de09-5e05-42d8-afb7-f338dd48de4a</ontrue><onfalse>ee2d9f4c-1b95-4552-8426-25aa83b3708a</onfalse></stage><stage stageid="ee2d9f4c-1b95-4552-8426-25aa83b3708a" name="Not configured" type="Exception"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="135" y="-105" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="4cc74c21-344a-4e48-bc95-f996f65ef6ba" name="BodyIsHTML" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-150" y="150" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="10f80cec-6fb9-4999-8d07-a94b79beaa60" name="CC" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-150" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ab267b49-9e1f-46ef-ba84-6adf8a91acc8" name="Error Message" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-165" y="300" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7e18d629-dbdc-4130-9990-5b823ba5fea3" name="Success" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-225" y="300" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1ca70d4c-96a8-4d69-b558-42d4a5f0f798" name="Attachments" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><loginhibit /><display x="-225" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="61112d71-374f-425e-8434-3481c97b56be" name="BCC" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><loginhibit /><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="829c7d39-0b87-45cd-94a2-5bab33e60545" name="Message" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-150" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3ef166df-3905-4c80-b643-6cadf995f597" name="Input Data Item" type="Block"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-270" y="-30" w="165" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="21e4e2a4-cc67-4546-98cf-aaac289f05bf" name="Output Data Item" type="Block"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-270" y="255" w="165" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="aa3ace44-16fb-40e1-8ff9-497588280fa7" name="Mail GUID" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-225" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4ef1820d-82a7-4054-a493-0db16e1ea6c6" name="From" type="Data"><subsheetid>5537da07-e306-4e29-830e-ff50cc4b00b6</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5f8e42ce-3ede-42c9-aeab-455c7907e153" name="New Mail Id" type="Data"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="-240" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="19d928a2-2e6e-49b0-bb38-0c3b5bd756be" name="Get Mail using ID in HTML format" type="SubSheetInfo"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="d37fe6fe-8af6-4c22-ba96-3f7ba3c4fc6f" name="Start" type="Start"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><loginhibit /><display x="-15" y="-120" /><inputs><input type="text" name="Attachment Directory" stage="Attachment Directory" /><input type="text" name="Mail ID" stage="Mail ID" /></inputs><onsuccess>53ece8b4-1f9b-4116-b65c-57866ce4854d</onsuccess></stage><stage stageid="37d4de3c-7140-4548-ae00-646d10ef5f6d" name="End" type="End"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><loginhibit /><display x="-15" y="135" /><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="53ece8b4-1f9b-4116-b65c-57866ce4854d" name="isConfigured" type="Decision"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><loginhibit /><display x="-15" y="-45" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>7f4166fc-17a8-4139-89ee-4a61cfcece3c</ontrue><onfalse>2943930c-cf94-4315-89ef-8163d591bc7a</onfalse></stage><stage stageid="2943930c-cf94-4315-89ef-8163d591bc7a" name="Not configured" type="Exception"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="105" y="-45" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="7f4166fc-17a8-4139-89ee-4a61cfcece3c" name="GetMail using ID1" type="Code"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><loginhibit /><display x="-15" y="45" /><inputs><input type="text" name="Attachment Directory" expr="[Attachment Directory]" /><input type="text" name="Mail ID" expr="[Mail ID]" /></inputs><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs><onsuccess>37d4de3c-7140-4548-ae00-646d10ef5f6d</onsuccess><code><![CDATA[
ID="";
Sender_Name="";
Sender_Email_Address="";
Subject="";
Message_Body="";
Attachment_Names="";
Error_Message="";
bool mail_exists=false;

try{
 InitExchangeService(); 
 Success=false;

const int ONE_EMAIL = 1;

PropertySet propSet = new PropertySet(BasePropertySet.FirstClassProperties, ItemSchema.Subject,ItemSchema.Body, ItemSchema.DateTimeReceived, EmailMessageSchema.From, EmailMessageSchema.ToRecipients);
propSet.RequestedBodyType = BodyType.HTML;
 
EmailMessage mes = EmailMessage.Bind(service, new ItemId(Mail_ID),propSet);

mail_exists=true;
 //Sender_Name=mes.From.Name;
 Sender_Name=mes.From.Name;
 NameResolutionCollection resolvedNames=service.ResolveName(mes.Sender.Address);

 foreach (NameResolution nameRes in resolvedNames)
 {
   Sender_Email_Address=nameRes.Mailbox.Address;
   break;
 }
		  
 //Sender_Email_Address=mes.From.Address;
 Subject=mes.Subject;
 Message_Body=mes.Body;
 Attachment_Names="";
 ID=mes.Id.ToString();
	  	
 EmailMessage attach_mes = EmailMessage.Bind(service, ID, new PropertySet(ItemSchema.Attachments));
 int index=0;

 foreach (Attachment attachment in attach_mes.Attachments)
 {		
  if (attachment is FileAttachment)
  {
	FileAttachment fileAttachment = attachment as FileAttachment;
	
    if(index==0)
	{
		Attachment_Names=fileAttachment.Name;
	}else{
		Attachment_Names=Attachment_Names+";"+fileAttachment.Name;
	}
			
	fileAttachment.Load(Attachment_Directory+"\\" + fileAttachment.Name);
	index=index+1;
  }
  else // Attachment is an item attachment.
  {
	ItemAttachment itemAttachment = attachment as ItemAttachment;

	// Load attachment into memory and write out the subject.
	// This does not save the file like it does with a file attachment.
	// This call results in a GetAttachment call to EWS.
	itemAttachment.Load();
  }
 }    
 if(mail_exists){
  Success=true;
  Error_Message="";
 }
 else
 {
  Success=false;
  Error_Message="Unable to get Mail. Mail folder is empty";
 } 
}catch(Exception ex)
{
  Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="b0fc28ff-720d-4541-a4b1-ccba9a89e56a" name="Sub-Folder" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-255" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="358dc1e7-2b83-4e79-93b6-2cb7b0596c4e" name="Attachment Directory" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-180" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="539814e1-a8e1-4a9f-bb80-ab280c35b83d" name="Sender Name" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-255" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aa6f312a-037f-49cc-9fce-28d324c80f4c" name="Sender Email Address" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-180" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0ee75ef9-234d-4526-96ea-4fb8b4f897a2" name="Subject" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-255" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1b149847-e618-4da6-8514-6ec22a17b4cd" name="Message Body" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-180" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6c05b148-35e1-4e2f-a01d-bde3a7767d87" name="Attachment Names" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-255" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3c17e7ee-1e0d-406c-baec-5a46751fa990" name="ID" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-180" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="28568561-97f7-4065-8527-f88cc6aaa920" name="Success" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-255" y="300" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b8cd3c05-9ec5-48da-acde-6194995f7ff0" name="Error Message" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-180" y="300" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1b921fa5-bdff-400b-ad45-1d4595fe913a" name="Input Data Item" type="Block"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-300" y="-45" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="bde5c2af-ff7f-4084-90b1-c73b67bf7898" name="Output Data Item" type="Block"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><display x="-300" y="90" w="165" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="92d5088f-b717-4fc9-aa38-e6c8be1a1de4" name="Mail ID" type="Data"><subsheetid>4288ce39-430f-494c-acb7-e59fcb6f0807</subsheetid><loginhibit /><display x="-255" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ad847900-7bba-4c5c-85e7-86b0b618c2e3" name="Move Mail" type="SubSheetInfo"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="a30d9538-daed-420c-a545-c83667e9a03e" name="Start" type="Start"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><loginhibit /><display x="30" y="-150" /><inputs><input type="text" name="ID" stage="ID" /><input type="text" name="Move to Sub-Folder" stage="Move to Sub-Folder" /><input type="text" name="Shared Folder Email ID" stage="Shared Folder Email ID" /></inputs><onsuccess>82388a10-ee72-499c-8706-d310ab208db4</onsuccess></stage><stage stageid="d8e0fb1c-7ff4-456e-8eb8-f6fe87510d0b" name="End" type="End"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><loginhibit /><display x="30" y="150" /><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /><output type="text" name="New Mail Id" stage="New Mail Id" /></outputs></stage><stage stageid="e13a26ff-2cc2-4759-8069-ab7499c77baa" name="MoveMail Code shared" type="Code"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><loginhibit /><display x="30" y="45" w="120" h="60" /><inputs><input type="text" name="ID" expr="[ID]" /><input type="text" name="Move to Sub-Folder" expr="[Move to Sub-Folder]" /><input type="text" name="Shared Folder Email ID" expr="[Shared Folder Email ID]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /><output type="text" name="New Mail Id" stage="New Mail Id" /></outputs><onsuccess>d8e0fb1c-7ff4-456e-8eb8-f6fe87510d0b</onsuccess><code><![CDATA[New_Mail_Id="";
try 
{ 

InitExchangeService();
/*
Collection<ItemId> itemIds = new Collection<ItemId>(); 
itemIds.Add(ID); 

  EmailMessage email1 = new EmailMessage(service); 
            email1.Subject = "Draft email one"; 
            email1.Body = new MessageBody(BodyType.Text, "Draft body of the mail");
			
			  Collection<EmailMessage> messages = new Collection<EmailMessage>(); 
            messages.Add(email1); 
			
				  Collection<ItemId> itemIds1 = new Collection<ItemId>(); 
         

			ServiceResponseCollection<ServiceResponse> responses = service.CreateItems(messages, WellKnownFolderName.Drafts, MessageDisposition.SaveOnly, null); 
 
			   foreach (EmailMessage email in messages) 
            { 
                itemIds1.Add(email.Id); 
            } 
	*/	

FolderView view1 = new FolderView(100);
view1.PropertySet = new PropertySet(BasePropertySet.IdOnly);
view1.PropertySet.Add(FolderSchema.DisplayName);
view1.Traversal = FolderTraversal.Deep;	
Mailbox mailbox = new Mailbox(Shared_Folder_Email_ID);
FolderId FID = new FolderId(WellKnownFolderName.Inbox, mailbox);
FindFoldersResults findFolderResults = service.FindFolders(FID, view1);
FolderId Folder_to_Search_id = null;
Collection<ItemId> itemIds = new Collection<ItemId>(); 
itemIds.Add(ID); 	
if(String.IsNullOrWhiteSpace(Move_to_Sub_Folder)){
	throw new Exception("Foldername invalid. Please provide a valid mail folder to search in.");
}else if(Move_to_Sub_Folder.Equals("inbox", StringComparison.OrdinalIgnoreCase)){
	Folder_to_Search_id = FID;
}else{
	foreach (Folder f in findFolderResults)
	{
		//MessageBox.Show(f.DisplayName);
		if(f.DisplayName.Equals(Move_to_Sub_Folder, StringComparison.OrdinalIgnoreCase))
			{
				
				Folder_to_Search_id=f.Id;
			}
		
	}	
}		
//FolderId FID = getFolderIDByName(Move_to_Sub_Folder, service);
if (Folder_to_Search_id == null) {
	throw new Exception("Foldername invalid. Please provide a valid mail folder to search in.");
}

Folder TargetFolder = Folder.Bind(service, Folder_to_Search_id);

ServiceResponseCollection<MoveCopyItemResponse> responses1 = service.MoveItems(itemIds,TargetFolder.Id); 


if (responses1.OverallResult == ServiceResult.Success) 
{ 
	New_Mail_Id=responses1[0].Item.Id.ToString();
	Success=true;
    Error_Message="";
} 
else 
{ 
	Success=false;
    Error_Message="Unable to move mail";
} 
} 
catch (Exception ex) 
{ 
	Success=false;
	Error_Message=ex.Message; 
} 
]]></code></stage><stage stageid="b30ecc90-a8c0-4626-9037-4e29811fe402" name="ID" type="Data"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-315" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">123456</initialvalue><private /><alwaysinit /></stage><stage stageid="bf00c0d5-e3d6-4740-804c-2c0de81d241c" name="Move to Sub-Folder" type="Data"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">AH Voice Orders Management</initialvalue><private /><alwaysinit /></stage><stage stageid="cfb3f960-a108-4b4a-83e1-a7415444b3fa" name="Success" type="Data"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-240" y="150" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="592f1a3b-9358-4f6c-af7a-cc642bae3d8f" name="Error Message" type="Data"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-165" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d09b896b-1b96-4896-80a9-3d8409cabf4b" name="Input Data Item" type="Block"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-375" y="-30" w="255" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a24437bd-c23d-4e35-8e7b-ef968872e201" name="Output Data Item" type="Block"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-285" y="105" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="82388a10-ee72-499c-8706-d310ab208db4" name="isConfigured" type="Decision"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><loginhibit /><display x="30" y="-60" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>e13a26ff-2cc2-4759-8069-ab7499c77baa</ontrue><onfalse>0aea4c48-fa3e-4381-bd07-a1388615d514</onfalse></stage><stage stageid="0aea4c48-fa3e-4381-bd07-a1388615d514" name="Not configured" type="Exception"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="150" y="-60" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="0040bed9-d691-480f-ae6b-99795c50f633" name="New Mail Id" type="Data"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-240" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c2f04589-8038-43e3-9fb6-668ba3e3298f" name="Shared Folder Email ID" type="Data"><subsheetid>b5fc4d0b-1065-406f-b148-c23ec4b1bfeb</subsheetid><display x="-255" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2c462ed2-cf5a-442c-86b4-256e69dfb7b2" name="Get Mail" type="SubSheetInfo"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="0ac35bec-7732-44e2-bfae-b376fdac615d" name="Start" type="Start"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Attachment Directory" stage="Attachment Directory" /><input type="text" name="Mail ID" stage="Mail ID" /></inputs><onsuccess>9d5cec53-081b-4b88-b624-98a83118debe</onsuccess></stage><stage stageid="b31ceab5-2b0c-4f63-bb1c-9c7e1671b909" name="End" type="End"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><loginhibit /><display x="15" y="150" /><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="9d5cec53-081b-4b88-b624-98a83118debe" name="isConfigured" type="Decision"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>f7140846-c5af-42c0-b241-b45e96f60156</ontrue><onfalse>ee01c6d0-ded4-4171-b0dd-2f254066db3c</onfalse></stage><stage stageid="ee01c6d0-ded4-4171-b0dd-2f254066db3c" name="Not configured" type="Exception"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="135" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="f7140846-c5af-42c0-b241-b45e96f60156" name="GetMail using ID Item 11" type="Code"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><loginhibit /><narrative>
ID="";
Sender_Name="";
Sender_Email_Address="";
Subject="";
Message_Body="";
Attachment_Names="";
Error_Message="";
bool mail_exists=false;

try{
 InitExchangeService(); 
 Success=false;

const int ONE_EMAIL = 1;

PropertySet propSet = new PropertySet(BasePropertySet.FirstClassProperties, ItemSchema.Subject,ItemSchema.Body, ItemSchema.DateTimeReceived, EmailMessageSchema.From, EmailMessageSchema.ToRecipients);
propSet.RequestedBodyType = BodyType.Text;
 
EmailMessage mes = EmailMessage.Bind(service, new ItemId(Mail_ID),propSet);

mail_exists=true;
 //Sender_Name=mes.From.Name;
 Sender_Name=mes.From.Name;
 NameResolutionCollection resolvedNames=service.ResolveName(mes.Sender.Address);

 foreach (NameResolution nameRes in resolvedNames)
 {
   Sender_Email_Address=nameRes.Mailbox.Address;
   break;
 }
		  
 //Sender_Email_Address=mes.From.Address;
 Subject=mes.Subject;
 Message_Body=mes.Body;
 Attachment_Names="";
 ID=mes.Id.ToString();
	  	
 EmailMessage attach_mes = EmailMessage.Bind(service, ID, new PropertySet(ItemSchema.Attachments));
 int index=0;

 foreach (Attachment attachment in attach_mes.Attachments)
 {		
  if (attachment is FileAttachment)
  {
	FileAttachment fileAttachment = attachment as FileAttachment;
	
    if(index==0)
	{
		Attachment_Names=fileAttachment.Name;
	}else{
		Attachment_Names=Attachment_Names+";"+fileAttachment.Name;
	}
			
	fileAttachment.Load(Attachment_Directory+"\\" + fileAttachment.Name);
	index=index+1;
  }
  else // Attachment is an item attachment.
  {
	string extn = "";
                                ItemAttachment itemAttachment = attachment as ItemAttachment;

                                if (index == 0)
                                {
                                    Attachment_Names = itemAttachment.Name;
                                }
                                else
                                {
                                    Attachment_Names = Attachment_Names + ";" + itemAttachment.Name;
                                }

                                itemAttachment.Load(EmailMessageSchema.MimeContent);
                                if (itemAttachment.ContentType.Contains("message"))
                                {
                                    extn = "eml";
                                }
                                if(extn != "")
                                {
                                    File.WriteAllBytes(Attachment_Directory + "\\" + itemAttachment.Name + "." + extn, itemAttachment.Item.MimeContent.Content);
                                }
                                else
                                {
                                    File.WriteAllBytes(Attachment_Directory + "\\" + itemAttachment.Name, itemAttachment.Item.MimeContent.Content);
                                }
                                
                                index = index + 1;
  }
 }    
 if(mail_exists){
  Success=true;
  Error_Message="";
 }
 else
 {
  Success=false;
  Error_Message="Unable to get Mail. Mail folder is empty";
 } 
}catch(Exception ex)
{
  Success=false;
  Error_Message=ex.Message;
}
	


</narrative><display x="15" y="60" /><inputs><input type="text" name="Attachment Directory" expr="[Attachment Directory]" /><input type="text" name="Mail ID" expr="[Mail ID]" /></inputs><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment_Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs><onsuccess>b31ceab5-2b0c-4f63-bb1c-9c7e1671b909</onsuccess><code><![CDATA[
ID="";
Sender_Name="";
Sender_Email_Address="";
Subject="";
Message_Body="";
Attachment_Names="";
Error_Message="";
bool mail_exists=false;

try{
 InitExchangeService(); 
 Success=false;

const int ONE_EMAIL = 1;

PropertySet propSet = new PropertySet(BasePropertySet.FirstClassProperties, ItemSchema.Subject,ItemSchema.Body, ItemSchema.DateTimeReceived, EmailMessageSchema.From, EmailMessageSchema.ToRecipients);
propSet.RequestedBodyType = BodyType.Text;
 
EmailMessage mes = EmailMessage.Bind(service, new ItemId(Mail_ID),propSet);

mail_exists=true;
 //Sender_Name=mes.From.Name;
 Sender_Name=mes.From.Name;
 NameResolutionCollection resolvedNames=service.ResolveName(mes.Sender.Address);

 foreach (NameResolution nameRes in resolvedNames)
 {
   Sender_Email_Address=nameRes.Mailbox.Address;
   break;
 }
		  
 //Sender_Email_Address=mes.From.Address;
 Subject=mes.Subject;
 Message_Body=mes.Body;
 Attachment_Names="";
 ID=mes.Id.ToString();
	  	
 EmailMessage attach_mes = EmailMessage.Bind(service, ID, new PropertySet(ItemSchema.Attachments));
 int index=0;

 foreach (Attachment attachment in attach_mes.Attachments)
 {		
  if (attachment is FileAttachment)
  {
	FileAttachment fileAttachment = attachment as FileAttachment;
	
    if(index==0)
	{
		Attachment_Names=fileAttachment.Name;
	}else{
		Attachment_Names=Attachment_Names+";"+fileAttachment.Name;
	}
			
	fileAttachment.Load(Attachment_Directory+"\\" + fileAttachment.Name);
	index=index+1;
  }
  else // Attachment is an item attachment.
  {
	string extn = "";
                                ItemAttachment itemAttachment = attachment as ItemAttachment;
								String FileName = Regex.Replace(itemAttachment.Name, @"[^0-9a-zA-Z]+", " ");
								itemAttachment.Load(EmailMessageSchema.MimeContent);
								//MessageBox.Show(itemAttachment.ContentType);
                                if (itemAttachment.ContentType.Contains("message") || itemAttachment.ContentType.Contains("octet-stream"))
                                {
									
                                    extn = "eml";
                                }
                                if(extn != "")
                                {
									
									//MessageBox.Show(Attachment_Directory + "\\" + itemAttachment.Name + "." + extn);
									//MessageBox.Show(FileName);
									FileName = FileName + "." + extn;
                                    File.WriteAllBytes(Attachment_Directory + "\\" + FileName, itemAttachment.Item.MimeContent.Content);
                                }
                                else
                                {
                                    File.WriteAllBytes(Attachment_Directory + "\\" + itemAttachment.Name, itemAttachment.Item.MimeContent.Content);
                                }
                                if (index == 0)
                                {
                                    Attachment_Names = FileName;
                                }
                                else
                                {
                                    Attachment_Names = Attachment_Names + ";" + FileName;
                                }
									//MessageBox.Show(itemAttachment.ContentType);
                               
                                
                                index = index + 1;
  }
 }    
 if(mail_exists){
  Success=true;
  Error_Message="";
 }
 else
 {
  Success=false;
  Error_Message="Unable to get Mail. Mail folder is empty";
 } 
}catch(Exception ex)
{
  Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="5bddd7d0-c1b8-4b5e-b9d3-17bab6f5453c" name="Sub-Folder" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e777896e-0d31-4a87-9a9f-71b9812988e6" name="Attachment Directory" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="381d1da1-b61a-4b00-87c7-458fdcc854f6" name="Sender Name" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-225" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7f09d2b6-29e8-40b4-be9a-b72d0baef327" name="Sender Email Address" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-150" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="acf0e6d2-0bc9-4c52-bdc8-f278618530c8" name="Subject" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-225" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e304a491-830e-45cf-8e89-fd7972ac2663" name="Message Body" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-150" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef324c83-8b47-4814-b93c-74aa0b6e752f" name="Attachment Names" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-225" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="90f923e3-a642-457e-96c4-6c89217e89bf" name="ID" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-150" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="420fd4fc-17ea-409c-91c7-d03dc856e1f4" name="Success" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-225" y="315" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cb86ceb1-b46c-4513-aaef-676497b021f3" name="Error Message" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-150" y="315" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f5764b60-49a1-459f-8889-61b1b50f3e40" name="Input Data Item" type="Block"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-270" y="-30" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2c401101-d741-42e1-928f-31e5831157ee" name="Output Data Item" type="Block"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><display x="-270" y="105" w="165" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="54ed236c-ed0e-4815-9bbd-83e95f773601" name="Mail ID" type="Data"><subsheetid>3e765ce8-e8d0-4418-95b3-d095d2c7503d</subsheetid><loginhibit /><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="62da81a5-9c36-4cda-9c39-987d9c3d691e" name="Get Mail" type="SubSheetInfo"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="e0d5b77c-fd81-446a-8567-01be559dbbc6" name="Start" type="Start"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Attachment Directory" stage="Attachment Directory" /><input type="text" name="Mail ID" stage="Mail ID" /></inputs><onsuccess>0619fb31-e15d-43e7-b702-f94fe2223d06</onsuccess></stage><stage stageid="1e8bf6fe-cef8-4e5b-be07-2fc7d29d528d" name="End" type="End"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><loginhibit /><display x="15" y="150" /><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /><output type="collection" name="To" stage="To" /></outputs></stage><stage stageid="0619fb31-e15d-43e7-b702-f94fe2223d06" name="isConfigured" type="Decision"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>1f0bcd81-e541-4e48-aa6c-d8cbf465fb56</ontrue><onfalse>9b7b923b-21e8-44eb-af88-da1a263ffc6c</onfalse></stage><stage stageid="9b7b923b-21e8-44eb-af88-da1a263ffc6c" name="Not configured" type="Exception"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="135" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="1f0bcd81-e541-4e48-aa6c-d8cbf465fb56" name="GetMail using ID Extended" type="Code"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><loginhibit /><narrative>a.	</narrative><display x="15" y="60" /><inputs><input type="text" name="Attachment Directory" expr="[Attachment Directory]" /><input type="text" name="Mail ID" expr="[Mail ID]" /></inputs><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /><output type="collection" name="To" stage="To" /></outputs><onsuccess>1e8bf6fe-cef8-4e5b-be07-2fc7d29d528d</onsuccess><code><![CDATA[ID="";
Sender_Name="";
Sender_Email_Address="";
Subject="";
Message_Body="";
Attachment_Names="";
Error_Message="";
bool mail_exists=false;
To = new DataTable();
To.Columns.Add("To",typeof(string));

try{
 InitExchangeService(); 
 Success=false;

const int ONE_EMAIL = 1;

PropertySet propSet = new PropertySet(BasePropertySet.FirstClassProperties, ItemSchema.Subject,ItemSchema.Body, ItemSchema.DateTimeReceived, EmailMessageSchema.From, EmailMessageSchema.ToRecipients);
propSet.RequestedBodyType = BodyType.Text;
 
EmailMessage mes = EmailMessage.Bind(service, new ItemId(Mail_ID),propSet);

mail_exists=true;
 //Sender_Name=mes.From.Name;
 Sender_Name=mes.From.Name;
 NameResolutionCollection resolvedNames=service.ResolveName(mes.Sender.Address);

 foreach (NameResolution nameRes in resolvedNames)
 {
   Sender_Email_Address=nameRes.Mailbox.Address;
   break;
 }
 
 if(Sender_Email_Address.Equals(string.Empty))
 {
	string tempAdd = mes.From.ToString();
	string [] Sender_Address = tempAdd.Split(':');
	Sender_Email_Address = Sender_Address[1].Replace(">","");	 
 }
 
 
 DataRow drow;
 NameResolutionCollection ToName;
	 
 /*****This Code is used to Get to address of a mail which uses Exchange Server*/
 
 /*for(int i = 0 ; i < mes.ToRecipients.Count;i++)
 {
	ToName = service.ResolveName(mes.ToRecipients[i);
	 foreach(NameResolution names in ToName)
	 {
	 	 drow = To.NewRow();
		 drow["To"] = names.Mailbox.Address;
		 To.Rows.Add(drow.ItemArray);
		 break;
	 }
 }*/
 
 foreach(EmailAddress EA in mes.ToRecipients)
 {
	 drow = To.NewRow();
		 drow["To"] = EA;
		 To.Rows.Add(drow.ItemArray);
 }

		  
 //Sender_Email_Address=mes.From.Address;
 Subject=mes.Subject;
 Message_Body=mes.Body;
 Attachment_Names="";
 ID=mes.Id.ToString();
	  	
 EmailMessage attach_mes = EmailMessage.Bind(service, ID, new PropertySet(ItemSchema.Attachments));
 int index=0;

 foreach (Attachment attachment in attach_mes.Attachments)
 {		
  if (attachment is FileAttachment)
  {
	FileAttachment fileAttachment = attachment as FileAttachment;
	
    if(index==0)
	{
		Attachment_Names=fileAttachment.Name;
	}else{
		Attachment_Names=Attachment_Names+";"+fileAttachment.Name;
	}
			
	fileAttachment.Load(Attachment_Directory+"\\" + fileAttachment.Name);
	index=index+1;
  }
  else // Attachment is an item attachment.
  {
	ItemAttachment itemAttachment = attachment as ItemAttachment;

	// Load attachment into memory and write out the subject.
	// This does not save the file like it does with a file attachment.
	// This call results in a GetAttachment call to EWS.
	itemAttachment.Load();
  }
 }    
 if(mail_exists){
  Success=true;
  Error_Message="";
 }
 else
 {
  Success=false;
  Error_Message="Unable to get Mail. Mail folder is empty";
 } 
}catch(Exception ex)
{
  Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="68252163-79d0-41ea-9cd1-8a8017e5539c" name="Sub-Folder" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="79f5a2d4-645e-4274-8bbf-a765c9286669" name="Attachment Directory" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cdc326ea-aa20-4b89-9b8a-3764bc75ac55" name="Sender Name" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-225" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f6f09ba8-d5d2-4ccd-9f9a-a33a774e06fe" name="Sender Email Address" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-150" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="920204df-2698-4f14-bf9a-8223ef26fc7f" name="Subject" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-225" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d1216672-4ee4-4d64-84a8-ef0105b69734" name="Message Body" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-150" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="11469f84-c5a0-4f18-89d9-92707544e62f" name="Attachment Names" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-225" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fbd0c46a-1332-42cb-8c8e-08241e674018" name="ID" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-150" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e53278b9-7315-46cc-bd02-839ca3242ab7" name="Success" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-225" y="315" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="84543520-45f7-49e8-9a81-902f11c95471" name="Error Message" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-150" y="315" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="54f5aa50-0945-4699-83e9-dcde620beff7" name="Input Data Item" type="Block"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-270" y="-30" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="300c1393-b4d0-4196-9166-2d70824cbdde" name="Output Data Item" type="Block"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="-270" y="105" w="165" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a76d223a-3cdb-4e93-b4dd-ad506c9fe117" name="Mail ID" type="Data"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><loginhibit /><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fa259fdc-e897-42aa-a729-1d7f3c13b163" name="To" type="Collection"><subsheetid>fa0ffd8f-e15f-4f0a-afd7-5d8534810f24</subsheetid><display x="90" y="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="c8a60037-7365-4afd-89af-2aff8bee30ee" name="Reply To" type="SubSheetInfo"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b820e20a-7d12-4c3b-beba-9280b9f37717" name="Start" type="Start"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="15" y="-120" w="120" h="60" /><inputs><input type="text" name="Mail ID" stage="Mail ID" /><input type="text" name="To" stage="To" /><input type="text" name="CC" stage="CC" /><input type="text" name="Subject" stage="Subject" /><input type="text" name="Message" stage="Message" /><input type="flag" name="BodyIsHTML" stage="BodyIsHTML" /></inputs><onsuccess>336523bf-3077-4287-8c04-afb5fc573bfc</onsuccess></stage><stage stageid="863b245b-eec8-47fb-9661-c30e2fd15056" name="End" type="End"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="15" y="60" w="120" h="60" /><outputs><output type="flag" name="Success Flag" stage="Success" /><output type="text" name="Exception Message" stage="Exception Message" /><output type="text" name="Mail GUID" stage="Mail_GUID" /></outputs></stage><stage stageid="336523bf-3077-4287-8c04-afb5fc573bfc" name="Reply to a mail" type="Code"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="15" y="-30" w="150" h="60" /><inputs><input type="text" name="in_Mail_ID" expr="[Mail ID]" /><input type="text" name="in_To" expr="[To]" /><input type="text" name="in_CC" expr="[CC]" /><input type="text" name="in_Subject" expr="[Subject]" /><input type="text" name="in_Message" expr="[Message]" /><input type="flag" name="in_Body_Type" expr="[BodyIsHTML]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Exception Message" stage="Exception Message" /><output type="text" name="Mail_GUID" stage="Mail_GUID" /></outputs><onsuccess>863b245b-eec8-47fb-9661-c30e2fd15056</onsuccess><code><![CDATA[InitExchangeService();
bool replyToAll = false;

Mail_GUID = "";

try
{

	PropertySet props = new PropertySet(EmailMessageSchema.MimeContent);
	EmailMessage email = EmailMessage.Bind(service,in_Mail_ID, props);
	ResponseMessage responseMessage = email.CreateReply(replyToAll);
	foreach(String ToEmail in in_To.Split(';'))
	{
		if(!String.IsNullOrWhiteSpace(ToEmail))
		{
			responseMessage.ToRecipients.Add(ToEmail.Trim());
		}
	}

	foreach(String CcEmail in in_CC.Split(';'))
	{
		if(!String.IsNullOrWhiteSpace(CcEmail))
		{
			responseMessage.CcRecipients.Add(CcEmail.Trim());
		}
	}

	responseMessage.BodyPrefix = in_Message;

	if(!String.IsNullOrWhiteSpace(in_Subject))
			responseMessage.Subject = in_Subject;

	/*if(in_Body_Type)

		email.Body.BodyType = BodyType.HTML;
	}
	else
	{
		email.Body.BodyType = BodyType.Text;
	}*/

	Random RNG = new Random();
	var builder = new System.Text.StringBuilder();

	while (builder.Length < 16)
	  builder.Append(RNG.Next(10).ToString());
	  
	Mail_GUID=builder.ToString();

	Guid myPropertySetId = new Guid("{20B5C09F-7CAD-44c6-BDBF-8FCBEEA08544}"); 
	ExtendedPropertyDefinition myExtendedPropertyDefinition = new ExtendedPropertyDefinition(myPropertySetId, "MyExtendedPropertyName", MapiPropertyType.String); 
	email.SetExtendedProperty(myExtendedPropertyDefinition, Mail_GUID);

	responseMessage.SendAndSaveCopy();

	Success = true;
	Exception_Message = "";
}
catch(Exception e)
{
	Exception_Message = e.Message;
	Success = false;
}]]></code></stage><stage stageid="72174180-0590-4bb7-b45c-54d90f585f3d" name="Mail ID" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="966efb9f-fc8a-414f-92f1-a1463116f95f" name="To" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="-195" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="168e1d84-5eda-4f56-8045-7d34794ea28b" name="CC" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="873acf02-a76a-4cd9-9b66-5b5858bce306" name="Message" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="-195" y="120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2b3fef5a-09ef-4ab6-adbf-6c9e259a84f4" name="BodyIsHTML" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="-195" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3efde48c-330c-415e-a897-a7c233d3fea9" name="Mail_GUID" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><display x="255" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="819d5138-7f27-4179-a47e-66c49da2f5cd" name="Success" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><display x="255" y="-15" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a2755bef-e0e6-437f-8eb9-bb1c3eab156f" name="Exception Message" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><display x="255" y="-105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3950e456-97d0-4bd7-9d11-f8337eefb18a" name="Input" type="Block"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="285" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6af36572-d63f-4284-9145-bdebe1e0ad58" name="Output" type="Block"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><loginhibit /><display x="180" y="-135" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="05c6bd48-92db-4556-aef9-29c5cead205e" name="Subject" type="Data"><subsheetid>39027306-5017-49d3-90e7-4f7b8452db76</subsheetid><display x="-195" y="210" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="557a3fa9-9a3f-442b-b2d8-3af2b49178ed" name="Mail IsRead" type="SubSheetInfo"><subsheetid>51a26f44-04dc-4ae8-9980-4bf022e288db</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b2263ae1-1d80-4b6d-af30-4c98ce621d58" name="Start" type="Start"><subsheetid>51a26f44-04dc-4ae8-9980-4bf022e288db</subsheetid><loginhibit /><display x="15" y="-105" w="120" h="60" /><inputs><input type="text" name="Mail ID" stage="Mail ID" /></inputs><onsuccess>cbe56b88-de60-4a30-a0b4-e666f2105d5c</onsuccess></stage><stage stageid="2e33578d-d1fd-4884-a418-20ef65caa63c" name="End" type="End"><subsheetid>51a26f44-04dc-4ae8-9980-4bf022e288db</subsheetid><loginhibit /><display x="15" y="45" w="120" h="60" /><outputs><output type="flag" name="IsRead" stage="IsRead" /></outputs></stage><stage stageid="cbe56b88-de60-4a30-a0b4-e666f2105d5c" name="Is Read?" type="Code"><subsheetid>51a26f44-04dc-4ae8-9980-4bf022e288db</subsheetid><loginhibit /><display x="15" y="-30" w="150" h="60" /><inputs><input type="text" name="in_Mail_ID" expr="[Mail ID]" /></inputs><outputs><output type="flag" name="is_Read" stage="IsRead" /></outputs><onsuccess>2e33578d-d1fd-4884-a418-20ef65caa63c</onsuccess><code><![CDATA[PropertySet props = new PropertySet(EmailMessageSchema.IsRead);
EmailMessage email = EmailMessage.Bind(service,in_Mail_ID, props);
is_Read = email.IsRead;]]></code></stage><stage stageid="e664faa3-dd2e-47aa-b320-0909120a8936" name="Mail ID" type="Data"><subsheetid>51a26f44-04dc-4ae8-9980-4bf022e288db</subsheetid><display x="-195" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9248be37-b913-4ad9-9f18-5e6ba16f7d87" name="IsRead" type="Data"><subsheetid>51a26f44-04dc-4ae8-9980-4bf022e288db</subsheetid><display x="-195" y="60" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="494279f8-9df0-4e01-9ed3-f68e5aa7768d" name="Block1" type="Block"><subsheetid>51a26f44-04dc-4ae8-9980-4bf022e288db</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5e1fccc2-5166-4859-8e85-01e52595528f" name="Block2" type="Block"><subsheetid>51a26f44-04dc-4ae8-9980-4bf022e288db</subsheetid><loginhibit /><display x="-270" y="30" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="33e7e238-80ba-47a9-b526-093ac164fd9f" name="Reply To" type="SubSheetInfo"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="3f2571b6-c924-4a49-a32c-837ff7f1ede8" name="Start" type="Start"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="15" y="-120" w="120" h="60" /><inputs><input type="text" name="Mail ID" stage="Mail ID" /><input type="text" name="To" stage="To" /><input type="text" name="CC" stage="CC" /><input type="text" name="Subject" stage="Subject" /><input type="text" name="Message" stage="Message" /><input type="flag" name="BodyIsHTML" stage="BodyIsHTML" /></inputs><onsuccess>cb989cda-6534-4724-82cc-2661c44266b0</onsuccess></stage><stage stageid="f8d4c4ca-2440-4f17-ad87-3af6c58689dc" name="End" type="End"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="15" y="60" w="120" h="60" /><outputs><output type="flag" name="Success Flag" stage="Success" /><output type="text" name="Exception Message" stage="Exception Message" /><output type="text" name="Mail GUID" stage="Mail_GUID" /></outputs></stage><stage stageid="cb989cda-6534-4724-82cc-2661c44266b0" name="Forward Email" type="Code"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="15" y="-30" w="150" h="60" /><inputs><input type="text" name="in_Mail_ID" expr="[Mail ID]" /><input type="text" name="in_To" expr="[To]" /><input type="text" name="in_CC" expr="[CC]" /><input type="text" name="in_Subject" expr="[Subject]" /><input type="text" name="in_Message" expr="[Message]" /><input type="flag" name="in_Body_Type" expr="[BodyIsHTML]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Exception Message" stage="Exception Message" /><output type="text" name="Mail_GUID" stage="Mail_GUID" /></outputs><onsuccess>f8d4c4ca-2440-4f17-ad87-3af6c58689dc</onsuccess><code><![CDATA[InitExchangeService();

Mail_GUID = "";

try
{

	PropertySet props = new PropertySet(EmailMessageSchema.MimeContent);
	EmailMessage email = EmailMessage.Bind(service,in_Mail_ID, props);
	ResponseMessage responseMessage = email.CreateForward();
	foreach(String ToEmail in in_To.Split(';'))
	{
		if(!String.IsNullOrWhiteSpace(ToEmail))
		{
			responseMessage.ToRecipients.Add(ToEmail.Trim());
		}
	}

	foreach(String CcEmail in in_CC.Split(';'))
	{
		if(!String.IsNullOrWhiteSpace(CcEmail))
		{
			responseMessage.CcRecipients.Add(CcEmail.Trim());
		}
	}

	responseMessage.BodyPrefix = in_Message;

	if(!String.IsNullOrWhiteSpace(in_Subject))
			responseMessage.Subject = in_Subject;

	/*if(in_Body_Type)

		email.Body.BodyType = BodyType.HTML;
	}
	else
	{
		email.Body.BodyType = BodyType.Text;
	}*/

	Random RNG = new Random();
	var builder = new System.Text.StringBuilder();

	while (builder.Length < 16)
	  builder.Append(RNG.Next(10).ToString());
	  
	Mail_GUID=builder.ToString();

	Guid myPropertySetId = new Guid("{20B5C09F-7CAD-44c6-BDBF-8FCBEEA08544}"); 
	ExtendedPropertyDefinition myExtendedPropertyDefinition = new ExtendedPropertyDefinition(myPropertySetId, "MyExtendedPropertyName", MapiPropertyType.String); 
	email.SetExtendedProperty(myExtendedPropertyDefinition, Mail_GUID);

	responseMessage.SendAndSaveCopy();

	Success = true;
	Exception_Message = "";
}
catch(Exception e)
{
	Exception_Message = e.Message;
	Success = false;
}]]></code></stage><stage stageid="b060e4aa-bf4a-4202-9db3-57b21ea810dd" name="Mail ID" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e5cac85e-2e7d-4331-b627-803cb53f6084" name="To" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="-195" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3ca6f459-7aba-43da-b548-235b6a30b98b" name="CC" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b8bb971-e206-47ae-ba1c-1e931f51404d" name="Message" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="-195" y="120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d7340e1e-04be-47f8-b26d-5a6fca271b76" name="BodyIsHTML" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="-195" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ac0c88b2-4e54-4782-bda1-3c5e6063bd32" name="Mail_GUID" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><display x="255" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3b8c2c8a-94c2-4a55-adca-88e9388517b9" name="Success" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><display x="255" y="-15" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7212dae3-a9bc-483b-a255-1963a5997823" name="Exception Message" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><display x="255" y="-105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f7db4aad-38a2-4977-a6bd-ed391b1cf5d0" name="Input" type="Block"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="285" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6ac0f7ec-6c21-43d0-a012-4e77269503b1" name="Output" type="Block"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><loginhibit /><display x="180" y="-135" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6190bfea-54e0-43eb-a3b0-dcf216059101" name="Subject" type="Data"><subsheetid>b7d593e2-15d0-4746-a46d-d870ac9565b7</subsheetid><display x="-195" y="210" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6a1b9887-8751-429d-a536-e08667a451dc" name="Send Mail with Logo" type="SubSheetInfo"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="-195" y="-195" w="150" h="90" /></stage><stage stageid="39906108-c57c-4def-a879-7fabd10eae75" name="Start" type="Start"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><loginhibit /><display x="15" y="-135" w="120" h="60" /><inputs><input type="text" name="Subject" stage="Subject" /><input type="text" name="Body" stage="Body" /><input type="text" name="To" stage="To" /><input type="text" name="CC" stage="CC" /><input type="text" name="Replace_Word" stage="Replace_Word" /><input type="number" name="Height" stage="Height" /><input type="number" name="Width" stage="Width" /><input type="text" name="Image Path" stage="File Path" /></inputs><onsuccess>26dde112-06a3-4579-bf44-7314e80927c5</onsuccess></stage><stage stageid="66effe05-b4dc-4f49-926d-44029f64f5e0" name="End" type="End"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><loginhibit /><display x="15" y="75" w="120" h="60" /><outputs><output type="text" name="Mail_GUID" stage="Mail_GUID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Exception_Message" stage="Exception_Message " /></outputs></stage><stage stageid="26dde112-06a3-4579-bf44-7314e80927c5" name="Send Email with Logo Inline" type="Code"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><loginhibit /><display x="15" y="-30" w="150" h="60" /><inputs><input type="text" name="in_To" expr="[To]" /><input type="text" name="in_CC" expr="[CC]" /><input type="text" name="in_Subject" expr="[Subject]" /><input type="text" name="in_Body" expr="[Body]" /><input type="text" name="Replace_Word" expr="[Replace_Word]" /><input type="text" name="Inline_Image" expr="[File Path]" /><input type="number" name="Image_Height" expr="[Height]" /><input type="number" name="Image_Width" expr="[Width]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Mail_GUID" stage="Mail_GUID" /><output type="text" name="Exception_Message" stage="Exception_Message " /></outputs><onsuccess>66effe05-b4dc-4f49-926d-44029f64f5e0</onsuccess><code><![CDATA[InitExchangeService();

Mail_GUID = "";
try
{
	string fileName = Path.GetFileName(Inline_Image);

	string Image = String.Format(@"<br /><img width={0} height={1} id=""1"" src=""cid:{2}""><br />",Image_Width,Image_Height,fileName);

	in_Body = in_Body.Replace(Replace_Word,Image);

	EmailMessage email = new EmailMessage(service);

	foreach(String ToEmail in in_To.Split(';'))
		{
			if(!String.IsNullOrWhiteSpace(ToEmail))
			{
				email.ToRecipients.Add(ToEmail.Trim());
			}
		}

	foreach(String CcEmail in in_CC.Split(';'))
	{
		if(!String.IsNullOrWhiteSpace(CcEmail))
		{
			email.CcRecipients.Add(CcEmail.Trim());
		}
	}

	email.Subject = in_Subject;
	email.Body = new MessageBody(BodyType.HTML, in_Body);

	email.Attachments.AddFileAttachment(fileName, Inline_Image);
	email.Attachments[0].IsInline = true;
	email.Attachments[0].ContentId = fileName;
	//email.SendAndSaveCopy();

	Random RNG = new Random();
	var builder = new System.Text.StringBuilder();
	while (builder.Length < 16) 
	{
	  builder.Append(RNG.Next(10).ToString());
	}

	Mail_GUID=builder.ToString();

	Guid myPropertySetId = new Guid("{20B5C09F-7CAD-44c6-BDBF-8FCBEEA08544}"); 
	ExtendedPropertyDefinition myExtendedPropertyDefinition = new ExtendedPropertyDefinition(myPropertySetId, "MyExtendedPropertyName", MapiPropertyType.String); 
	email.SetExtendedProperty(myExtendedPropertyDefinition, Mail_GUID); 
	email.SendAndSaveCopy();

	//email.SendAndSaveCopy();

	Success = true;
	Exception_Message = "";
}
catch(Exception e)
{
	Success = false;
	Exception_Message = e.Message;
}]]></code></stage><stage stageid="cbffef82-19a3-4a3d-9b04-b6109ee0b2ba" name="To" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><loginhibit /><display x="-195" y="-60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="87181541-238e-4ea7-99d9-7e5074b14bb4" name="CC" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><loginhibit /><display x="-195" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="00798b1a-3f79-4efd-a868-f97a4bc19fa2" name="Subject" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="-195" y="75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="52bb94b2-6307-4ef4-ac4e-3de7a350e1ae" name="Body" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="-195" y="-105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0cbb7e0-2276-482d-8865-06ce4a889bdf" name="File Path" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="-195" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f1e28c7f-001e-4207-a558-bbeb9b9d94bf" name="Input" type="Block"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><loginhibit /><display x="-270" y="-135" w="150" h="375" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9681d6ea-3d21-4900-adf8-44e3b2754d30" name="Height" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="-195" y="120" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="92013d7b-6994-46b4-a599-6c96436ae9a2" name="Width" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="-195" y="165" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c1231046-cc69-48b5-a43a-bc725fefae23" name="Mail_GUID" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="195" y="-120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6083ed25-c254-4f4d-b5c4-2047b0a707c8" name="Success" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="195" y="-30" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fa4b8650-96e0-4c7a-908e-66249db13577" name="Exception_Message " type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="195" y="-75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c5af2f8-73ad-4e06-8efc-a5525a7ddb4f" name="Output" type="Block"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><loginhibit /><display x="120" y="-150" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="832ce9e7-323b-4e63-a517-3f1301ac5933" name="Replace_Word" type="Data"><subsheetid>19386185-47c5-4e8f-b2c0-cf5f9eb4e386</subsheetid><display x="-195" y="210" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a6997f33-026a-42a2-9604-6f11aafffed6" name="Reply All with Attachments" type="SubSheetInfo"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="bd14ab30-6bfe-4bd4-94bd-5c6d4f11ec0f" name="Start" type="Start"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><loginhibit /><display x="15" y="-120" w="120" h="60" /><inputs><input type="text" name="Mail ID" stage="Mail ID" /><input type="text" name="Subject" stage="Subject" /><input type="text" name="Message" stage="Message" /><input type="flag" name="BodyIsHTML" stage="BodyIsHTML" /><input type="text" name="Attachments" stage="Attachments" /></inputs><onsuccess>41ca192d-1290-4c53-9ff3-28919b451d78</onsuccess></stage><stage stageid="83bb096a-3267-40ab-b971-0b298a28067a" name="End" type="End"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><loginhibit /><display x="15" y="60" w="120" h="60" /><outputs><output type="flag" name="Success Flag" stage="Success" /><output type="text" name="Exception Message" stage="Exception Message" /><output type="text" name="Mail GUID" stage="Mail_GUID" /></outputs></stage><stage stageid="41ca192d-1290-4c53-9ff3-28919b451d78" name="Reply All With Attachments" type="Code"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><loginhibit /><display x="15" y="-30" w="150" h="60" /><inputs><input type="text" name="in_Mail_ID" expr="[Mail ID]" /><input type="text" name="in_Subject" expr="[Subject]" /><input type="text" name="in_Message" expr="[Message]" /><input type="flag" name="in_Body_Type" expr="[BodyIsHTML]" /><input type="text" name="Attachments" expr="[Attachments]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Exception Message" stage="Exception Message" /><output type="text" name="Mail_GUID" stage="Mail_GUID" /></outputs><onsuccess>83bb096a-3267-40ab-b971-0b298a28067a</onsuccess><code><![CDATA[InitExchangeService();
bool replyToAll = true;

Mail_GUID = "";

try
{

	PropertySet props = new PropertySet(EmailMessageSchema.MimeContent);
	EmailMessage email = EmailMessage.Bind(service,in_Mail_ID, props);
	ResponseMessage responseMessage = email.CreateReply(replyToAll);
	
	responseMessage.BodyPrefix = in_Message;

	if(!String.IsNullOrWhiteSpace(in_Subject))
			responseMessage.Subject = in_Subject;
			
	if(Attachments!=""){
		foreach(String Attachment in Attachments.Split(';'))
		{
			//message.Attachments.AddFileAttachment(Attachment);
			var replyMessage = responseMessage.Save(WellKnownFolderName.Drafts);
			replyMessage.Attachments.AddFileAttachment(Attachment);
			replyMessage.Update(ConflictResolutionMode.AlwaysOverwrite);
			replyMessage.SendAndSaveCopy();
		}
	}
			
	
	/*if(in_Body_Type)

		email.Body.BodyType = BodyType.HTML;
	}
	else
	{
		email.Body.BodyType = BodyType.Text;
	}*/

	Random RNG = new Random();
	var builder = new System.Text.StringBuilder();

	while (builder.Length < 16)
	  builder.Append(RNG.Next(10).ToString());
	  
	Mail_GUID=builder.ToString();

	Guid myPropertySetId = new Guid("{20B5C09F-7CAD-44c6-BDBF-8FCBEEA08544}"); 
	ExtendedPropertyDefinition myExtendedPropertyDefinition = new ExtendedPropertyDefinition(myPropertySetId, "MyExtendedPropertyName", MapiPropertyType.String); 
	email.SetExtendedProperty(myExtendedPropertyDefinition, Mail_GUID);

	//responseMessage.SendAndSaveCopy();
	
	
	Success = true;
	Exception_Message = "";
}
catch(Exception e)
{
	Exception_Message = e.Message;
	Success = false;
}]]></code></stage><stage stageid="53b35b3c-d862-418b-85d3-66805aab2818" name="Mail ID" type="Data"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><loginhibit /><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f5dff7bd-1fff-4b3d-ab3f-b6fd0a24f424" name="To" type="Data"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><loginhibit /><display x="-195" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8a769243-24fa-40b9-8552-ed0fe813bd93" name="CC" type="Data"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><loginhibit /><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5d49943c-f95d-4307-89b6-fb35f9ebb149" name="Message" type="Data"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><loginhibit /><display x="-195" y="120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a6e64b21-f65a-40a7-a22d-dcb8fda168a8" name="BodyIsHTML" type="Data"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><loginhibit /><display x="-195" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2a19a1dd-37cb-4d8e-a685-1df5bc775319" name="Mail_GUID" type="Data"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><display x="255" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f0aef81c-2fd1-4630-93ee-21c847c662df" name="Success" type="Data"><subsheetid>8d5ea333-0429-4fd4-8a09-854ab928d91a</subsheetid><display x="255" y="-15" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="560ab305-b78f-4ee9-8313-83ac599de614" name="Exception Message" type="Data"><subsheetid>8d5e