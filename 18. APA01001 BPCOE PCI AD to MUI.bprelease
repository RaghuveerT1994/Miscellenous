d234" type="Normal" published="True"><name>List Mails from Within DateTimes (Shared Folder)</name><view><camerax>128</camerax><cameray>-21</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="ef079fc7-1657-40bd-89ae-f677fd33cba9" type="Normal" published="True"><name>Mark Email As Read/Unread</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="08bd7af7-de0c-4876-9674-f7cf3e288d1c" type="Normal" published="True"><name>List Mails from Shared Draft Folder</name><view><camerax>0</camerax><cameray>64</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="610531b7-ee7f-4319-807d-8e57b3852369" type="Normal" published="True"><name>Send Mails from Drafts</name><view><camerax>-107</camerax><cameray>-16</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="1bf6b382-291c-4f70-9c76-484af0bf01eb" type="Normal" published="True"><name>List Mail from Draft Folder</name><view><camerax>0</camerax><cameray>42</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="3257eb2f-ad1b-463b-a22b-2de6e68cd15f" type="Normal" published="True"><name>Send Mails from Shared Drafts</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="380e7deb-7b14-491f-aadd-b4e47deb6d5f" name="Start" type="Start"><loginhibit /><display x="15" y="-105" /><onsuccess>52ae4b05-d807-4762-8067-17a21428d8d2</onsuccess></stage><stage stageid="52ae4b05-d807-4762-8067-17a21428d8d2" name="End" type="End"><loginhibit /><display x="15" y="90" /></stage><stage stageid="5f8f1c40-dd3d-45d7-83b4-090eeeb8eff5" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><references><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference><reference>C:\Program Files\Microsoft\Exchange\Web Services\2.2\Microsoft.Exchange.WebServices.dll</reference><reference>C:\Program Files\Microsoft\Exchange\Web Services\2.2\Microsoft.Exchange.WebServices.Auth.dll</reference><reference>System.dll</reference><reference>System.Core.dll</reference><reference>System.Windows.Forms.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>Microsoft.Exchange.WebServices.Data</import><import>System.Data</import><import>System.Security</import><import>System.Text.RegularExpressions</import><import>System.IO</import><import>System.Collections.ObjectModel</import><import>System.Windows.Forms</import></imports><language>csharp</language><globalcode><![CDATA[]]></globalcode><code><![CDATA[private ExchangeVersion ExchangeVersionResolved;
private bool UseWindowsCredentials;
private String Username;
private String Password;
private String ExchangeEndpointURL;
private ExchangeService service;

private void SetConfigurationParameters(bool UseWindowsCredentials_, String Username_, String Password_, String ExchangeEndpointURL_){
	UseWindowsCredentials = UseWindowsCredentials_;
	
	Username = Username_;
	
	//SecureString Password = new SecureString();
	//Array.ForEach(Password_.ToArray(), Password.AppendChar);
	//Password.MakeReadOnly();
	Password = Password_;
	
	ExchangeEndpointURL = ExchangeEndpointURL_;
}

private void InitExchangeService(){
	//Create Exchange Service with version provided in configuration
	service = new ExchangeService(ExchangeVersionResolved);
     service.KeepAlive=false;
	//Set credentials as specified in configuration
	if (UseWindowsCredentials)
	{
		service.UseDefaultCredentials = true;
	}
	else {
		service.Credentials = new WebCredentials(Username, Password);
	}

	//Set Exchange Endpoint URL as specified in configuration
	service.Url = new System.Uri(ExchangeEndpointURL);
}

private FolderId getFolderIDByName(String FolderName, ExchangeService s) {
	FolderView view = new FolderView(int.MaxValue);
	view.PropertySet = new PropertySet(BasePropertySet.IdOnly);
	view.PropertySet.Add(FolderSchema.DisplayName);
	view.Traversal = FolderTraversal.Deep;
	FindFoldersResults findFolderResults = s.FindFolders(WellKnownFolderName.Root, view);
	
	foreach (Folder f in findFolderResults)
	{
		if (f.DisplayName.Equals(FolderName, StringComparison.OrdinalIgnoreCase))
			return f.Id;
	}
	
	return null;
}

 private DataTable ConvertHTMLTablesToDataSet(string HTML)
    { 
        DataSet ds = new DataSet();
        DataTable dt = null;
        DataRow dr = null;
        DataColumn dc = null;
        string TableExpression = "<table[^>]*>(.*?)</table>";
        string HeaderExpression = "<th[^>]*>(.*?)";
        string RowExpression = "<tr[^>]*>(.*?)";
        string ColumnExpression = "<td[^>]*>(.*?)";
        bool HeadersExist = false;
        int iCurrentColumn = 0;
        int iCurrentRow = 0;
 
       
        MatchCollection Tables = Regex.Matches(HTML, TableExpression, RegexOptions.Multiline | RegexOptions.Singleline | RegexOptions.IgnoreCase);
 
        
        foreach (Match Table in Tables)
        {
		
            iCurrentRow = 0;
            HeadersExist = false;
 
           
            dt = new DataTable();
 
          
            if (Table.Value.Contains("<th"))
            {
                
                HeadersExist = true;
 
                
                MatchCollection Headers = Regex.Matches(Table.Value, HeaderExpression, RegexOptions.Multiline | RegexOptions.Singleline | RegexOptions.IgnoreCase);
 
                
                foreach (Match Header in Headers)
                {
                    dt.Columns.Add(Header.Groups[1].ToString());
                }
            }
            else
            {
                for (int iColumns = 1; iColumns <= Regex.Matches(Regex.Matches(Regex.Matches(Table.Value, TableExpression, RegexOptions.Multiline | RegexOptions.Singleline | RegexOptions.IgnoreCase)[0].ToString(), RowExpression, RegexOptions.Multiline | RegexOptions.Singleline | RegexOptions.IgnoreCase)[0].ToString(), ColumnExpression, RegexOptions.Multiline | RegexOptions.Singleline | RegexOptions.IgnoreCase).Count; iColumns++)
                {
                    dt.Columns.Add("Column " + iColumns);
                }
            }
 

            //Get a match for all the rows in the table 
 
            MatchCollection Rows = Regex.Matches(Table.Value, RowExpression, RegexOptions.Multiline | RegexOptions.Singleline | RegexOptions.IgnoreCase);
 
            // Loop through each row element 
            foreach (Match Row in Rows)
            {
                // Only loop through the row if it isn't a header row 
                if (!(iCurrentRow == 0 && HeadersExist))
                {
                    // Create a new row and reset the current column counter 
                    dr = dt.NewRow();
                    iCurrentColumn = 0;
 
                    // Get a match for all the columns in the row 
                    MatchCollection Columns = Regex.Matches(Row.Value, ColumnExpression, RegexOptions.Multiline | RegexOptions.Singleline | RegexOptions.IgnoreCase);
 
                    // Loop through each column element 
                    foreach (Match Column in Columns)
                    {
                        // Add the value to the DataRow 
                        dr[iCurrentColumn] = Column.Groups[1].ToString();
 
                        // Increase the current column  
                        iCurrentColumn++;
                    }
 
                    // Add the DataRow to the DataTable 
                    dt.Rows.Add(dr);
 
                }
 
                // Increase the current row counter 
                iCurrentRow++;
            }
 

            // Add the DataTable to the DataSet 
            
			return dt;
			//ds.Tables.Add(dt);
 
        }
        //GridView1.DataSource = ds;
       // GridView1.DataBind();
	    return null;
       // return ds;
 
    }
]]></code></stage><stage stageid="ad8cfd54-8687-4498-a262-bfb0a49735fb" name="Clean Up" type="SubSheetInfo"><subsheetid>c3678b8f-10aa-473c-b402-f7039c7a8a2d</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="7e712942-21f9-4134-bbcd-d5591eda0ab8" name="Start" type="Start"><subsheetid>c3678b8f-10aa-473c-b402-f7039c7a8a2d</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>c97f21ad-bd58-4d6a-894c-06de8dac51da</onsuccess></stage><stage stageid="c97f21ad-bd58-4d6a-894c-06de8dac51da" name="End" type="End"><subsheetid>c3678b8f-10aa-473c-b402-f7039c7a8a2d</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="0cecd536-72b8-4157-9e50-13da099ba921" name="Configure" type="SubSheetInfo"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="71f5270c-ea96-47ae-a4fe-3b0669a3c401" name="Note1" type="Note"><subsheetid>c3678b8f-10aa-473c-b402-f7039c7a8a2d</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="eb343c59-1ef3-464a-b003-5b55a3ee83fa" name="Note2" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="70bad860-a41b-46b7-b022-ae2ce9f056d2" name="End" type="End"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><loginhibit /><display x="15" y="225" /></stage><stage stageid="ae69030c-53a6-4b5d-8268-4fb92b2200ab" name="Username" type="Data"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><display x="-210" y="75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="13ea0679-fdc8-4c54-bd68-8161bba3bc94" name="Password" type="Data"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><display x="-210" y="120" w="120" h="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="63b92b59-923d-48dd-8ed3-815e198bfe5d" name="Start" type="Start"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="flag" name="UseWindowsCredentials" narrative="Use Windows credentials of currently logged on user instead of providing separate credentials" stage="UseWindowsCredentials" /><input type="text" name="Username" narrative="The username to authenticate with Exchange " stage="Username" /><input type="password" name="Password" narrative="The password to authenticate with Exchange " stage="Password" /></inputs><onsuccess>45f73efc-d4e4-4e89-9b2a-4af4bc47f369</onsuccess></stage><stage stageid="851c0e34-eefa-40a7-8421-23bc054fc939" name="UseWindowsCredentials" type="Data"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><display x="-210" y="15" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="3ab95970-3b40-4144-9769-ae22624c8994" name="ExchangeEndpointURL" type="Data"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><narrative>https://mail.bt.com/EWS/Exchange.asmx-&gt; New URL</narrative><display x="330" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">https://mail.bt.com/EWS/Exchange.asmx</initialvalue><private /><alwaysinit /></stage><stage stageid="c5590c68-4abc-434a-8372-8514c148d0c6" name="ExchangeVersion" type="Data"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><display x="330" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Exchange2013_SP1</initialvalue><private /><alwaysinit /></stage><stage stageid="45f73efc-d4e4-4e89-9b2a-4af4bc47f369" name="CheckExchangeVersion" type="Code"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><loginhibit /><display x="15" y="-45" w="120" h="30" /><inputs><input type="text" name="ExchangeVersion" expr="[ExchangeVersion]" /></inputs><onsuccess>487bffc6-ec1d-445d-a24f-2221fc26c37c</onsuccess><code><![CDATA[if (!Enum.TryParse(ExchangeVersion, out ExchangeVersionResolved))
{
	throw new Exception(ExchangeVersion + " is not a supported value for ExchangeVersion. Please provide a supported value.");
}]]></code></stage><stage stageid="5d0172e0-6090-4469-9d58-9bb314ffa55d" name="Set Configured" type="Calculation"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><loginhibit /><display x="15" y="165" w="120" h="30" /><onsuccess>70bad860-a41b-46b7-b022-ae2ce9f056d2</onsuccess><calculation expression="True" stage="isConfigured" /></stage><stage stageid="341d277d-1447-4aa4-8d44-8288ffdb5097" name="isConfigured" type="Data"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><loginhibit /><display x="135" y="165" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><alwaysinit /></stage><stage stageid="487bffc6-ec1d-445d-a24f-2221fc26c37c" name="Are Credentials Provided?" type="Decision"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><loginhibit /><display x="15" y="30" w="90" h="60" /><decision expression="[UseWindowsCredentials] OR [Username]&lt;&gt;&quot;&quot;" /><ontrue>86581ede-2f94-4744-bc55-610a1139c901</ontrue><onfalse>68c9e33a-7ca3-45c5-bc80-dad3beb92baf</onfalse></stage><stage stageid="68c9e33a-7ca3-45c5-bc80-dad3beb92baf" name="Credentials not provided" type="Exception"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><display x="150" y="30" w="90" h="30" /><exception type="System Exception" detail="&quot;Could not authenticate with Exchange. Please provide credentials or use Windows credentials.&quot;" /></stage><stage stageid="8900b77d-a795-4f02-8907-fbaf065f7d7f" name="Send Mail" type="SubSheetInfo"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="6e3cd1e9-90a1-446c-82a1-42b5e71dfcab" name="Start" type="Start"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><loginhibit /><display x="15" y="-180" /><inputs><input type="text" name="To" narrative="The email address of the recipient. To address multiple recipients use the format &quot;john.smith@example.com;henry.jones@example.com&quot;." stage="To" /><input type="text" name="BCC" stage="BCC" /><input type="text" name="CC" narrative="The email address of the CC recipient. To address multiple recipients use the format &quot;john.smith@example.com; henry.jones@example.com&quot;." stage="CC" /><input type="text" name="Subject" narrative="The subject of the email." stage="Subject" /><input type="text" name="Message" narrative="The body of the email." stage="Message" /><input type="text" name="Attachments" narrative="Text containing a list of files to add to the email as attachments, Seperated by Semicolon." stage="Attachments" /><input type="flag" name="BodyIsHTML" narrative="Indicates if the body should be sent as HTML" stage="BodyIsHTML" /></inputs><onsuccess>c843dc90-2426-493c-9546-0817e03a4a0b</onsuccess></stage><stage stageid="d248bb86-a623-48ec-8211-3ca8e5213908" name="End" type="End"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><loginhibit /><display x="15" y="30" /><outputs><output type="text" name="Error Message" stage="Error Message" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Mail GUID" stage="Mail GUID" /></outputs></stage><stage stageid="1ab0120b-b05b-4830-a7c8-41ece2f019fb" name="To" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="286f957d-03a7-46c4-8141-204acb8106c7" name="Subject" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-150" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3245afb7-3223-4300-bdd7-da2c4ab11297" name="Send Message" type="Code"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="Subject" expr="[Subject]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Attachments" expr="[Attachments]" /><input type="text" name="BCC" expr="[BCC]" /><input type="flag" name="BodyIsHTML" expr="[BodyIsHTML]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /><output type="text" name="Mail GUID" stage="Mail GUID" /></outputs><onsuccess>d248bb86-a623-48ec-8211-3ca8e5213908</onsuccess><code><![CDATA[InitExchangeService();

Success=false;
Error_Message="Unable to Send Mail";
	
try{
// Create an email message and provide it with connection configuration information by using an ExchangeService object named service.
EmailMessage message = new EmailMessage(service);

// Set properties on the email message.
	//if(!String.IsNullOrWhiteSpace(From))
	//	message.From = From;

	message.Subject = Subject;

	message.Body = Message;

	foreach(String ToEmail in To.Split(';')){
		if(!String.IsNullOrWhiteSpace(ToEmail))
			message.ToRecipients.Add(ToEmail.Trim());
	}

	foreach(String CCEmail in CC.Split(';')){
		if(!String.IsNullOrWhiteSpace(CCEmail))
			message.CcRecipients.Add(CCEmail.Trim());
	}
	
	foreach(String BCCEmail in BCC.Split(';')){
		if(!String.IsNullOrWhiteSpace(BCCEmail))
			message.BccRecipients.Add(BCCEmail.Trim());
	}

	if (BodyIsHTML)
	{
		message.Body.BodyType = BodyType.HTML;
	}
	else {
		message.Body.BodyType = BodyType.Text;
	}
    //foreach (DataRow dr in Attachments.Rows)
	//string file = dr[Attachment].ToString();
	
	
	if(Attachments!=""){
		foreach(String Attachment in Attachments.Split(';'))
		{
			message.Attachments.AddFileAttachment(Attachment);
		}
	}
// End set properties on the email message.


// Send the email message and save a copy.
// This method call results in a CreateItem call to EWS.

Random RNG = new Random();
var builder = new System.Text.StringBuilder();
while (builder.Length < 16) 
{
  builder.Append(RNG.Next(10).ToString());
}

Mail_GUID=builder.ToString();

Guid myPropertySetId = new Guid("{20B5C09F-7CAD-44c6-BDBF-8FCBEEA08544}"); 
ExtendedPropertyDefinition myExtendedPropertyDefinition = new ExtendedPropertyDefinition(myPropertySetId, "MyExtendedPropertyName", MapiPropertyType.String); 
message.SetExtendedProperty(myExtendedPropertyDefinition, Mail_GUID); 
message.SendAndSaveCopy();
Success=true;
Error_Message="";
}
catch(Exception ex)
{
	Success=false;
	Error_Message=ex.Message;
	Mail_GUID="";
}]]></code></stage><stage stageid="c843dc90-2426-493c-9546-0817e03a4a0b" name="isConfigured" type="Decision"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><loginhibit /><display x="15" y="-105" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>3245afb7-3223-4300-bdd7-da2c4ab11297</ontrue><onfalse>f089fb41-9ae1-4025-9aae-0be6acac909d</onfalse></stage><stage stageid="f089fb41-9ae1-4025-9aae-0be6acac909d" name="Not configured" type="Exception"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="135" y="-105" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="6c29c95a-5f05-441c-82fa-2effe24fa8b2" name="BodyIsHTML" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-225" y="150" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="63fd3aec-0aff-48c4-981d-cf43a51aa865" name="CC" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="86581ede-2f94-4744-bc55-610a1139c901" name="SetConfigurationData" type="Code"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><loginhibit /><display x="15" y="105" w="120" h="30" /><inputs><input type="flag" name="UseWindowsCredentials" expr="[UseWindowsCredentials]" /><input type="text" name="Username" expr="[Username]" /><input type="password" name="Password" expr="[Password]" /><input type="text" name="ExchangeEndpointURL" expr="[ExchangeEndpointURL]" /></inputs><onsuccess>5d0172e0-6090-4469-9d58-9bb314ffa55d</onsuccess><code><![CDATA[SetConfigurationParameters(UseWindowsCredentials, Username, Password, ExchangeEndpointURL);]]></code></stage><stage stageid="402277d7-8c08-4b36-9d56-a6f134805b0e" name="List Mails Within DateTimes" type="SubSheetInfo"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="e1f1bd9a-5070-4344-b3dd-c04267bf585b" name="Start" type="Start"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="flag" name="Unread Only?" narrative="If True than only get unread emails, otherwise get any" stage="Unread Only?" /><input type="text" name="Sub-Folder" narrative="Optional. The name of a sub-folder below the Inbox from which to get emails.  If not set the Inbox will be used." stage="Sub-Folder" /></inputs><onsuccess>76fa10b4-44e0-4d99-a66f-8c84393c4d1c</onsuccess></stage><stage stageid="b7338929-a284-4fc1-a426-6f2dd1c89a08" name="End" type="End"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="IDs" stage="IDs" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="76fa10b4-44e0-4d99-a66f-8c84393c4d1c" name="isConfigured" type="Decision"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><loginhibit /><display x="15" y="-45" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>a12525ee-98d6-4956-bc61-d7af45a02bb9</ontrue><onfalse>0b68e439-091e-49f7-a533-71ece4aa07d4</onfalse></stage><stage stageid="0b68e439-091e-49f7-a533-71ece4aa07d4" name="Not configured" type="Exception"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="135" y="-45" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="a12525ee-98d6-4956-bc61-d7af45a02bb9" name="List Messages" type="Code"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><loginhibit /><display x="15" y="30" w="90" h="30" /><inputs><input type="flag" name="Unread Only?" expr="[Unread Only?]" /><input type="text" name="Sub-Folder" expr="[Sub-Folder]" /></inputs><outputs><output type="collection" name="IDs" stage="IDs" /><output type="text" name="Error Message" stage="Error Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>b7338929-a284-4fc1-a426-6f2dd1c89a08</onsuccess><code><![CDATA[

InitExchangeService();
IDs = new DataTable();
int IDs_count;
try
{
// Bind the folder to the service object.
Folder TargetFolder;
if (String.IsNullOrWhiteSpace(Sub_Folder))
{
	TargetFolder = Folder.Bind(service, WellKnownFolderName.Inbox);
}
else {
	FolderId FID = getFolderIDByName(Sub_Folder, service);
	if (FID == null) {
		throw new Exception("Foldername invalid. Please provide a valid mail folder to search in.");
	}
	TargetFolder = Folder.Bind(service, FID);
}



// The search filter to get unread email.
//SearchFilter unreadsf = new SearchFilter.SearchFilterCollection(LogicalOperator.And, new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false));
SearchFilter unreadsf = new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false);

// The view to return
ItemView view;
view = new ItemView(int.MaxValue);

/*
if (MaxNumberOfResults == 0)
{
	view = new ItemView(int.MaxValue);
}
else {
	view = new ItemView(Convert.ToInt32(MaxNumberOfResults));
}
*/

view.PropertySet = new PropertySet(BasePropertySet.IdOnly, EmailMessageSchema.Subject, EmailMessageSchema.From, EmailMessageSchema.DateTimeSent);

// Fire the query for the unread items.
// This method call results in a FindItem call to EWS.
FindItemsResults<Item> findResults;

if (Unread_Only_)
{
	findResults = service.FindItems(TargetFolder.Id, unreadsf, view);
}
else { 
	findResults = service.FindItems(TargetFolder.Id, view);
}



IDs.Columns.Add("ID", typeof(string));
IDs.Columns.Add("From", typeof(string));
IDs.Columns.Add("Subject", typeof(string));
IDs.Columns.Add("DateTimeSent", typeof(DateTime));

IDs_count=0;
foreach(Item i in findResults){
	IDs.Rows.Add(i.Id, ((EmailMessage)i).From.Name, i.Subject, i.DateTimeSent);
    IDs_count++;
}


if(IDs_count>0)
{
 Success=true;
 Error_Message=""; 
}else
{
  Success=false;
  Error_Message="No mails found in the folder."; 
} 


}catch (ServiceResponseException ex) 
{ 
	Success=false;
	Error_Message=ex.Message; 
} 
]]></code></stage><stage stageid="6e5d2673-2c26-43b6-8129-43848a97bdfa" name="Save Attachment From Email" type="SubSheetInfo"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="81f9734d-6941-434b-8ab5-0ed66e9edd83" name="Start" type="Start"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Message ID" narrative="Unique message identifier" stage="Message ID" /><input type="text" name="File Name of Attachment" narrative="Name of Attachment" stage="File Name of Attachment" /><input type="text" name="File Path To Save Attachment" narrative="Windows File Directory/Folder" stage="File Path To Save Attachments" /><input type="text" name="Name Of Attachment To Save" narrative="Name of Attachment to find in email and save" stage="Name Of Attachment To Save" /></inputs><onsuccess>a017c822-3d13-43f4-93a9-35323fe7d4f0</onsuccess></stage><stage stageid="031eaec8-f8f4-4171-aed0-fb39ed6b0d20" name="End" type="End"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="510" /><outputs><output type="flag" name="HasAttachment" stage="HasAttachment" /></outputs></stage><stage stageid="af135a77-d336-4581-92b4-c2188922c109" name="Save Attachment" type="Code"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="390" w="120" h="30" /><inputs><input type="text" name="messageID" expr="[Message ID]" /><input type="text" name="filePath" expr="[File Path To Save Attachments]" /><input type="text" name="fileName" expr="[File Name of Attachment]" /><input type="text" name="attachmentName" expr="[Name Of Attachment To Save]" /></inputs><outputs><output type="flag" name="isSuccessfullySaved" stage="IsSuccessfullySaved" /></outputs><onsuccess>031eaec8-f8f4-4171-aed0-fb39ed6b0d20</onsuccess><code><![CDATA[isSuccessfullySaved=false;
InitExchangeService();
EmailMessage message = EmailMessage.Bind(service, new ItemId(messageID), new PropertySet(BasePropertySet.IdOnly, ItemSchema.Attachments));
foreach (Attachment attachment in message.Attachments)
            {
                if (attachment is FileAttachment && attachment.Name.Equals(attachmentName))
                {
                    FileAttachment fileAttachment = attachment as FileAttachment; 					
                    fileAttachment.Load(filePath + fileName);
					isSuccessfullySaved=true;
                }
			}]]></code></stage><stage stageid="29119221-09b2-4b2e-86c3-4f54f30948f1" name="Message ID" type="Data"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="-90" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="44817286-2199-4f13-ba74-3437754662ce" name="HasAttachment" type="Data"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="135" y="45" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a017c822-3d13-43f4-93a9-35323fe7d4f0" name="isConfigured" type="Decision"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>c5b6234d-846b-42e5-887d-f2a338d7dc34</ontrue><onfalse>011157fe-78b1-4e61-80c3-0f8dd4df7766</onfalse></stage><stage stageid="011157fe-78b1-4e61-80c3-0f8dd4df7766" name="Not configured" type="Exception"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="135" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="a3325c66-b7f0-484f-b755-6d02fdc27434" name="Get Oldest Unread Email" type="SubSheetInfo"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="19280ec8-7484-4ce9-a063-c02d168eee6a" name="Start" type="Start"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>021e83c7-e220-4b0a-9b05-75a99a2c926f</onsuccess></stage><stage stageid="6c253dd4-e14e-4fec-9d41-1443af1e27d9" name="End" type="End"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><loginhibit /><display x="15" y="225" /><outputs><output type="collection" name="Attachment Names" stage="Attachment Names" /><output type="datetime" name="Time Sent" stage="emailDateTimeSent" /><output type="flag" name="Has Attachments" stage="HasAttachments" /><output type="flag" name="Unread Email Found" stage="isUnreadEmailFound" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Email Subject" stage="emailSubject" /><output type="text" name="Message ID" stage="emailMessageID" /><output type="text" name="Email From Name" stage="emailFrom" /><output type="number" name="Number Of Attachments" stage="Number Of Attachments" /></outputs></stage><stage stageid="021e83c7-e220-4b0a-9b05-75a99a2c926f" name="isConfigured" type="Decision"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>7e4cd59a-05a4-4266-8a56-0e7bb874e7bd</ontrue><onfalse>03b196a7-9023-45e9-87d9-756a688ccf45</onfalse></stage><stage stageid="03b196a7-9023-45e9-87d9-756a688ccf45" name="Not configured" type="Exception"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="135" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="c5b6234d-846b-42e5-887d-f2a338d7dc34" name="Check If Message Has Attachment" type="Code"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="45" w="120" h="30" /><inputs><input type="text" name="messageID" expr="[Message ID]" /></inputs><outputs><output type="flag" name="HasAttachment" stage="HasAttachment" /></outputs><onsuccess>b4db8928-8076-4847-892b-6b63236780ab</onsuccess><code><![CDATA[InitExchangeService();
EmailMessage message = EmailMessage.Bind(service, new ItemId(messageID), new PropertySet(BasePropertySet.IdOnly, ItemSchema.Attachments));
HasAttachment=false;
if (!message.Attachments.Count.Equals(0)) {
      HasAttachment=true;      
	}]]></code></stage><stage stageid="b4db8928-8076-4847-892b-6b63236780ab" name="Does Email have an attachment?" type="Decision"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="105" w="90" h="60" /><decision expression="[HasAttachment]" /><ontrue>dc3f8982-6dca-49f3-ad03-e5bb7476187d</ontrue><onfalse>d615fb93-6d3e-4dfd-98eb-4f7d90d7e70d</onfalse></stage><stage stageid="d615fb93-6d3e-4dfd-98eb-4f7d90d7e70d" name="No Attachment to save" type="Exception"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="150" y="105" w="120" h="30" /><exception type="System Exception" detail="&quot;Message ID provided does not have attachment to save&quot;" /></stage><stage stageid="fa491419-5914-4836-9552-f443774af6b8" name="File Path To Save Attachments" type="Data"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="-150" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1bcd0cad-c10e-49f7-820e-2f26fdc28564" name="File Name of Attachment" type="Data"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="-90" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dc3f8982-6dca-49f3-ad03-e5bb7476187d" name="Check File Path Is Valid" type="Code"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="180" w="120" h="30" /><inputs><input type="text" name="path" expr="[File Path To Save Attachments]" /></inputs><outputs><output type="flag" name="isValidPath" stage="isValidPath" /><output type="text" name="outPath" stage="File Path To Save Attachments" /></outputs><onsuccess>82fc9ece-97b8-4877-a51c-c2cd6fe51fbc</onsuccess><code><![CDATA[            int lastSep = path.LastIndexOfAny(new char[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar });
            if (lastSep >= 0)
                path= path + path[lastSep];
            else
                path= path + Path.DirectorySeparatorChar;
			outPath=path;
            Regex driveCheck = new Regex(@"^[a-zA-Z]:\\$");
            if (!driveCheck.IsMatch(path.Substring(0, 3))) isValidPath= false;
            string strTheseAreInvalidFileNameChars = new string(Path.GetInvalidPathChars());
            strTheseAreInvalidFileNameChars += @":/?*" + "\"";
            Regex containsABadCharacter = new Regex("[" + Regex.Escape(strTheseAreInvalidFileNameChars) + "]");
            if (containsABadCharacter.IsMatch(path.Substring(3, path.Length - 3)))
                isValidPath= false;

            DirectoryInfo dir = new DirectoryInfo(Path.GetFullPath(path));

            if (!dir.Exists)
                dir.Create();
            isValidPath = true;]]></code></stage><stage stageid="6e371a11-b0d7-43c6-ac71-b33c38b1a131" name="isValidPath" type="Data"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="120" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="82fc9ece-97b8-4877-a51c-c2cd6fe51fbc" name="Is File Path Valid?" type="Decision"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="270" w="120" h="60" /><decision expression="[isValidPath]" /><ontrue>af135a77-d336-4581-92b4-c2188922c109</ontrue><onfalse>618ae0b4-c41d-41c3-b07c-9bebbc05ffff</onfalse></stage><stage stageid="618ae0b4-c41d-41c3-b07c-9bebbc05ffff" name="File Path to store attachment invalid" type="Exception"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="180" y="270" w="180" h="30" /><exception type="System Exception" detail="&quot;Invalid File location provided to save attachment&quot;" /></stage><stage stageid="2008f7a9-a912-4fdc-a38d-ee57c7971281" name="Mark Email As Read/Unread" type="SubSheetInfo"><subsheetid>ef079fc7-1657-40bd-89ae-f677fd33cba9</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8ad3f8e6-61b8-420b-ab75-2525a669cd40" name="Start" type="Start"><subsheetid>ef079fc7-1657-40bd-89ae-f677fd33cba9</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Message ID" narrative="Unique message identifier" stage="Message ID" /><input type="flag" name="Set To Read" stage="Set To Read" /></inputs><onsuccess>5602d257-a431-4ede-814e-335c63dd1a4f</onsuccess></stage><stage stageid="2642d410-e1f8-47f7-b5fc-90d5996c64db" name="End" type="End"><subsheetid>ef079fc7-1657-40bd-89ae-f677fd33cba9</subsheetid><loginhibit /><display x="15" y="150" /></stage><stage stageid="d7743e48-7dc8-41c2-983e-e4e29bf5e52b" name="Mark Message As Read/Unread" type="Code"><subsheetid>ef079fc7-1657-40bd-89ae-f677fd33cba9</subsheetid><loginhibit /><display x="15" y="45" /><inputs><input type="text" name="messageID" expr="[Message ID]" /><input type="flag" name="readFlag" expr="[Set To Read]" /></inputs><onsuccess>2642d410-e1f8-47f7-b5fc-90d5996c64db</onsuccess><code><![CDATA[InitExchangeService();
EmailMessage message = EmailMessage.Bind(service, messageID, new PropertySet(BasePropertySet.FirstClassProperties, EmailMessageSchema.IsRead));
message.IsRead = readFlag;
message.Update(ConflictResolutionMode.AlwaysOverwrite);   ]]></code></stage><stage stageid="5bcfecfa-17a4-4b22-8f39-755542e8484d" name="Message ID" type="Data"><subsheetid>ef079fc7-1657-40bd-89ae-f677fd33cba9</subsheetid><display x="-60" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7e4cd59a-05a4-4266-8a56-0e7bb874e7bd" name="Get Oldest Unread Email" type="Code"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><loginhibit /><display x="15" y="45" /><outputs><output type="flag" name="isUnreadEmailFound" stage="isUnreadEmailFound" /><output type="text" name="emailFrom" stage="emailFrom" /><output type="text" name="emailMessageID" stage="emailMessageID" /><output type="text" name="emailSubject" stage="emailSubject" /><output type="datetime" name="emailDateTimeSent" stage="emailDateTimeSent" /><output type="flag" name="HasAttachments" stage="HasAttachments" /></outputs><onsuccess>f129dfdc-6afd-4965-b140-1699d9ac291f</onsuccess><code><![CDATA[const int ONE_EMAIL = 1;

isUnreadEmailFound=false;
InitExchangeService(); 

ItemView view = new ItemView(ONE_EMAIL);
  SearchFilter sf = new SearchFilter.SearchFilterCollection(LogicalOperator.And, new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false));
  view.OrderBy.Add(ItemSchema.DateTimeReceived, SortDirection.Ascending);
  var findResults = service.FindItems(WellKnownFolderName.Inbox, sf, view);
 
emailMessageID="";
emailFrom="";
emailSubject="";
emailDateTimeSent=new DateTime();
HasAttachments=new bool();
 if (findResults.Items.Count.Equals(ONE_EMAIL))
  {	 
	  foreach(Item i in findResults){
	//Results.Rows.Add(i.Id, ((EmailMessage)i).From.Name, i.Subject, i.DateTimeSent);

	  emailFrom=((EmailMessage)i).From.Name;
	  emailMessageID=i.Id.ToString();
	  emailSubject=i.Subject;
	  emailDateTimeSent=i.DateTimeSent.ToLocalTime();
	  HasAttachments=i.HasAttachments;
	  isUnreadEmailFound=true;
	  }
  }

]]></code></stage><stage stageid="916b46df-c92f-4e7c-92fd-5368f21c1980" name="emailFrom" type="Data"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="150" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4d5e9b77-25d3-4d12-a327-701d64053cca" name="emailMessageID" type="Data"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="270" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e70b7f46-a51a-4fb3-bdf9-2e1211ce1bd6" name="emailSubject" type="Data"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="210" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="283c6464-256e-40ce-a9ed-14344aec3063" name="emailDateTimeSent" type="Data"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="330" y="45" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a3df1fda-3243-42c7-8815-99493841554a" name="HasAttachments" type="Data"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="390" y="45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dda80493-286f-44f6-b1f5-148ed685e0d1" name="isUnreadEmailFound" type="Data"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="90" y="45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4cdbd784-fef2-45e0-a032-82aa9020a29a" name="Get Message Details" type="SubSheetInfo"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="cc2afcda-f5cd-42a4-bfa4-be8b19e439e2" name="Start" type="Start"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="message ID" narrative="Unique identifier for message" stage="messageID" /></inputs><onsuccess>d5a0b924-8317-4955-b9ec-5f7c8382c291</onsuccess></stage><stage stageid="b1f7d0a4-fe5c-4b8d-85c5-91521ed82bfc" name="End" type="End"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><loginhibit /><display x="15" y="150" /><outputs><output type="text" name="Sender Email Address" narrative="Email address of the sender" stage="senderEmail" /><output type="collection" name="Attachment Names" narrative="Name column:Names of each of the attachments" stage="Attachments" /><output type="number" name="Number Of Attachments" narrative="Number of Attachments found" stage="noOfAttachments" /></outputs></stage><stage stageid="075888c1-6256-4e3a-8fcc-1f6297d97015" name="Get Message Details" type="Code"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><loginhibit /><display x="15" y="45" /><inputs><input type="text" name="messageID" expr="[messageID]" /><input type="text" name="Attachment Directory" expr="[Attachment Directory]" /></inputs><outputs><output type="number" name="noOfAttachments" stage="noOfAttachments" /><output type="collection" name="Attachment Names" stage="Attachment Names" /><output type="text" name="senderEmail" stage="senderEmail" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs><onsuccess>b1f7d0a4-fe5c-4b8d-85c5-91521ed82bfc</onsuccess><code><![CDATA[   InitExchangeService(); 
   
/*



            EmailMessage email1 = new EmailMessage(service); 
            email1.Subject = "Draft email one"; 
            email1.Body = new MessageBody(BodyType.Text, "Draft body of the mail");
			
			 Collection<EmailMessage> messages = new Collection<EmailMessage>(); 
             messages.Add(email1); 
			
				  
         

			ServiceResponseCollection<ServiceResponse> responses = service.CreateItems(messages, WellKnownFolderName.Drafts, MessageDisposition.SaveOnly, null); 
 
			MID=email1.Id.ToString();




   messageID=MID;
*/



   Success=false;
   Attachment_Names = new DataTable();
   Attachment_Names.Columns.Add("Name", typeof(string));
   EmailMessage message = EmailMessage.Bind(service, messageID, new PropertySet(BasePropertySet.FirstClassProperties));
   
   Subject=message.Subject.ToString();
   
   noOfAttachments = message.Attachments.Count;
   
   foreach (Attachment attachment in message.Attachments)
      {
         if (attachment is FileAttachment)
             {
                    Attachment_Names.Rows.Add(new Object[] { attachment.Name });
              }
       }
	 
    noOfAttachments = Attachment_Names.Rows.Count;
	try{
    senderEmail =message.Sender.ToString();
	}catch (Exception ex) {
		senderEmail ="";
	}
	
	Success=true;
	
	Message_Body= message.Body.ToString();
	
	
	//Attachment_Names = new DataTable();
	 //Subject="";
	 // noOfAttachments = 0;
	//  senderEmail ="";
	Error_Message="";
	
	]]></code></stage><stage stageid="9be3b461-7465-4d90-a1c9-184abf144e1a" name="noOfAttachments" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="240" y="45" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="afcbf8c2-cce0-4210-9116-a01b6cae5bbd" name="Attachments" type="Collection"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="345" y="-15" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="982dfee0-2099-4635-bdbd-0d435f23dbe8" name="senderEmail" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="345" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e1afd4ee-8c47-4ca7-9d4e-06f961b77a15" name="messageID" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="90" y="-105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cdf038a7-7849-4a58-8f79-82654b8a6b88" name="Sender Email Address" type="Data"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="180" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="00e5eb97-91f2-4c9b-a894-3d5d59420b48" name="Attachment Names" type="Collection"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="120" y="165" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="9910857a-bd78-40a0-a1aa-224099b97e38" name="Number Of Attachments" type="Data"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><display x="240" y="165" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f129dfdc-6afd-4965-b140-1699d9ac291f" name="Unread Email Found?" type="Decision"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><loginhibit /><display x="15" y="105" /><decision expression="[isUnreadEmailFound]" /><ontrue>cd9864a7-45c0-472e-b9b9-f6984269fe32</ontrue><onfalse>0fb543c4-2a0b-47a4-b7b4-f86614b303a5</onfalse></stage><stage stageid="0fb543c4-2a0b-47a4-b7b4-f86614b303a5" name="Anchor1" type="Anchor"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><loginhibit /><display x="90" y="105" w="10" h="10" /><onsuccess>0127f06b-159c-49ca-ac4d-e1e9ed769525</onsuccess></stage><stage stageid="0127f06b-159c-49ca-ac4d-e1e9ed769525" name="Anchor2" type="Anchor"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><loginhibit /><display x="90" y="225" w="10" h="10" /><onsuccess>6c253dd4-e14e-4fec-9d41-1443af1e27d9</onsuccess></stage><stage stageid="1729bc6b-a1cd-4965-b1b5-343fc4ca1bb2" name="Set To Read" type="Data"><subsheetid>ef079fc7-1657-40bd-89ae-f677fd33cba9</subsheetid><display x="-120" y="-15" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4f0afee7-5058-4024-a741-d87968779f14" name="Name Of Attachment To Save" type="Data"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="-135" y="390" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ca1d8f9d-98ff-4796-b0f3-f46919c3eccd" name="IsSuccessfullySaved" type="Data"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="165" y="390" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="380072ff-bb61-4bdc-be1b-d6095ecb8f2d" name="Is Successfully Saved?" type="Decision"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><loginhibit /><display x="15" y="450" /><decision expression="[IsSuccessfullySaved]" /><ontrue>031eaec8-f8f4-4171-aed0-fb39ed6b0d20</ontrue><onfalse>e475fb04-9c75-43bc-90fb-35194a393dfd</onfalse></stage><stage stageid="e475fb04-9c75-43bc-90fb-35194a393dfd" name="Attachment Not Saved" type="Exception"><subsheetid>3cc60c8e-6431-466b-a1a6-84d9752d79f8</subsheetid><display x="120" y="450" /><exception type="System Exception" detail="&quot;Could Not Save Attachment File&quot;" /></stage><stage stageid="cd9864a7-45c0-472e-b9b9-f6984269fe32" name="Get Message Details" type="SubSheet"><subsheetid>29e2a7de-921a-4e71-888b-d94daa0d173c</subsheetid><loginhibit /><display x="15" y="165" /><inputs><input type="text" name="message ID" narrative="Unique identifier for message" expr="[emailMessageID]" /></inputs><outputs><output type="text" name="Sender Email Address" narrative="Email address of the sender" stage="Sender Email Address" /><output type="collection" name="Attachment Names" narrative="Name column:Names of each of the attachments" stage="Attachment Names" /><output type="number" name="Number Of Attachments" narrative="Number of Attachments found" stage="Number Of Attachments" /></outputs><onsuccess>6c253dd4-e14e-4fec-9d41-1443af1e27d9</onsuccess><processid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</processid></stage><stage stageid="d5a0b924-8317-4955-b9ec-5f7c8382c291" name="isConfigured" type="Decision"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>075888c1-6256-4e3a-8fcc-1f6297d97015</ontrue><onfalse>5bfb1322-189b-4980-a45e-497817866ca2</onfalse></stage><stage stageid="5bfb1322-189b-4980-a45e-497817866ca2" name="Not configured" type="Exception"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="120" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="5602d257-a431-4ede-814e-335c63dd1a4f" name="isConfigured" type="Decision"><subsheetid>ef079fc7-1657-40bd-89ae-f677fd33cba9</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>d7743e48-7dc8-41c2-983e-e4e29bf5e52b</ontrue><onfalse>68189c49-40b2-48ec-9c62-1596b6d7863d</onfalse></stage><stage stageid="68189c49-40b2-48ec-9c62-1596b6d7863d" name="Not configured" type="Exception"><subsheetid>ef079fc7-1657-40bd-89ae-f677fd33cba9</subsheetid><display x="120" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="3da497e6-662c-4e59-872d-b0971f350527" name="Move Mail" type="SubSheetInfo"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="65ec8ab9-aee0-49ff-aaa7-74afe135d177" name="Start" type="Start"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><loginhibit /><display x="30" y="-150" /><inputs><input type="text" name="ID" stage="ID" /><input type="text" name="Move to Sub-Folder" stage="Move to Sub-Folder" /></inputs><onsuccess>b2a08eb5-5f96-4375-85ac-7fb3a669cc54</onsuccess></stage><stage stageid="d0ac2bb4-6988-4648-ad72-9de679a52573" name="End" type="End"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><loginhibit /><display x="30" y="150" /><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /><output type="text" name="New Mail Id" stage="New Mail Id" /></outputs></stage><stage stageid="0affab1c-fc26-4d5f-a5fd-59289d32701d" name="MoveMail Code" type="Code"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><loginhibit /><display x="30" y="45" w="120" h="60" /><inputs><input type="text" name="ID" expr="[ID]" /><input type="text" name="Move to Sub-Folder" expr="[Move to Sub-Folder]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /><output type="text" name="New Mail Id" stage="New Mail Id" /></outputs><onsuccess>d0ac2bb4-6988-4648-ad72-9de679a52573</onsuccess><code><![CDATA[New_Mail_Id="";
try 
{ 

InitExchangeService();
/*
Collection<ItemId> itemIds = new Collection<ItemId>(); 
itemIds.Add(ID); 

  EmailMessage email1 = new EmailMessage(service); 
            email1.Subject = "Draft email one"; 
            email1.Body = new MessageBody(BodyType.Text, "Draft body of the mail");
			
			  Collection<EmailMessage> messages = new Collection<EmailMessage>(); 
            messages.Add(email1); 
			
				  Collection<ItemId> itemIds1 = new Collection<ItemId>(); 
         

			ServiceResponseCollection<ServiceResponse> responses = service.CreateItems(messages, WellKnownFolderName.Drafts, MessageDisposition.SaveOnly, null); 
 
			   foreach (EmailMessage email in messages) 
            { 
                itemIds1.Add(email.Id); 
            } 
	*/	
Collection<ItemId> itemIds = new Collection<ItemId>(); 
itemIds.Add(ID); 	
		
FolderId FID = getFolderIDByName(Move_to_Sub_Folder, service);
if (FID == null) {
	throw new Exception("Foldername invalid. Please provide a valid mail folder to search in.");
}

Folder TargetFolder = Folder.Bind(service, FID);

ServiceResponseCollection<MoveCopyItemResponse> responses1 = service.MoveItems(itemIds,TargetFolder.Id); 


if (responses1.OverallResult == ServiceResult.Success) 
{ 
	New_Mail_Id=responses1[0].Item.Id.ToString();
	Success=true;
    Error_Message="";
} 
else 
{ 
	Success=false;
    Error_Message="Unable to move mail";
} 
} 
catch (ServiceResponseException ex) 
{ 
	Success=false;
	Error_Message=ex.Message; 
} 
]]></code></stage><stage stageid="56e3d44e-e7ae-4cf3-90c5-d676023e9228" name="ID" type="Data"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="-240" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">123456</initialvalue><private /><alwaysinit /></stage><stage stageid="f4816330-349b-4798-a64f-15e3df9070df" name="Move to Sub-Folder" type="Data"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">AH Voice Orders Management</initialvalue><private /><alwaysinit /></stage><stage stageid="f61f7557-35e4-468a-9b1d-d13451bfc594" name="Success" type="Data"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="-240" y="150" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d6c3b5f7-afcc-4462-b5e9-426e2a05ffc4" name="Error Message" type="Data"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="-165" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a870d67a-e70b-4886-9669-53d0592d2ac5" name="Input Data Item" type="Block"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="-285" y="-30" w="165" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="69e300c1-8d83-4d16-bf77-a185dc92f26c" name="Output Data Item" type="Block"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="-285" y="105" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0eb316bd-74e8-4d58-803b-49890352f6af" name="Attachment Directory" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><loginhibit /><display x="240" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="883c8840-cd83-4c0a-8cd3-68f928b13800" name="Subject" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="-60" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cce2ad29-1b84-4457-8520-bda60d2fe4e1" name="Message Body" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="225" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ff6a76ab-5492-401e-b334-01a45fa66d5a" name="Attachment Names" type="Collection"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="270" y="-90" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="a0a293da-7759-4b2b-811f-cd1f15509723" name="Success" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="345" y="105" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9aebea85-132a-4aae-8775-7a9257b9a8db" name="Error Message" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="345" y="-90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="26f750b1-8578-4fdd-a3ee-8e2bfa6d1cc0" name="MID" type="Data"><subsheetid>0d9c75cc-6158-4b1e-be50-a6c74d4a1b70</subsheetid><display x="90" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0078fa88-4fd2-467e-b6b1-367798453d45" name="Sub-Folder" type="Data"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7b05c2af-2b53-4a39-a946-eb6e2b57120f" name="IDs" type="Collection"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="-225" y="135" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="7fe7ef6c-4ee3-48bf-b44a-1283152d4337" name="Success" type="Data"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="-150" y="135" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1fd5edf6-fcf5-4696-84fe-cd851b17b21d" name="Error Message" type="Data"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="-225" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d4dd5bc6-8e64-4d34-91b3-5f505ea8e939" name="Unread Only?" type="Data"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="-225" y="15" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="14268f77-6886-43f2-b785-24586aded16d" name="Output Data Item" type="Block"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="-270" y="90" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="246ad927-a7a1-4022-8e30-69ceb3c24bbd" name="Input Data Item" type="Block"><subsheetid>964ad939-1c2c-4bd2-b5cd-97dc9c74f6e6</subsheetid><display x="-270" y="-30" w="165" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e47f39ba-6467-4039-b6f9-49cfe9d30fb8" name="Get Mail" type="SubSheetInfo"><subsheetid>d1d442e2-028c-4693-acd0-6b4ef96935f6</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="26b46630-987c-4cd4-a725-cc53c65d0402" name="Start" type="Start"><subsheetid>d1d442e2-028c-4693-acd0-6b4ef96935f6</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Sub-Folder" stage="Sub-Folder" /><input type="text" name="Attachment Directory" stage="Attachment Directory" /></inputs><onsuccess>38a8da94-cedf-48d8-8dc9-20c6e6089700</onsuccess></stage><stage stageid="33998c2d-bd3b-4073-981f-3811b6ac2ac3" name="End" type="End"><subsheetid>d1d442e2-028c-4693-acd0-6b4ef96935f6</subsheetid><loginhibit /><display x="15" y="150" /><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="38a8da94-cedf-48d8-8dc9-20c6e6089700" name="isConfigured" type="Decision"><subsheetid>d1d442e2-028c-4693-acd0-6b4ef96935f6</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>ffb25a92-0b72-42ff-a6a3-0505f045044a</ontrue><onfalse>a5fb055d-2289-4f3b-a511-db5e7316d6af</onfalse></stage><stage stageid="a5fb055d-2289-4f3b-a511-db5e7316d6af" name="Not configured" type="Exception"><subsheetid>d1d442e2-028c-4693-acd0-6b4ef96935f6</subsheetid><display x="135" y="-30" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="ffb25a92-0b72-42ff-a6a3-0505f045044a" name="GetMail Code" type="Code"><subsheetid>d1d442e2-028c-4693-acd0-6b4ef96935f6</subsheetid><loginhibit /><display x="15" y="60" /><inputs><input type="text" name="Sub-Folder" expr="[Sub-Folder]" /><input type="text" name="Attachment Directory" expr="[Attachment Directory]" /></inputs><outputs><output type="text" name="Sender Name" stage="Sender Name" /><output type="text" name="Sender Email Address" stage="Sender Email Address" /><output type="text" name="Subject" stage="Subject" /><output type="text" name="Message Body" stage="Message Body" /><output type="text" name="Attachment Names" stage="Attachment Names" /><output type="text" name="ID" stage="ID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs><onsuccess>33998c2d-bd3b-4073-981f-3811b6ac2ac3</onsuccess><code><![CDATA[
ID="";
Sender_Name="";
Sender_Email_Address="";
Subject="";
Message_Body="";
Attachment_Names="";
Error_Message="";
bool mail_exists=false;

try{

const int ONE_EMAIL = 1;

InitExchangeService(); 

Success=false;

ItemView view = new ItemView(ONE_EMAIL);
view.OrderBy.Add(ItemSchema.DateTimeReceived, SortDirection.Descending);


Folder TargetFolder;
if (String.IsNullOrWhiteSpace(Sub_Folder))
{
	TargetFolder = Folder.Bind(service, WellKnownFolderName.Inbox);
}
else {
	FolderId FID = getFolderIDByName(Sub_Folder, service);
	if (FID == null) {
		throw new Exception("Foldername invalid. Please provide a valid mail folder to search in.");
	}
	TargetFolder = Folder.Bind(service, FID);
}

  
var findResults = service.FindItems(TargetFolder.Id, view);
 


PropertySet itempropertyset = new PropertySet(BasePropertySet.FirstClassProperties);
itempropertyset.RequestedBodyType = BodyType.Text;
ItemView itemview = new ItemView(1000);
itemview.PropertySet = itempropertyset;

 if (findResults.Items.Count.Equals(ONE_EMAIL))
  {	 
	  foreach(Item i in findResults){
		  mail_exists=true;
      EmailMessage mes = (EmailMessage)i;
	  
	  //Sender_Name=mes.From.Name;
	  Sender_Name=mes.From.Name;
	  
	  NameResolutionCollection resolvedNames=service.ResolveName(mes.Sender.Address);

	  foreach (NameResolution nameRes in resolvedNames)
		{
			Sender_Email_Address=nameRes.Mailbox.Address;
			break;
		}
	
	  
	  //Sender_Email_Address=mes.From.Address;
	  Subject=i.Subject;
	  i.Load(itempropertyset);
	  Message_Body=i.Body;
	  Attachment_Names="";
	  ID=i.Id.ToString();
	  
	
	  EmailMessage attach_mes = EmailMessage.Bind(service, ID, new PropertySet(ItemSchema.Attachments));

	  int index=0;
		foreach (Attachment attachment in attach_mes.Attachments)
		{
			
			if (attachment is FileAttachment)
			{
				FileAttachment fileAttachment = attachment as FileAttachment;

				if(index==0)
				{
					Attachment_Names=fileAttachment.Name;
				}else{
					Attachment_Names=Attachment_Names+";"+fileAttachment.Name;
				}
			
				
				  fileAttachment.Load(Attachment_Directory+"\\" + fileAttachment.Name);

			  index=index+1;
			}
			else // Attachment is an item attachment.
			{
				ItemAttachment itemAttachment = attachment as ItemAttachment;

				// Load attachment into memory and write out the subject.
				// This does not save the file like it does with a file attachment.
				// This call results in a GetAttachment call to EWS.
				itemAttachment.Load();
			}
		}


	  }
	  
	  
	  if(mail_exists){
		Success=true;
		Error_Message="";
	  }
	  else
	  {
		  Success=false;
		Error_Message="Unable to get Mail. Mail folder is empty";
	  }
 
  }
}catch(Exception ex)
{
	Success=false;
  Error_Message=ex.Message;
}
	


]]></code></stage><stage stageid="6b33c7b9-62c9-483b-b467-5cf67317b5cd" name="Input Data Item" type="Block"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><display x="-285" y="-30" w="165" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="944baedd-adbd-40e2-a7ea-02943958bb18" name="Member Variables" type="Block"><subsheetid>dfd9b6ae-ddaa-44a8-90f9-52c824dcd375</subsheetid><display x="240" y="-60" w="165" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f315e6e3-62a7-48af-ad8d-7ff307f62411" name="Error Message" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-165" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c85e4987-587f-4a72-89d6-b537d2dd168a" name="Success" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-225" y="270" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2bf4ba4a-f6e7-4171-8c86-f46ba08de830" name="Attachments" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><loginhibit /><display x="-150" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="34090f2d-8f6e-4b91-8842-ffe4a6b31012" name="BCC" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><loginhibit /><display x="-150" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b006a288-471d-4bb9-8dfb-20341df070be" name="Message" type="Data"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-225" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c71bb600-7c29-4f26-8504-4960db041241" name="Input Data Item" type="Block"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-270" y="-30" w="165" h="225" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4f807329-f3cc-43fb-a585-1aa327c53ac3" name="Output Data Item" type="Block"><subsheetid>b167a580-ce9a-4ace-a05d-d2152f4fd420</subsheetid><display x="-270" y="225" w="165" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="b2a08eb5-5f96-4375-85ac-7fb3a669cc54" name="isConfigured" type="Decision"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><loginhibit /><display x="30" y="-60" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>0affab1c-fc26-4d5f-a5fd-59289d32701d</ontrue><onfalse>c4dcb2e3-23f4-414b-a82e-2a19f028dcc1</onfalse></stage><stage stageid="c4dcb2e3-23f4-414b-a82e-2a19f028dcc1" name="Not configured" type="Exception"><subsheetid>3406eaac-a371-473f-91d1-925743e2d823</subsheetid><display x="150" y="-60" w="90" h="30" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="d086d5c7-767b-4367-8ebd-3644fbea137e" name="Save Email" type="SubSheetInfo"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="377d5a70-97bb-4802-b5a1-2d23493a6ffd" name="End" type="End"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="15" y="885" /><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Error Message" stage="Error Message" /></outputs></stage><stage stageid="89c88996-8f8d-476b-80ca-89698387c280" name="Start" type="Start"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="15" y="-195" /><inputs><input type="text" name="Sub-Folder" narrative="Optional. The name of a sub-folder below the Inbox from which to get emails.  If not set the Inbox will be used." stage="Sub-Folder" /><input type="text" name="Mail ID" narrative="Optional. If you want to mail using mail ID" stage="Mail ID" /><input type="text" name="Email Name" narrative="Optional. If not provided Email will be saved as mail.eml" stage="Email Name" /><input type="text" name="Folder Path" stage="Folder Path" /></inputs><onsuccess>c53167f7-2b0a-4d4a-84da-aa58687a91d7</onsuccess></stage><stage stageid="c53167f7-2b0a-4d4a-84da-aa58687a91d7" name="isConfigured" type="Decision"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="15" y="-120" w="90" h="60" /><decision expression="[isConfigured]" /><ontrue>bffc4f64-21b2-4759-8c5d-f450f886d9d9</ontrue><onfalse>4f5ce869-f6a2-4ffc-b9e6-2950be9fea96</onfalse></stage><stage stageid="4f5ce869-f6a2-4ffc-b9e6-2950be9fea96" name="Not configured" type="Exception"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="135" y="-120" /><exception type="System Exception" detail="&quot;Cannot connect to the Exchange Server. Please configure the connection&quot; " /></stage><stage stageid="97051bbb-6a07-4dce-94be-dfa85ec5d036" name="Read Mail from Subfolder" type="Code"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="315" y="210" w="90" h="30" /><inputs><input type="text" name="Sub-Folder" expr="[Sub-Folder]" /><input type="text" name="Email Name" expr="[Email Name]" /><input type="text" name="Folder Path" expr="[Folder Path]" /></inputs><outputs><output type="text" name="Error Message" stage="Error Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>36bafdf1-adb4-4b9e-92c5-bc902a756541</onsuccess><code><![CDATA[

InitExchangeService();
DataTable IDs = new DataTable();
int IDs_count;
try
{
	
 int len=Folder_Path.Length;
 
 string ch=Folder_Path[len-1].ToString();
 
 if(ch==@"\"){
	 Folder_Path=Folder_Path.Substring(0,len-1);
 }
	

 Folder TargetFolder;
 if (String.IsNullOrWhiteSpace(Sub_Folder))
 {
	TargetFolder = Folder.Bind(service, WellKnownFolderName.Inbox);
 }
 else {
	FolderId FID = getFolderIDByName(Sub_Folder, service);
	if (FID == null) {
		throw new Exception("Foldername invalid. Please provide a valid mail folder to search in.");
	}
	TargetFolder = Folder.Bind(service, FID);
 }

 SearchFilter unreadsf = new SearchFilter.IsEqualTo(EmailMessageSchema.IsRead, false);

 ItemView view;

 view = new ItemView(1);

 view.PropertySet = new PropertySet(BasePropertySet.IdOnly, EmailMessageSchema.Subject, EmailMessageSchema.From, EmailMessageSchema.DateTimeSent);


 FindItemsResults<Item> findResults;

 findResults = service.FindItems(TargetFolder.Id, view);

 IDs.Columns.Add("ID", typeof(string));
 IDs.Columns.Add("From", typeof(string));
 IDs.Columns.Add("Subject", typeof(string));
 IDs.Columns.Add("DateTimeSent", typeof(DateTime));

 IDs_count=0;
 foreach(Item i in findResults){
	PropertySet props = new PropertySet(EmailMessageSchema.MimeContent);
	
	var email = EmailMessage.Bind(service, i.Id, props);
			
	Email_Name=Email_Name.Trim();
	
	string emlFileName="";
	
	if(Email_Name==""){
		emlFileName = Folder_Path+@"\mail.eml";
	}else{
		emlFileName = Folder_Path+@"\"+Email_Name+".eml";
	}
	
	
	//string emlFileName = @"C:\export\email.eml";
	//string mhtFileName = @"C:\export\email.mht";

	// Save as .eml.
	using (FileStream fs = new FileStream(emlFileName, FileMode.Create, FileAccess.Write))
	{
		fs.Write(email.MimeContent.Content, 0, email.MimeContent.Content.Length);
	}

	// Save as .mht.
	//using (FileStream fs = new FileStream(mhtFileName, FileMode.Create, FileAccess.Write))
	//{
	//	fs.Write(email.MimeContent.Content, 0, email.MimeContent.Content.Length);
	//}	
	IDs.Rows.Add(i.Id, ((EmailMessage)i).From.Name, i.Subject, i.DateTimeSent);
    IDs_count++;
}


if(IDs_count>0)
{
 Success=true;
 Error_Message=""; 
}else
{
  Success=false;
  Error_Message="No mails found in the folder."; 
} 

}catch (ServiceResponseException ex) 
{ 
	Success=false;
	Error_Message=ex.Message; 
} 
]]></code></stage><stage stageid="ad4c7aa2-1f4b-4908-95a2-df1cdba43679" name="Mail ID" type="Data"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="-270" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c40697e8-1c26-456a-8a89-d1f8782d8071" name="Input Parameter" type="Block"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="-330" y="-30" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="d1511d67-afb0-4f26-a67e-7544327ef129" name="Sub-Folder" type="Data"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="-195" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f89a9690-1a64-4e12-9273-c04dce567a23" name="Path ?" type="ChoiceStart"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="15" y="165" /><groupid>b5810435-7211-49da-beec-13c1f8a75892</groupid><choices><choice expression="Trim([Sub-Folder])&lt;&gt;&quot;&quot; AND Trim([Mail ID])=&quot;&quot;"><name>Get Mail for Subfolder</name><distance>45</distance><ontrue>68af59c1-4f59-40ce-89a0-d39a18bbd749</ontrue></choice><choice expression="Trim([Sub-Folder])=&quot;&quot; AND Trim([Mail ID])=&quot;&quot; "><name>Get Mail from Inbox</name><distance>120</distance><ontrue>4ad12c95-9a12-4f39-acb7-b9764f339949</ontrue></choice><choice expression="Trim([Sub-Folder])=&quot;&quot; AND Trim([Mail ID])&lt;&gt;&quot;&quot;"><name>Get Mail via Mail ID</name><distance>195</distance><ontrue>1a0bfb30-b8c7-4826-aeab-6d306544cadf</ontrue></choice></choices></stage><stage stageid="c7432a05-d47c-478a-b2ec-f2dd1dfabac2" name="Otherwise1" type="ChoiceEnd"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="15" y="570" /><onsuccess>1001237a-b570-4c23-a251-20733907642d</onsuccess><groupid>b5810435-7211-49da-beec-13c1f8a75892</groupid></stage><stage stageid="1001237a-b570-4c23-a251-20733907642d" name="Invalid Combination" type="Exception"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="-105" y="570" /><exception type="" detail="&quot;Subfolder and Mail ID cannot be provided at the same time&quot;" /></stage><stage stageid="d4102861-30fe-4e9b-b038-907ada458a6a" name="Anchor4" type="Anchor"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="15" y="720" w="10" h="10" /><onsuccess>377d5a70-97bb-4802-b5a1-2d23493a6ffd</onsuccess></stage><stage stageid="6bdcc91f-f4c8-441b-9946-1becfe951034" name="Anchor5" type="Anchor"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="315" y="720" w="10" h="10" /><onsuccess>d4102861-30fe-4e9b-b038-907ada458a6a</onsuccess></stage><stage stageid="04c15fcd-3e02-42ae-bac1-1edc2fdf302f" name="Error Message" type="Data"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="-195" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="868a12c3-0da0-407f-bbdf-a350efad50d7" name="Success" type="Data"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="-270" y="150" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="579d8277-a5ce-41ae-af83-5875c59881b3" name="Output Parameter" type="Block"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="-330" y="105" w="180" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4ad12c95-9a12-4f39-acb7-b9764f339949" name="Anchor6" type="Anchor"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="120" y="285" w="10" h="10" /><onsuccess>68af59c1-4f59-40ce-89a0-d39a18bbd749</onsuccess></stage><stage stageid="68af59c1-4f59-40ce-89a0-d39a18bbd749" name="Anchor7" type="Anchor"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="120" y="210" w="10" h="10" /><onsuccess>97051bbb-6a07-4dce-94be-dfa85ec5d036</onsuccess></stage><stage stageid="1a0bfb30-b8c7-4826-aeab-6d306544cadf" name="Read Mail via ID" type="Code"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="165" y="360" w="90" h="30" /><inputs><input type="text" name="Mail ID" expr="[Mail ID]" /><input type="text" name="Email_Name" expr="[Email Name]" /><input type="text" name="Folder Path" expr="[Folder Path]" /></inputs><outputs><output type="text" name="Error Message" stage="Error Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>36bafdf1-adb4-4b9e-92c5-bc902a756541</onsuccess><code><![CDATA[

InitExchangeService();
int IDs_count;
try
{
	
	int len=Folder_Path.Length;
 
	string ch=Folder_Path[len-1].ToString();

	if(ch==@"\"){
	  Folder_Path=Folder_Path.Substring(0,len-1);
	}
	
 
	PropertySet props = new PropertySet(EmailMessageSchema.MimeContent);
	
	//var email = EmailMessage.Bind(service, i.Id, props);
	
	var email = EmailMessage.Bind(service,Mail_ID, props);
			
	
	Email_Name=Email_Name.Trim();
	
	string emlFileName="";
	
	if(Email_Name==""){
		emlFileName = Folder_Path+@"\mail.eml";
	}else{
		emlFileName = Folder_Path+@"\"+Email_Name+".eml";
	}
	
	
	
	
	//string emlFileName = @"C:\export\email.eml";
	//string mhtFileName = @"C:\export\email.mht";

	// Save as .eml.
	using (FileStream fs = new FileStream(emlFileName, FileMode.Create, FileAccess.Write))
	{
		fs.Write(email.MimeContent.Content, 0, email.MimeContent.Content.Length);
	}

	// Save as .mht.
	//using (FileStream fs = new FileStream(mhtFileName, FileMode.Create, FileAccess.Write))
	//{
	//	fs.Write(email.MimeContent.Content, 0, email.MimeContent.Content.Length);
	//}	
	

	
	if(email!=null)
	{
	 Success=true;
	 Error_Message=""; 
	}else
	{
	  Success=false;
	  Error_Message="Email Not Found."; 
	} 

}catch (ServiceResponseException ex) 
{ 
	Success=false;
	Error_Message="Email Not Found."; 
} 
]]></code></stage><stage stageid="36bafdf1-adb4-4b9e-92c5-bc902a756541" name="Anchor8" type="Anchor"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="315" y="360" w="10" h="10" /><onsuccess>6bdcc91f-f4c8-441b-9946-1becfe951034</onsuccess></stage><stage stageid="569d1b58-9fc3-4f58-ac16-9ea60eec225e" name="Email Name" type="Data"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="-270" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="df82e160-bd4f-457f-aa9b-dc382ab18f2a" name="Folder Path" type="Data"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="-195" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bffc4f64-21b2-4759-8c5d-f450f886d9d9" name="Is Folder ath Provided ?" type="Decision"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="15" y="-60" /><decision expression="Trim([Folder Path])&lt;&gt;&quot;&quot;" /><ontrue>fc0876a8-7b27-47cc-97ba-388e84325c9c</ontrue><onfalse>a0cb952f-6bb0-4df1-86de-3546b832d2a7</onfalse></stage><stage stageid="a0cb952f-6bb0-4df1-86de-3546b832d2a7" name="Folder Path not provided" type="Exception"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><display x="135" y="-60" /><exception type="Ex03 - Data Exception" detail="&quot;Folder Path not provided&quot;" /></stage><stage stageid="fc0876a8-7b27-47cc-97ba-388e84325c9c" name="Check Folder Exists ?" type="Action"><subsheetid>37075319-6961-4a5b-aa2e-51e31be47b7e</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Directory Name" narrative="The directory to check exists" expr="[Folder Path]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the directory exists" stage="Exists" /></outputs><onsuccess>0fa007c5-9794-400f-9896-89030a31a36e</onsuccess><resource object="Utility - File Management" action="Directory 