narrative="True to activate the cell which is found; False to just return the reference and leave the active cell as it was before. Default is False." expr="False" /></inputs><outputs><output type="text" name="Cell Reference" friendlyname="Cell Reference" narrative="The cell reference identifying the next empty cell from the active cell in the direction given. An empty value indicates that there were no empty cells between the active cell and a boundary." stage="Cell Reference" /></outputs><onsuccess>2885804d-0d11-42aa-9bce-8d84941bcc43</onsuccess><resource object="MS Excel VBO" action="Find Next Empty Cell" /></stage><stage stageid="1f22fcde-32d3-4245-a09d-94da962b9711" name="Cell Reference" type="Data"><subsheetid>31e81bf5-8a51-4c71-bf21-a6f2ccf37694</subsheetid><display x="270" y="285" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="580f32a1-1f98-4347-802a-f39f27c581a9" name="Output file path" type="Data"><subsheetid>31e81bf5-8a51-4c71-bf21-a6f2ccf37694</subsheetid><loginhibit onsuccess="true" /><display x="270" y="225" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="65b1d565-8919-43ae-95c1-33e354456118" name="MS Excel VBO::Save Workbook As" type="Action"><subsheetid>31e81bf5-8a51-4c71-bf21-a6f2ccf37694</subsheetid><loginhibit onsuccess="true" /><narrative>FormatDate(Today(), "MMMM")</narrative><display x="30" y="135" w="120" h="30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the workbook which should be saved resides. The default of zero indicates the currently active instance." expr="[handle1]" /><input type="text" name="Workbook Name" friendlyname="Workbook Name" narrative="The name of the workbook which should be saved" expr="[Workbook Name1]" /><input type="text" name="Filename" friendlyname="Filename" narrative="The full path and filename to which the workbook should be saved." expr="&quot;G:\RPA\PCI AD to MUI\Output\&quot; &amp;Replace(FormatDate(Today(), &quot;MMMM&quot;), [Workbook Name1], FormatDate(Today(), &quot;MMMM&quot;))" /></inputs><outputs><output type="text" name="New Workbook Name" friendlyname="New Workbook Name" narrative="The new workbook name which Excel will use to identify the workbook within the instance." stage="New Workbook Name" /></outputs><onsuccess>63593186-6512-4ba8-87d1-d24b7f20d067</onsuccess><resource object="MS Excel VBO" action="Save Workbook As" /></stage><stage stageid="34c5c1ed-1b88-4c71-be09-5665df677408" name="Master file" type="Collection"><subsheetid>31e81bf5-8a51-4c71-bf21-a6f2ccf37694</subsheetid><display x="-195" y="255" w="120" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="a0188b45-4f25-4e56-8d15-bf259e3991a4" name="New Workbook Name" type="Data"><subsheetid>31e81bf5-8a51-4c71-bf21-a6f2ccf37694</subsheetid><display x="270" y="255" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cae6e8da-9b26-477d-9e28-ba795c94ac35" name="Current Month?" type="Decision"><subsheetid>31e81bf5-8a51-4c71-bf21-a6f2ccf37694</subsheetid><display x="30" y="0" /><decision expression="Replace([Master file.Name], Right([Master file.Name], 5), &quot;&quot;)=FormatDate(Today(), &quot;MMMM&quot;)" /><ontrue>22a5a933-3792-41b0-9e87-8807acad90c6</ontrue><onfalse>b7e658be-0300-44e7-a20a-f31536578e95</onfalse></stage><stage stageid="b7e658be-0300-44e7-a20a-f31536578e95" name="MS Excel VBO::Delete Worksheet" type="Action"><subsheetid>31e81bf5-8a51-4c71-bf21-a6f2ccf37694</subsheetid><loginhibit onsuccess="true" /><display x="150" y="0" w="90" h="30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the worksheet which should be deleted resides. The default of zero indicates the currently active instance." expr="[handle1]" /><input 