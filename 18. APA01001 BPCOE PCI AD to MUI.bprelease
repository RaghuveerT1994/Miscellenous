&lt;head&gt;
    &lt;style&gt;
        body {
            margin: 0px;
            font-family: "Century Gothic", sans-serif;
            font-size: 16px;
            color: black;
            font-weight: normal;
        }
        
        h1 {
            color: white;
            margin: 0px;
            font-size: 22px;
            font-weight: lighter;
        }
        
        h2 {
            text-align: center;
            font-size: 24px;
            font-weight: normal;
            color: #5514b4;
            padding: 10px 0px;
        }
        
        h3 {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
        }
        
        h4 {
            font-size: 14px;
            font-style: italic;
            font-weight: normal;
        }
        
        h5 {
            text-align: left;
            font-weight: normal;
            font-size: 10pt;
            color: #fff;
            margin: 0px;
        }
        
        a.footer {
            color: skyblue;
        }
        
        .container {
            width: 100%;
            border-collapse: collapse;
            padding: 0px;
            margin: 0px;
        }
        
        .container-header {
            background: #5514b4;
            width: 800;
            height: 70px;
        }
        
        .container-header-padding {
            background: #5514b4;
            height: 70px;
        }
        
        .container-body {
            background: #fff;
            width: 800;
            padding: 10px 0px;
        }
        
        .container-body-padding {
            background: #fff;
        }
        
        .container-footer {
            background: #5514b4;
            width: 800;
            height: 70px;
            vertical-align: middle;
        }
        
        .container-footer-padding {
            background: #5514b4;
            height: 70px;
        }
        
        .table-header {
            color: white;
            background-color: #5514b4;
            font-weight: bold;
        }
        
        .table {
			text-align: center;
            width: 100%;
            border-collapse: collapse;
            border: 1px solid black;
			font-size: 14px;
        }
        
        .table td {
            border: 1px solid black;
        }
        
        .table tr {
            border: 1px solid black;
        }
    &lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;
    &lt;table class="container"&gt;
        &lt;tr&gt;
            &lt;td class="container-header-padding"&gt;&lt;/td&gt;
            &lt;td class="container-header"&gt;
                &lt;table&gt;
                    &lt;td&gt;
                        &lt;img src="https://bt.cirrusmobile.co.uk/WriteableFolder/webPageResources/lobSpecificStyles/GroupRead/communityBannerImages/bt_logo_white.png" width=58 height=70&gt;
                    &lt;/td&gt;
                    &lt;td width=100% align=right&gt;
                        &lt;h1&gt;Intelligent Automation&lt;/h1&gt;
                    &lt;/td&gt;
                &lt;/table&gt;
            &lt;/td&gt;
            &lt;td class="container-header-padding"&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td class="container-body-padding"&gt;
            &lt;/td&gt;
            &lt;td class="container-body"&gt;
                
