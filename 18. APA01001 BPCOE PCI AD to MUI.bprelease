eid="1a9c2876-e271-48dd-9e0b-da3942fb6bdb" name="SignIn window Error" type="Exception"><subsheetid>36fc367d-5806-4e9f-aed3-fdeee73a740c</subsheetid><display x="255" y="-165" /><exception localized="yes" type="System Exception" detail="&quot;Failed waiting for SignIn Window&quot;" /></stage><stage stageid="c19fdec6-30c7-4b66-9557-ba0185e4df80" name="Activate SingIn window" type="Navigate" interval="0.5"><subsheetid>36fc367d-5806-4e9f-aed3-fdeee73a740c</subsheetid><loginhibit /><display x="15" y="-120" /><onsuccess>ddcf4865-a288-49ad-85ae-dd38340edda8</onsuccess><step><element id="4ab93078-831e-4323-a4b4-dc1d44803e05" /><action><id>ActivateApp</id></action></step></stage><stage stageid="a9e93c32-94e8-4773-a351-66c8cffe55c1" name="Read Error" type="Read"><subsheetid>36fc367d-5806-4e9f-aed3-fdeee73a740c</subsheetid><loginhibit /><display x="570" y="165" /><onsuccess>464490eb-3eb0-483d-b2ff-13cbe02b8958</onsuccess><step stage="Value from Error Text"><element id="a25d8c9e-c5ee-4586-9577-d4418c937b4a" /><action><id>WebGetText</id><arguments><argument><id>trackingid</id><value></value></argument></arguments></action></step></stage><stage stageid="464490eb-3eb0-483d-b2ff-13cbe02b8958" name="Throw Error" type="Exception"><subsheetid>36fc367d-5806-4e9f-aed3-fdeee73a740c</subsheetid><loginhibit onsuccess="true" /><display x="570" y="225" /><exception localized="yes" type="System Exception" detail="[Value from Error Text]" /></stage><stage stageid="ba3e5699-0943-49c3-9bc7-1e07410fbee2" name="Value from Error Text" type="Data"><subsheetid>36fc367d-5806-4e9f-aed3-fdeee73a740c</subsheetid><display x="-270" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage></process></object>
        <object id="1755dccf-ee8a-456b-86d6-6d83220f12de" name="Utility - Environment" xmlns="http://www.blueprism.co.uk/product/process"><process name="Utility - Environment" version="5.0.23" bpversion="6.9.0.26970" narrative="Utilities for interacting with the environment - read screen resolution, determine OS type, etc." byrefcollection="true" type="object" runmode="Background"><appdef><element name="Application Root"><id>257afd68-bed2-460b-94e5-17b2b6263b15</id><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element></appdef><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view><preconditions /><endpoint narrative="" /><subsheet subsheetid="72ac1b78-ac00-4ede-b5fa-13beef468814" type="Normal" published="True"><name>Font Smoothing Enabled</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="cf31a66d-5534-4af0-9a07-433066d1a4b9" type="Normal" published="True"><name>Get Clipboard</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="cf9f6573-f06c-4ab6-9672-34d2e644415e" type="Normal" published="True"><name>Set Clipboard</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="50ea2955-c157-4803-b16c-fea2255ce9e2" type="Normal" published="True"><name>Clear Clipboard</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="a7ea3097-4e9b-48f3-9431-68977353a6bc" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="4987fdec-ac7a-4166-a60b-adef47ecdcc7" type="Normal" published="True"><name>Get Screen Resolution</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><s