An Exception will occur if access to these credentials is not allowed (based on the running Resource, Process and User) or if the credentials do not contain a property with the specified name.</narrative><display x="60" y="60" w="90" h="30" /><inputs><input type="text" name="Credentials Name" friendlyname="Credentials Name" narrative="The name of the credentials" expr="&quot;[R] Microsoft Graph API - Outlook&quot;" /><input type="text" name="Property Name" friendlyname="Property Name" narrative="The name of the property" expr="&quot;ClientSecret&quot;" /></inputs><outputs><output type="password" name="Property Value" friendlyname="Property Value" narrative="The value of the property" stage="ClientSecret" /></outputs><onsuccess>8105baf4-13ae-4da4-afee-a4238b74ef3e</onsuccess><resource object="Blueprism.Automate.clsCredentialsActions" action="Get Property" /></stage><stage stageid="8105baf4-13ae-4da4-afee-a4238b74ef3e" name="Get Tenant ID" type="Action"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><loginhibit onsuccess="true" /><narrative>Returns the value of the specified credentials property.

An Exception will occur if access to these credentials is not allowed (based on the running Resource, Process and User) or if the credentials do not contain a property with the specified name.</narrative><display x="60" y="120" w="90" h="30" /><inputs><input type="text" name="Credentials Name" friendlyname="Credentials Name" narrative="The name of the credentials" expr="&quot;[R] Microsoft Graph API - Outlook&quot;" /><input type="text" name="Property Name" friendlyname="Property Name" narrative="The name of the property" expr="&quot;TenantID&quot;" /></inputs><outputs><output type="password" name="Property Value" friendlyname="Property Value" narrative="The value of the property" stage="TenantID" /></outputs><onsuccess>7654e037-4cd9-4ec8-8214-031e657c6b0e</onsuccess><resource object="Blueprism.Automate.clsCredentialsActions" action="Get Property" /></stage><stage stageid="7654e037-4cd9-4ec8-8214-031e657c6b0e" name="Authenticate" type="Action"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><loginhibit onsuccess="true" /><display x="60" y="180" w="90" h="30" /><inputs><input type="text" name="Tenant ID" friendlyname="Tenant ID" narrative="The unique ID of your Microsoft 365 tenant." expr="[TenantID]" /><input type="text" name="Client ID" friendlyname="Client ID" narrative="The OAuth client ID to use as for authentication." expr="[ClientID]" /><input type="password" name="Client Secret" friendlyname="Client Secret" narrative="Optional: The client secret associated with the client ID if performing Application Access authentication." expr="[ClientSecret]" /><input type="text" name="Username" friendlyname="Username" narrative="Optional: The username of an existing user account for Delegated Access authentication." expr="[Graph Mail ID]" /><input type="password" name="Password" friendlyname="Password" narrative="Optional: The password associated with the specified Username for Delegated Access authentication." expr="" /><input type="text" name="Certificate Path" friendlyname="Certificate Path" narrative="Optional: The path to a local X.509 certificate file, with private key, that will be used for Application Access authentication." expr="" /><input type="password" name="Certificate Password" friendlyname="Certificate Password" narrative="Optional: The password for the specified X.509 certificate." expr="" /></inputs><outputs><output type="flag" name="Success" friendlyname="Success" narrative="Flag indicating success or failure of the action." stage="Success" /><output type="text" name="Response Message" friendlyname="Response Message" narrative="If an error was encountered, this may contain additional information about the error." stage="" /></outputs><onsuccess>bdb52b14-1681-4afa-80b4-e3c46868557b</onsuccess><resource object="[R] Microsoft 365 - Outlook - Extended" action="Authenticate" /></stage><stage stageid="41353986-0331-4ead-bf14-e90d83006aed" name="ClientID" type="Data"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="-210" y="105" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="27520c5d-82d9-49b8-b887-44df1093d9a1" name="ClientSecret" type="Data"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="-150" y="105" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="b10f6955-51de-4a77-a633-31ef82b2765d" name="TenantID" type="Data"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="-90" y="105" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="d90168be-f8c5-4699-96b2-626442a2d46a" name="Graph Mail ID" type="Data"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="-270" y="105" /><datatype>text</datatype><initialvalue xml:space="preserve">blueprism.digitalworkforce2@bt.com</initialvalue><alwaysinit /></stage><stage stageid="01dcaed8-772e-4e29-8ebd-129f114dfda3" name="Success" type="Data"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="-180" y="150" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="059333ad-8ea2-4f25-a167-6b1e75fe1bd1" name="authResponse" type="Data"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="-240" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f89cdbfe-3421-4c24-80f3-4caab22eab68" name="Block3" type="Block"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><loginhibit onsuccess="true" /><display x="-315" y="75" w="270" h="105" /><font family="Segoe UI" size="10" style="Regular" color="008000" /></stage><stage stageid="bdb52b14-1681-4afa-80b4-e3c46868557b" name="Authenticate" type="Decision"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="60" y="240" /><decision expression="[Success]" /><ontrue>a73c7289-67f1-4421-a50e-a73a90333d6d</ontrue><onfalse>7610778a-73da-46e4-a8a4-a1771c7696f6</onfalse></stage><stage stageid="7610778a-73da-46e4-a8a4-a1771c7696f6" name="SE" type="Exception"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="180" y="240" /><exception localized="yes" type="System Exception" detail="&quot;Unable to Aunthenticate the MailBox.&quot;" /></stage><stage stageid="a73c7289-67f1-4421-a50e-a73a90333d6d" name="[R] Microsoft 365 - Outlook - Extended::Send Mail" type="Action"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><loginhibit onsuccess="true" /><display x="60" y="300" w="90" h="30" /><inputs><input type="text" name="Mailbox ID" friendlyname="Mailbox ID" narrative="The email address of the mailbox where the target email resides. Example: jdoe@mail.com" expr="[Graph Mail ID]" /><input type="text" name="To" friendlyname="To" narrative="A semicolon delimited list of email addresses to which the email will be addressed." expr="[Mail To]" /><input type="text" name="Message" friendlyname="Message" narrative="The body of the email as HTML or plain text." expr="[Output Data Item]" /><input type="flag" name="Is HTML" friendlyname="Is HTML" narrative="Optional. A flag indicating that the message content is HTML. Default value is False." expr="True" /><input type="text" name="CC" friendlyname="CC" narrative="Optional. A semicolon delimited list of email addresses to include in the CC field of the email." expr="&quot;nandhini.2.balaguru@bt.com&quot;" /><input type="text" name="BCC" friendlyname="BCC" narrative="Optional. A semicolon delimited list of email addresses to include in the BCC field of the email." expr="" /><input type="text" name="From" friendlyname="From" narrative="Optional: The owner of the mailbox from which the message is sent. In most cases, this value is the same as the sender property, except for sharing or delegation scenarios. For further details, see https://learn.microsoft.com/en-us/graph/outlook-create-send-messages#setting-the-from-and-sender-properties." expr="&quot;ROBOT&quot;" /><input type="text" name="Subject" friendlyname="Subject" narrative="Optional. A brief description of the content of the email." expr="&quot;Test Mail&quot;" /><input type="text" name="Importance" friendlyname="Importance" narrative="Optional. The importance of the message. The possible values are: 'low', 'normal', and 'high'. Default value is 'normal'." expr="" /><input type="text" name="Attachments" friendlyname="Attachments" narrative="Optional. A semicolon delimited list of local files to attach to the email." expr="" /><input type="flag" name="Save To Sent Items" friendlyname="Save To Sent Items" narrative="Optional. A flag indicating whether the email should be saved to the 'From' addresses 'Sent Items' folder. Default value is True." expr="" /></inputs><outputs><output type="flag" name="Success" friendlyname="Success" narrative="A flag indicating the success or failure of the action." stage="Success" /><output type="text" name="Response Message" friendlyname="Response Message" narrative="If an error is encountered, further details may be available here." stage="Response Message" /></outputs><onsuccess>9feed26d-50a4-482f-96d7-5422eb4879a9</onsuccess><resource object="[R] Microsoft 365 - Outlook - Extended" action="Send Mail" /></stage><stage stageid="6d851085-4fc3-4dd6-9313-c6a7b515f66f" name="Response Message" type="Data"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><display x="-120" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="48db3b5d-8342-4c5f-b89f-249d24a93100" name="Block4" type="Block"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><loginhibit /><display x="-315" y="195" w="270" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6c032a0e-04dd-4735-b730-aac1c27dbdd1" name="Mail To" type="Data"><subsheetid>cf9e4115-0075-41f0-b8d9-1861d1056630</subsheetid><loginhibit /><display x="-270" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a1b94afc-5250-4fc9-ba3b-0b950883d6f2" name="HTML Code for BT Branding" type="Data"><subsheetid>01b807c7-a636-44bb-b367-2552cc5c5b0f</subsheetid><loginhibit /><display x="-150" y="105" /><datatype>text</datatype><initialvalue xml:space="preserve">&lt;!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"&gt;&lt;html xmlns="http://www.w3.org/1999/xhtml"&gt;&lt;head&gt;
&lt;meta http-equiv="Content-Type" content="text/html; charset=Windows-1252"&gt;&lt;title&gt;Revalidate access to HR systems&lt;/title&gt;
&lt;meta http-equiv="X-UA-Compatible" content="IE=edge"&gt;
&lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
&lt;style type="text/css"&gt;
    #outlook a {padding:0;}
	#imageHide {display: none;}
    body {font-family: 'BT Curve','Century Gothic','Calibri', Arial, sans-serif;line-height: 1.3em;width:100% !important;margin:0;padding:0;min-width: 100% !important;}
	table {border-collapse: collapse;}
	.content {width: 100%; max-width: 600px;}
    a:link, a:visited {color:#000000;text-decoration:underline;}
	a span {text-decoration:none !important;}
	h1 {font-family: 'BT Group Headline', 'BTGroup Headline','BT Curve Headline','Century Gothic', Arial, sans-serif;font-size: 25pt;font-weight: 300 !important;line-height: 1em;color: #000 !important;margin: 15px 0 10px 0;}
	h2 {font-family: 'BT Group Headline', 'BTGroup Headline','BT Curve Headline','Century Gothic', Arial, sans-serif;font-size: 20pt;font-weight: 300 !important;line-height: 1.1em;color: #000 !important;margin: 15px 0 10px 0;}
	h3 {font-family: 'BT Group Headline', 'BTGroup Headline','BT Curve Headline','Century Gothic', Arial, sans-serif;font-size: 16pt;font-weight: 300 !important;line-height: 1.25em;color: #000 !important;margin: 15px 0 10px 0;}
	h4 {font-family: 'BT Group Headline', 'BTGroup Headline','BT Curve Headline','Century Gothic', 'Calibri', Arial, sans-serif;font-size: 12pt;font-weight: normal;line-height: 1.3em;color: #000 !important;margin: 15px 0 10px 0;}
	h5 {font-family: 'BT Curve Headline','Century Gothic', 'Calibri', Arial, sans-serif;font-size: 12pt;font-weight: normal;line-height: 1.3em;color: #000 !important;margin: 15px 0 10px 0;}
	p {	font-size: 11pt;line-height: 1.3em;color: #333333; margin: 0 0 13px 0;}
	td.summary p {margin: 0;}
	td.summary h4, td.story h4 {margin: 0 0 5px;}
	p.smalltext {font-size: 10pt;line-height: 1.05em;font-family: 'BT Curve','Century Gothic', 'Calibri', Arial, sans-serif;color: #000000;margin: 0;}
	h1.reverse, h2.reverse, h3.reverse, h4.reverse, p.reverse, ul.reverse, td.reverse {color: #ffffff !important;}
	th {
		background-color:#000; 
		color:#fff;
		padding:8px 0;
		font-size: 15pt;
		border-right:1px solid white;		
	}
	th:last-of-type { border-right:none;}
	/* table colors */
	td.darkGrey {background-color: #9d9d9c;}
	td.midGrey {background-color: #BEBEBE;}
	td.lightGrey {background-color: #DDDDDD;}
	td.darkGrey, td.midGrey, td.lightGrey {padding: 8px 8px !important;}
	td {font-size: 16px;color: #333333;	line-height: 1.3em;}	

 
		
	ol, ul {font-size: 11pt;line-height: 1.3em;color: #333333;margin: 0 0 13px 30px;padding: 0.1em;}
	ul &gt; li &gt; p, ol &gt; li &gt; p { margin-left: -20px; }
    @media only screen and (max-width: 600px), screen and (max-device-width: 600px) {
		@-ms-viewport{ width: device-width; } 
		img {width:100%;height:auto !important;display: block;-ms-interpolation-mode: bicubic;}
    }
    @media only screen and (min-width: 601px) {
        .content {width: 660px !important;}
    }
&lt;/style&gt; 
&lt;/head&gt;
