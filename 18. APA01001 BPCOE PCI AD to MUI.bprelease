yname="Response Body" narrative="The contents of the HTTP response body." stage="Response Body" /><output type="text" name="Upload Session Url" friendlyname="Upload Session Url" narrative="The unique URL for the upload session." stage="Upload Session Url" /><output type="datetime" name="Expiration" friendlyname="Expiration" narrative="The date and time that the upload session expires." stage="Expiration" /></outputs><onsuccess>36399867-a269-430b-bc89-d1e3ce2403ca</onsuccess><resource object="[R] Microsoft Graph API - Sharepoint Upload Session" action="Create Upload Session" /></stage><stage stageid="36399867-a269-430b-bc89-d1e3ce2403ca" name="Upload File" type="Action"><subsheetid>d4db6d64-43e6-43e8-aa17-d479aee74f9c</subsheetid><loginhibit onsuccess="true" /><display x="255" y="180" w="90" h="30" /><inputs><input type="text" name="Session Url" friendlyname="Session Url" narrative="The unique Url returned from a previous call to 'Create Upload Session'." expr="[Upload Session Url]" /><input type="text" name="File Name" friendlyname="File Name" narrative="The fully qualifed path and name of the file to upload." expr="[Source File Path]&amp;&quot;\&quot;&amp;[Source File Name]" /><input type="number" name="File Chunk Multiplier" friendlyname="File Chunk Multiplier" narrative="Optional: This is a number multiplied by the base chunk size to create larger file chunks. The minimum chunk size, per Microsoft, is 320KB. Therefore, the minimum multiplier is 1. If you have very large files you may want to increase the multiplier (ex. set it to 2) in order to increase the chunk size. This will have the effect of causing the process to submit fewer but larger chunks as opposed to more small chunks." expr="" /></inputs><outputs><output type="flag" name="Success" friendlyname="Success" narrative="A flag indicating the success or failure of the action." stage="Success" /><output type="text" name="Response Body" friendlyname="Response Body" narrative="The content of the HTTP respons