lueenc><private /><alwaysinit /></stage><stage stageid="3427bbdf-bae6-4547-a4f5-b0e04d154762" name="Unfinal Workbook" type="Code"><subsheetid>bc173c75-db3f-42b7-9535-ac8886c026fe</subsheetid><loginhibit /><display x="15" y="-45" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="password" name="Password" expr="[Password]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>e0628783-a54b-426e-bdb5-7f2dc6fecfa3</onsuccess><code><![CDATA[Dim wb As Object

