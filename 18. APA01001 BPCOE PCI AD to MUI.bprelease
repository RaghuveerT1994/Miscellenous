&lt;/span&gt;&lt;span style="font-size:11.0pt;font-family:&amp;quot;Calibri&amp;quot;,sans-serif;color:#1F497D"&gt;&lt;a href="http://www.bt.com/"&gt;&lt;b&gt;&lt;span lang="EN-US" style="font-size:9.0pt;font-family:&amp;quot;Tahoma&amp;quot;,sans-serif"&gt;www.bt.com&lt;/span&gt;&lt;/b&gt;&lt;/a&gt;&lt;/span&gt;&lt;span lang="EN-US" style="font-size:9.0pt;font-family:&amp;quot;Tahoma&amp;quot;,sans-serif;color:#1F497D"&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;
