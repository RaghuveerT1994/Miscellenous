 stageid="518e43c0-0aea-4100-88ab-908fb8ea954b" name="Check All Inputs Filled?" type="Decision"><subsheetid>01b807c7-a636-44bb-b367-2552cc5c5b0f</subsheetid><loginhibit /><display x="15" y="-60" /><decision expression="[Subject Line] =&quot;&quot;&#xA;OR&#xA;[Mail To]= &quot;&quot;&#xA;OR&#xA;[Body Content] = &quot;&quot;&#xA;OR&#xA;[Mail From] = &quot;&quot;" /><ontrue>76247b15-ff08-46d3-9cbe-8f782b957493</ontrue><onfalse>30697b50-7a7c-49d2-af72-2978401da65f</onfalse></stage><stage stageid="76247b15-ff08-46d3-9cbe-8f782b957493" name="SE" type="Exception"><subsheetid>01b807c7-a636-44bb-b367-2552cc5c5b0f</subsheetid><display x="120" y="-60" /><exception localized="yes" type="System Exception" detail="&quot;One or more input parameters blank.&quot;" /></stage><stage stageid="30697b50-7a7c-49d2-af72-2978401da65f" name="Replace Subject Line" type="Calculation"><subsheetid>01b807c7-a636-44bb-b367-2552cc5c5b0f</subsheetid><loginhibit /><display x="15" y="-15" /><onsuccess>580d61e4-618c-4583-8c9a-8884f36fca87</onsuccess><calculation expression="Replace([HTML Code for BT Branding], &quot;Subject Name&quot;, [Subject Line])" stage="Output Data Item Main" /></stage><stage stageid="46f747ea-b18f-4a22-97c0-2d77dc0174c4" name="HTML Code for BT Branding Old" type="Data"><subsheetid>01b807c7-a636-44bb-b367-2552cc5c5b0f</subsheetid><loginhibit /><narrative>HTML Code for BT Branding</narrative><display x="-210" y="15" w="210" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">&lt;!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"&gt;&lt;html xmlns="http://www.w3.org/1999/xhtml"&gt;&lt;head&gt;
&lt;meta http-equiv="Content-Type" content="text/html; charset=Windows-1252"&gt;&lt;title&gt;Revalidate access to HR systems&lt;/title&gt;
&lt;meta http-equiv="X-UA-Compatible" content="IE=edge"&gt;
&lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
&lt;style type="text/css"&gt;
    #outlook a {padding:0;}
	#imageHide {display: none;}
    body {font-family: 'BT Curve','Century Gothic','Calibri', Arial, sans-serif;line-height: 1.3em;width:100% !important;margin:0;padding:0;min-width: 100% !important;}
	table {border-collapse: collapse;}
	.content {width: 100%; max-width: 600px;}
    a:link, a:visited {color:#000000;text-decoration:underline;}
	a span {text-decoration:none !important;}
	h1 {font-family: 'BT Group Headline', 'BTGroup Headline','BT Curve Headline','Century Gothic', Arial, sans-serif;font-size: 25pt;font-weight: 300 !important;line-height: 1em;color: #000 !important;margin: 15px 0 10px 0;}
	h2 {font-family: 'BT Group Headline', 'BTGroup Headline','BT Curve Headline','Century Gothic', Arial, sans-serif;font-size: 20pt;font-weight: 300 !important;line-height: 1.1em;color: #000 !important;margin: 15px 0 10px 0;}
	h3 {font-family: 'BT Group Headline', 'BTGroup Headline','BT Curve Headline','Century Gothic', Arial, sans-serif;font-size: 16pt;font-weight: 300 !important;line-height: 1.25em;color: #000 !important;margin: 15px 0 10px 0;}
	h4 {font-family: 'BT Group Headline', 'BTGroup Headline','BT Curve Headline','Century Gothic', 'Calibri', Arial, sans-serif;font-size: 12pt;font-weight: normal;line-height: 1.3em;color: #000 !important;margin: 15px 0 10px 0;}
	h5 {font-family: 'BT Curve Headline','Century Gothic', 'Calibri', Arial, sans-serif;font-size: 12pt;font-weight: normal;line-height: 1.3em;color: #000 !important;margin: 15px 0 10px 0;}
	p {	font-size: 11pt;line-height: 1.3em;color: #333333; margin: 0 0 13px 0;}
	td.summary p {margin: 0;}
	td.summary h4, td.story h4 {margin: 0 0 5px;}
	p.smalltext {font-size: 10pt;line-height: 1.05em;font-family: 'BT Curve','Century Gothic', 'Calibri', Arial, sans-serif;color: #000000;margin: 0;}
	h1.reverse, h2.reverse, h3.reverse, h4.reverse, p.reverse, ul.reverse, td.reverse {color: #ffffff !important;}
	th {
		background-color:#000; 
		color:#fff;
		padding:8px 0;
		font-size: 15pt;
		border-right:1px solid white;		
	}
	th:last-of-type { border-right:none;}
	/* table colors */
	td.darkGrey {background-color: #9d9d9c;}
	td.midGrey {background-color: #BEBEBE;}
	td.lightGrey {background-color: #DDDDDD;}
	td.darkGrey, td.midGrey, td.lightGrey {padding: 8px 8px !important;}
	td {font-size: 16px;color: #333333;	line-height: 1.3em;}	

 
		
	ol, ul {font-size: 11pt;line-height: 1.3em;color: #333333;margin: 0 0 13px 30px;padding: 0.1em;}
	ul &gt; li &gt; p, ol &gt; li &gt; p { margin-left: -20px; }
    @media only screen and (max-width: 600px), screen and (max-device-width: 600px) {
		@-ms-viewport{ width: device-width; } 
		img {width:100%;height:auto !important;display: block;-ms-interpolation-mode: bicubic;}
    }
    @media only screen and (min-width: 601px) {
        .content {width: 660px !important;}
    }
&lt;/style&gt; 
&lt;/head&gt;
